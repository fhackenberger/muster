# service-env.example — settings for the PROJECT's services (backend, frontend, …), given to BOTH
# the hub and every agent box. Either can run those services, so they must be configured identically.
#
#     cp service-env.example service-env      # REQUIRED: compose refuses to start the hub without it
#
# It is an EXAMPLE, like mounts.example / port-forwards.example: the real file holds credentials and
# API keys, so it is never committed (see .gitignore). Under Ansible it is templated from
# templates/docker-compose/claude-box/service-env, which pulls the secrets from the vault.
# The values below are a worked example — one Gradle backend + Angular frontend + postgres stack.
#
#   hub    <- compose `env_file:` on the hub service
#   boxes  <- the box-broker reads this file and passes each entry as `-e KEY=VALUE`
#
# Format is compose's env_file format, and the broker parses the same way:
#   * one KEY=VALUE per line; the value is LITERAL to the end of the line
#   * '#' comments and blank lines ignored
#   * no quoting rules, no shell/${} expansion, and values may not contain newlines
#   * keys must match [A-Za-z_][A-Za-z0-9_]*  (a bad key is a hard error, not a silent skip)
#
# Changes apply to the hub on `docker compose up -d hub`, and to a box on `cbx recreate <box>`.
#
# NOTE hostnames here (db, redis, activemq, hub) are docker-network names — they resolve the same
# from the hub and from every box, since all of them are on the cbx-<project> network.
#

# ---- service ports ----
# SERVER_PORT is Spring Boot's server.port; FRONTEND_DEV_PORT is read by the project's frontend-dev
# scripts for `ng serve --port` (they must NOT hardcode a port, or a reshuffle breaks the dev loop
# silently: the tunnel forwards one port while ng serve binds another).
SERVER_PORT=8091
FRONTEND_DEV_PORT=4211
# The FULL app URL, not just host:port — the frontend derives its REST base by stripping
# /app[-suffix]/* off this value, so a bare host:port loses the /myappWeb segment and every REST
# call 404s. Default setup: the backend runs on the HUB, and the BROWSER (pinchtab's Chrome there, or
# your laptop via cbxtun/cbxfe) resolves localhost to that same hub.
#
# RIGHT FOR THE HUB AND FOR A BROWSER, WRONG INSIDE A BOX, where localhost is the box: an agent that
# curls it gets 000 and concludes the backend is down. Override it for boxes in `box-env`, which is
# expanded per box and applied after this file:
#     FRONTEND_DEV_BACKEND_URL=http://$MUSTER_HUB_HOST:$SERVER_PORT$FRONTEND_DEV_BACKEND_PATH
FRONTEND_DEV_BACKEND_URL=http://localhost:8091/myappWeb/app
# Split out so box-env can rebuild the URL around a different host or port without repeating the path
# (and so an agent's own backend can reuse it) — see box-env.example.
FRONTEND_DEV_BACKEND_PATH=/myappWeb/app

#
# NEVER use $VAR or ${VAR} in this file. Compose INTERPOLATES them when it loads env_file — against
# the HOST's environment, as root — so "$HOME" reaches the hub as /root, while the broker reads this
# file raw and a box gets the literal text. Same file, two different values, and the hub's is wrong.
# (Command substitution $(…) is not interpolated, but service COMMANDS no longer live here — see next.)
#
# ---- service commands moved to hub-services/ ----
# What `cbx up <service>` runs is now a MANIFEST per service in the stack's hub-services/ directory
# (bind-mounted into the hub), NOT a *_CMD variable here. Manifests are read only by cbx, so a command
# may freely use $REPO / $VAR / $(…) — evaluated at LAUNCH, inside the container — which is where the
# backend's aspectj `-javaagent:$(find …)` path now lives. This file keeps only the SETTINGS a service
# reads (ports, DB, keys); those are shared with the agent boxes by the broker, which commands are not.

# ---- backend wiring (config.properties keys; env overrides the baked-in defaults) ----
DB_MYAPP_PSQL_URL=jdbc:postgresql://db:5432/myapp_dev
DB_MYAPP_PSQL_USER=myapp_u
DB_MYAPP_PSQL_PASSWORD=test
DB_LIQUIBASE_UPGRADE_DISABLED=true
LIVE_JMSURI=tcp://activemq:61616
ACTIVEMQ_ENABLE=true
REDIS_HOST=redis
REDIS_PORT=6379

# ---- properties whose names can't be environment variables ----
# A property named with '/' (or any character outside [A-Za-z0-9_]) has no env-var spelling: Spring
# only translates '.' and '-' to '_' when matching a property name against the environment. Use
# SPRING_APPLICATION_JSON — a high-precedence property source whose keys are taken literally. Put ALL
# such properties in this ONE variable; a second SPRING_APPLICATION_JSON line would replace the first.
#SPRING_APPLICATION_JSON={"AnonymousLogin/enabled":"true","AnonymousLogin/isDefault":"true","AnonymousLogin/userId":"1","AnonymousLogin/password":"secret"}

# ---- API keys (fill in, or let Ansible template them from the vault) ----
FRONTEND_GOOGLE_MAPS_API_KEY=
GEOSERVICEGOOGLE_APIKEY=
GEOSERVICELOCATIONIQ_APIKEY=
