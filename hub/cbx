#!/bin/bash
set -euo pipefail

# cbx — hub-side control CLI. Three jobs:
#   * start/stop the on-demand dev services in the hub's tmux (backend / frontend / pinchtab)
#   * spawn/kill/list agent boxes via the box-broker (the hub itself never touches the docker socket)
#   * THE REVIEW QUEUE: each agent works on its own branch (agent/<box>) in an overlay of a shared
#     prepared "golden" checkout and pushes to refs/agents/<box> here; you review and merge into dev.
#
# Usage:
#   cbx up   backend|frontend|pinchtab      # start a service in its tmux window
#   cbx down backend|frontend|pinchtab      # stop it
#   cbx logs backend|frontend|pinchtab|gitd # attach that service window (Ctrl-b d to detach)
#   cbx box  [name]                         # spawn an agent box (own branch, overlay checkout)
#   cbx kill <name>                         # remove an agent box (its upper layer is kept)
#   cbx recreate <name>|all [--fresh]       # pull newest image + respawn (--fresh = discard upper)
#   cbx ls                                  # list services (tmux) + boxes (broker)
#
#   cbx q                                   # the review queue: who is waiting on you
#   cbx review <box> [--full]               # diff since your last review (--full = whole branch)
#   cbx fix    <box> -m "..."               # send review feedback into that box's claude session
#   cbx prereview <box>                     # ask the agent to self-review its diff before you look
#   cbx merge  <box> [--squash]             # merge the agent branch into dev
#   cbx drop   <box>                        # discard an agent branch (tells the box)
#   cbx rebase <box>|all                    # move agents onto the current dev (light; no recreate)
#   cbx push                                # push dev to the real origin
#
#   cbx golden snapshot [--prep]            # freeze the repo as the new base + move every box onto it
#   cbx golden seal <id>                    # finish a staged golden you fixed up by hand
#   cbx golden ls | reap                    # list snapshots / delete unreferenced ones
#   cbx expose <src> [dst] [ro]             # add an EXTRA path to box-mounts (dst defaults to src)
#   cbx hide   <src>                        # remove it
#
# The repo lives at the SAME absolute path here and inside every box (/home/dev/repo), because
# installed dependencies bake absolute paths in — npm into node_modules/.bin shebangs, gradle into
# the project-local .gradle cache. So whatever you set up here works unchanged in an agent's box.

REPO="${CHECKOUT:-/home/dev/repo}"
DEV="${DEV_BRANCH:-dev}"
GOLDEN="${GOLDEN_DIR:-/work/golden}"
STAGING="${GOLDEN_STAGING:-/work/golden-staging}"
STATE="$REPO/.git/cbx"
MANIFEST="${BOX_MOUNTS:-/work/box-mounts}"
TMUX_SESSION="${TMUX_SESSION:-services}"
BROKER_URL="${BROKER_URL:-http://box-broker:8099}"
BROKER_TOKEN="${BROKER_TOKEN:-}"

# Your project's "make this tree ready to build" command. `cbx golden snapshot --prep` runs it IN THE
# REPO (not in a copy), so it's an optional convenience around the setup you'd otherwise do by hand —
# and whatever it installs is captured at the path it will actually be used from.
GOLDEN_PREP_CMD="${GOLDEN_PREP_CMD:-npm --prefix infostarsFrontend ci}"

# Service commands (override in the stack .env). Wrapped so the tmux window survives the process
# exiting, and so backgrounding dev scripts still leave a live window to read logs from.
BACKEND_CMD="${BACKEND_CMD:-gradle --project-dir '$REPO/infostars/' -x test -x buildFrontend :infostarsTapestryWeb:bootRun --args='--spring.profiles.active=default'}"
FRONTEND_CMD="${FRONTEND_CMD:-'$REPO/infostarsFrontend/scripts/frontend-dev-restart.sh' && tail -f /tmp/infostarsFrontend-dev.log}"
PINCHTAB_CMD="${PINCHTAB_CMD:-pinchtab server}"

die() { echo "cbx: $*" >&2; exit 1; }
git_() { git -C "$REPO" "$@"; }
have_delta() { command -v delta >/dev/null 2>&1; }

# ------------------------------------------------------------------ services

svc_cmd() {
	case "$1" in
		backend)  printf '%s' "$BACKEND_CMD" ;;
		frontend) printf '%s' "$FRONTEND_CMD" ;;
		pinchtab) printf '%s' "$PINCHTAB_CMD" ;;
		*) die "unknown service '$1' (backend|frontend|pinchtab)" ;;
	esac
}

svc_up() {
	local svc="$1" cmd; cmd="$(svc_cmd "$svc")"
	if tmux list-windows -t "$TMUX_SESSION" -F '#W' 2>/dev/null | grep -qx "$svc"; then
		echo "cbx: $svc already running (cbx logs $svc to view)"; return 0
	fi
	# keep the window alive after the command exits so failures stay readable
	tmux new-window -t "$TMUX_SESSION" -n "$svc" -c "$REPO" \
		"bash -lc $(printf '%q' "$cmd; echo; echo '[cbx] $svc exited — press enter to close'; read _")"
	echo "cbx: started $svc (cbx logs $svc to view)"
}

svc_down() {
	local svc="$1"
	tmux kill-window -t "${TMUX_SESSION}:${svc}" 2>/dev/null && echo "cbx: stopped $svc" \
		|| echo "cbx: $svc not running"
}

svc_logs() {
	exec tmux attach -t "${TMUX_SESSION}" \; select-window -t "${TMUX_SESSION}:$1"
}

# ------------------------------------------------------------------ broker

broker() {
	local method="$1" path="$2"; shift 2
	# --fail-with-body (curl >= 7.76): like -f it still returns non-zero on HTTP >= 400 so callers'
	# `&&` chains detect failure, but UNLIKE -f it prints the response body, so the broker's
	# {"error": "..."} is shown instead of a bare "curl: (22) ... error: 500".
	curl --fail-with-body -sS -X "$method" -H "X-Broker-Token: $BROKER_TOKEN" "$@" "${BROKER_URL}${path}"
}

jqr() { jq -r "$1" 2>/dev/null || true; }

box_new() {
	local name="${1:-$(cut -c1-6 /proc/sys/kernel/random/uuid 2>/dev/null || echo $$)}"
	local resp container
	resp="$(broker POST "/box/$name")" || die "spawning box '$name' failed: $resp"
	container="$(printf '%s' "$resp" | jqr '.container // empty')"
	[ -n "$container" ] || container="$(printf '%s' "$resp" | sed -n 's/.*"container"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p')"
	echo "cbx: box '$name' up as '$container' on branch agent/$name (golden $(printf '%s' "$resp" | jqr '.golden // empty'))."
	echo "  docker exec -it -u dev $container tmux attach -t main      # Ctrl-b d to detach"
}

box_kill() {
	[ $# -ge 1 ] || die "kill needs a box name"
	local resp
	resp="$(broker DELETE "/box/$1")" || die "killing box '$1' failed: $resp"
	echo "cbx: killed box '$1' (its upper layer is kept — 'cbx box $1' reattaches to it)"
}

box_recreate() {
	[ $# -ge 1 ] || die "recreate needs a box name (or 'all')"
	local target="$1" q="" resp
	shift
	[ "${1:-}" = --fresh ] && q="?fresh=1"
	if [ "$target" = all ]; then
		echo "cbx: pulling newest image + recreating all boxes (each resumes its own session)..."
		resp="$(broker POST "/recreate${q}")" || die "recreate all failed: $resp"
		echo "cbx: recreated: $(printf '%s' "$resp" | jqr '.recreated | join(", ")')"
	else
		resp="$(broker POST "/recreate/${target}${q}")" || die "recreate '$target' failed: $resp"
		echo "cbx: box '$target' recreated as '$(printf '%s' "$resp" | jqr '.container // empty')'."
	fi
}

box_ls() {
	echo "== services (tmux) =="
	tmux list-windows -t "$TMUX_SESSION" -F '  #W' 2>/dev/null || echo "  (none)"
	echo "== boxes (broker) =="
	local resp
	if resp="$(broker GET "/box" 2>/dev/null)"; then
		printf '%s' "$resp" | jq -r '.boxes[]? | "  \(.container)\t\(.status)\tgolden=\(.golden)"' 2>/dev/null \
			|| printf '  %s\n' "$resp"
	else
		echo "  (broker unreachable)"
	fi
}

say_to_box() {
	# Deliver a line into the box's claude session. Note this is a PROMPT, not a shell command: the
	# window runs claude, so phrase instructions the way you'd type them to the agent.
	local box="$1" msg="$2" resp
	resp="$(broker POST "/box/$box/say" --data-raw "$msg")" || die "could not reach box '$box': $resp"
}

# ------------------------------------------------------------------ review queue

agent_refs() { git_ for-each-ref --format='%(refname:strip=2)' refs/agents/; }

note_of() { git_ notes --ref=cbx show "refs/agents/$1" 2>/dev/null | head -1; }

# Conflicted paths between two committishes, without touching the worktree or the index.
# --no-messages drops git's "Auto-merging / CONFLICT (content)" prose, leaving the tree oid on line 1
# and one conflicted path per line after it; a clean merge exits 0 and we report nothing.
conflicts_between() {
	local out
	if out="$(git_ merge-tree --write-tree --name-only --no-messages "$1" "$2" 2>/dev/null)"; then
		return 0                     # clean merge, nothing to report
	fi
	printf '%s' "$out" | tail -n +2 | tr '\n' ' '
}

review_state() { cat "$STATE/$1.reviewed" 2>/dev/null || true; }

queue() {
	local any=0 box sha ahead age note prev status conf other
	printf '%-12s %6s %-14s %-11s %s\n' BOX AHEAD LAST STATUS SUMMARY
	for box in $(agent_refs); do
		any=1
		sha="$(git_ rev-parse "refs/agents/$box")"
		ahead="$(git_ rev-list --count "$DEV..refs/agents/$box" 2>/dev/null || echo '?')"
		age="$(git_ log -1 --format=%cr "refs/agents/$box")"
		note="$(note_of "$box")"
		prev="$(review_state "$box")"
		if [ -z "$prev" ]; then status=new
		elif [ "$prev" = "$sha" ]; then status=reviewed
		else status=re-review; fi
		printf '%-12s %6s %-14s %-11s %s\n' "$box" "$ahead" "$age" "$status" "${note:-—}"
		# Conflicts are the shared-checkout collision awareness, moved earlier: you learn that two
		# agents touched the same lines when they push, not when you merge the second one.
		conf="$(conflicts_between "$DEV" "refs/agents/$box")"
		[ -n "$conf" ] && printf '  %-10s ⚠ conflicts with %s: %s\n' "" "$DEV" "$conf"
		for other in $(agent_refs); do
			[ "$other" = "$box" ] && continue
			[[ "$other" > "$box" ]] || continue          # report each pair once
			conf="$(conflicts_between "refs/agents/$box" "refs/agents/$other")"
			[ -n "$conf" ] && printf '  %-10s ⚠ conflicts with %s: %s\n' "" "$other" "$conf"
		done
	done
	[ "$any" = 1 ] || echo "  (nothing waiting — no refs/agents/* pushed yet)"
}

review() {
	[ $# -ge 1 ] || die "review needs a box name"
	local box="$1" full="${2:-}" ref sha prev
	ref="refs/agents/$box"
	git_ rev-parse --verify -q "$ref" >/dev/null || die "no branch pushed for '$box' (has it run handoff?)"
	sha="$(git_ rev-parse "$ref")"
	prev="$(review_state "$box")"
	mkdir -p "$STATE"

	echo "== $box: $(git_ rev-list --count "$DEV..$ref") commit(s) on top of $DEV =="
	git_ log --notes=cbx --oneline "$DEV..$ref" | sed 's/^/  /'
	echo

	if [ -n "$prev" ] && [ "$prev" != "$sha" ] && [ "$full" != --full ] \
	   && git_ rev-parse --verify -q "$prev^{commit}" >/dev/null; then
		# Re-review after a fix round: show ONLY what changed since you last looked. range-diff copes
		# with the amends and rebases a fix round produces, which a plain diff cannot.
		echo "-- changes since your last review ($(git_ rev-parse --short "$prev")); --full for the whole branch --"
		git_ range-diff "$DEV..$prev" "$DEV..$ref"
	else
		if have_delta; then git_ diff "$DEV...$ref" | delta; else git_ --paginate diff "$DEV...$ref"; fi
	fi

	printf '%s' "$sha" > "$STATE/$box.reviewed"
	echo
	echo "cbx: reviewed up to $(git_ rev-parse --short "$sha"). Next: cbx fix $box -m '...' | cbx merge $box | cbx drop $box"
}

fix() {
	[ $# -ge 1 ] || die "fix needs a box name"
	local box="$1" msg=""; shift
	[ "${1:-}" = -m ] && { shift; msg="$*"; } || msg="$*"
	[ -n "$msg" ] || die "fix needs a message: cbx fix $box -m 'what to change'"
	say_to_box "$box" "Review feedback on your handoff: ${msg}. Please fix it on your branch, then run: handoff"
	echo "cbx: sent to $box. It will push again when done ('cbx q' shows re-review)."
}

prereview() {
	[ $# -ge 1 ] || die "prereview needs a box name"
	# Cheap capacity multiplier: the agent re-reads its OWN diff critically before you spend a round on
	# it. This is self-review, not an independent reviewer — see README-remote.md for the difference.
	say_to_box "$1" "Before I review this: run 'mydiff' and read your own change critically against the project's conventions in CLAUDE.md — dead code, missing tests, unhandled errors, anything you would flag in someone else's PR. Fix what you find, then run: handoff"
	echo "cbx: asked $1 to self-review and re-hand off."
}

merge() {
	[ $# -ge 1 ] || die "merge needs a box name"
	local box="$1" squash="${2:-}" ref msg
	ref="refs/agents/$box"
	git_ rev-parse --verify -q "$ref" >/dev/null || die "no branch pushed for '$box'"
	# The hub tree is EXPECTED to carry local setup work (it's what goldens are snapshotted from), so a
	# dirty tree is not an error here. Just show it and let git decide: it refuses precisely when the
	# merge would overwrite a file you've modified, which is the only case that actually matters.
	if [ -n "$(git_ status --porcelain)" ]; then
		echo "cbx: note — local changes in $REPO (kept; the merge aborts only if it would overwrite one):" >&2
		git_ status --short | sed 's/^/  /' >&2
	fi
	msg="$(note_of "$box")"; msg="${msg:-work from agent box $box}"

	git_ checkout -q "$DEV"
	if [ "$squash" = --squash ]; then
		git_ merge --squash "$ref" || die "merge conflicts — resolve in $REPO, then commit"
		git_ commit -m "$msg" -m "Cbx-Box: $box" || die "nothing to commit"
	else
		git_ merge --no-ff "$ref" -m "$msg" -m "Cbx-Box: $box" \
			|| die "merge conflicts — resolve in $REPO, then 'git commit'"
	fi
	echo "cbx: merged $box into $DEV ($(git_ rev-parse --short HEAD))"
	git_ update-ref -d "$ref"
	rm -f "$STATE/$box.reviewed"
	# The agent is still sitting on the now-merged branch; move it onto the new dev so its next piece
	# of work starts from what you just landed.
	say_to_box "$box" "Your work was merged into ${DEV}. Please run: git fetch hub && git rebase hub/${DEV} — then continue with the next task." 2>/dev/null \
		|| echo "cbx: (box $box not running — it will rebase on next start)"
	echo "cbx: push it with 'cbx push' when you're ready."
}

drop() {
	[ $# -ge 1 ] || die "drop needs a box name"
	local box="$1"
	git_ update-ref -d "refs/agents/$box" 2>/dev/null || true
	rm -f "$STATE/$box.reviewed"
	say_to_box "$box" "I dropped your handoff — that approach is not going in. Do not re-push it; wait for new instructions." 2>/dev/null || true
	echo "cbx: dropped refs/agents/$box (the box still has the commits locally until it rebases)"
}

rebase() {
	[ $# -ge 1 ] || die "rebase needs a box name (or 'all')"
	local box list
	if [ "$1" = all ]; then
		list="$(broker GET /box 2>/dev/null | jqr '.boxes[]?.box')"
	else
		list="$1"
	fi
	for box in $list; do
		say_to_box "$box" "Please run: git fetch hub && git rebase hub/${DEV} — the ${DEV} branch has moved. Resolve any conflicts, then carry on." 2>/dev/null \
			&& echo "cbx: asked $box to rebase onto $DEV" \
			|| echo "cbx: box $box unreachable — skipped"
	done
}

push() {
	git_ push origin "$DEV" && echo "cbx: pushed $DEV to origin"
}

# ------------------------------------------------------------------ goldens

golden_ls() {
	local resp g prov
	resp="$(broker GET /golden)" || die "broker unreachable: $resp"
	echo "current: $(printf '%s' "$resp" | jqr '.current')"
	for g in $(printf '%s' "$resp" | jqr '.goldens[]?.golden'); do
		# Provenance is stored INSIDE .git (not as a file in the tree), so it never shows up as an
		# untracked file in every agent's `git status`.
		prov="$(cat "$GOLDEN/$g/.git/cbx-golden" 2>/dev/null | tr '\n' ' ')"
		printf '  %-22s %s\n' "$g" "${prov:-(no provenance recorded)}"
		printf '%s' "$resp" | jq -r --arg g "$g" '.goldens[]? | select(.golden==$g) | "      \(if .current then "current  " else "" end)boxes: \(if (.boxes|length)>0 then (.boxes|join(",")) else "-" end)"' 2>/dev/null
	done
}

golden_seal() {
	# Finish a golden you staged and then fixed up by hand (e.g. after a failed --prep). Same tail as
	# snapshot: seal, move every box onto it, drop the ones nothing references any more.
	[ $# -ge 1 ] || die "seal needs a staged golden id (see $STAGING)"
	[ -d "$STAGING/$1" ] || die "no staged golden at $STAGING/$1"
	broker POST "/golden/seal/$1" >/dev/null || die "sealing $1 failed"
	echo "cbx: sealed $1 as current"
	broker POST "/recreate?fresh=1" >/dev/null || die "recreate failed"
	golden_reap
}

golden_reap() {
	local resp
	resp="$(broker POST /golden/reap)" || die "reap failed: $resp"
	echo "cbx: reaped: $(printf '%s' "$resp" | jqr '.reaped | join(", ") // "(none)"')"
}

golden_snapshot() {
	# Freeze THIS repo — exactly as you have it set up — as the base every box overlays.
	#
	# The snapshot is taken from, and mounted back at, the SAME absolute path ($REPO is also the box's
	# checkout path). So anything with baked-in absolute paths — npm's node_modules/.bin shebangs and
	# .package-lock.json, a project-local .gradle cache, a python venv — keeps working inside the box.
	# That is also why nothing is built in the staging copy: a build there would record the staging
	# path and be wrong everywhere. Run `--prep` (or your own commands) HERE, then snapshot.
	#
	# We can't skip the copy and point the boxes' lowerdir straight at $REPO: overlayfs requires the
	# lower layer to be immutable while boxes are mounted on it, and you keep editing this tree.
	local id st prep=0 boxes box dirty svc
	[ "${1:-}" = --prep ] && prep=1

	# A build running in the hub's tmux writes into $REPO while we copy it — the snapshot would be a
	# torn mixture of before and after. Cheap to avoid, miserable to debug.
	for svc in backend frontend; do
		if tmux list-windows -t "$TMUX_SESSION" -F '#W' 2>/dev/null | grep -qx "$svc"; then
			die "'$svc' is running and writing into $REPO — 'cbx down $svc' first, then snapshot"
		fi
	done

	if [ "$prep" = 1 ]; then
		echo "cbx: preparing the repo (${GOLDEN_PREP_CMD})"
		( cd "$REPO" && bash -lc "$GOLDEN_PREP_CMD" ) || die "prep failed — fix it in $REPO and re-run"
	fi

	# Recreating the boxes discards their upper layers, so anything not committed AND pushed is lost.
	# Refuse rather than eat it — this is the one destructive step in the whole workflow.
	boxes="$(broker GET /box 2>/dev/null | jqr '.boxes[]?.box')"
	for box in $boxes; do
		dirty="$(broker GET "/box/$box/dirty" 2>/dev/null | jqr '.dirty[]?' | head -5)"
		if [ -n "$dirty" ]; then
			echo "cbx: box '$box' has uncommitted changes:" >&2
			printf '  %s\n' $dirty >&2
			die "commit + handoff in that box first (or 'cbx kill $box' to abandon it)"
		fi
	done

	# Whatever is dirty here gets baked in and becomes every agent's starting `git status`. That's the
	# deal — it's how your local setup reaches the boxes — but it should never be a surprise, and
	# modified TRACKED files are the ones an agent can sweep into a commit by accident.
	if [ -n "$(git_ status --porcelain)" ]; then
		echo "cbx: baking these local changes into the golden — every box will start with them:"
		git_ status --short | sed 's/^/  /'
	fi

	id="g-$(date +%Y%m%d-%H%M%S)"
	st="$STAGING/$id"
	mkdir -p "$STAGING"
	rm -rf "$st"
	echo "cbx: snapshotting $REPO -> staging/$id (reflink)"
	cp --reflink=auto -a "$REPO/." "$st" || die "snapshot copy failed"

	# The boxes reach the hub repo over the cbx network; bake that in so a box's git works immediately.
	git -C "$st" remote remove hub 2>/dev/null || true
	git -C "$st" remote add hub "${HUB_GIT_URL:-git://hub/repo}"
	# Hub-only bits that have no business in a box: the push-restriction hook (nothing pushes into a
	# box) and the review state. Provenance goes inside .git so it can never appear as an untracked
	# file in every agent's `git status`.
	rm -f  "$st/.git/hooks/update"
	rm -rf "$st/.git/cbx"
	printf '%s from %s (%s) at %s\n' "$id" "$(git_ rev-parse --short HEAD)" "$DEV" "$(date -Is)" \
		> "$st/.git/cbx-golden"

	# The hub mounts $GOLDEN read-only on purpose, so the broker performs the move + symlink flip.
	broker POST "/golden/seal/$id" >/dev/null \
		|| die "sealing $id failed (staged tree kept — retry with: cbx golden seal $id)"
	echo "cbx: sealed $id as current"

	echo "cbx: moving every box onto it (fresh upper layers)..."
	broker POST "/recreate?fresh=1" >/dev/null || die "recreate failed"
	golden_reap
	echo "cbx: done. Boxes are on $id and back on their pushed branches."
}

# ------------------------------------------------------------------ box-mounts extras

expose() {
	[ $# -ge 1 ] || die "expose needs a repo path"
	local src="$1" dst mode
	if [ "${2:-}" = ro ] || [ "${2:-}" = rw ]; then
		dst="$src"; mode="$2"          # cbx expose <src> <ro|rw>
	else
		dst="${2:-$src}"; mode="${3:-rw}"   # cbx expose <src> [dst] [ro|rw]
	fi
	printf '%s %s %s\n' "$src" "$dst" "$mode" >> "$MANIFEST"
	echo "cbx: exposed $src -> $dst ($mode). Apply with: cbx recreate <box>|all (keeps the session)."
}

hide() {
	[ $# -ge 1 ] || die "hide needs a repo path"
	grep -vE "^[[:space:]]*$1[[:space:]]" "$MANIFEST" > "$MANIFEST.tmp" && mv "$MANIFEST.tmp" "$MANIFEST"
	echo "cbx: hid $1. Apply with: cbx recreate <box>|all (keeps the session)."
}

cmd="${1:-}"; shift || true
case "$cmd" in
	up)     [ $# -ge 1 ] || die "up needs a service"; svc_up "$1" ;;
	down)   [ $# -ge 1 ] || die "down needs a service"; svc_down "$1" ;;
	logs)   [ $# -ge 1 ] || die "logs needs a service"; svc_logs "$1" ;;
	box)      box_new "$@" ;;
	kill)     box_kill "$@" ;;
	recreate) box_recreate "$@" ;;
	ls)       box_ls ;;
	q|queue)  queue ;;
	review)   review "$@" ;;
	fix)      fix "$@" ;;
	prereview) prereview "$@" ;;
	merge)    merge "$@" ;;
	drop)     drop "$@" ;;
	rebase)   rebase "$@" ;;
	push)     push ;;
	golden)
		sub="${1:-}"; shift || true
		case "$sub" in
			snapshot) golden_snapshot "$@" ;;
			seal)     golden_seal "$@" ;;
			ls)       golden_ls ;;
			reap)     golden_reap ;;
			*) die "golden needs: snapshot [--prep] | seal <id> | ls | reap" ;;
		esac ;;
	expose) expose "$@" ;;
	hide)   hide "$@" ;;
	*) sed -n '4,40p' "$0" | sed 's/^# \?//'; exit 1 ;;
esac
