#!/bin/bash
set -euo pipefail

# cbx — hub-side control CLI. Three jobs:
#   * start/stop the on-demand dev services in the hub's tmux (declared in hub-services/, e.g. backend)
#   * spawn/kill/list agent boxes via the box-broker (the hub itself never touches the docker socket)
#   * THE REVIEW QUEUE: each agent works on its own branch (agent/<box>) in an overlay of a shared
#     prepared "golden" checkout and pushes to refs/agents/<box> here; you review and merge into dev.
#
# Usage:
#   cbx svcs                                # list dev services (declared in hub-services/) + state
#   cbx up   <service>                      # start a service in its tmux window
#   cbx down <service>                      # stop it
#   cbx logs <service>|gitd                 # attach that service window (Ctrl-b d to detach)
#   cbx autostart                           # start every service whose manifest sets autostart=true
#   cbx box  [name]                         # spawn an agent box (own branch, overlay checkout)
#   cbx kill <name>                         # remove an agent box (its upper layer is kept)
#   cbx recreate <name>|all [--fresh]       # pull newest image + respawn (--fresh = discard upper)
#   cbx ls                                  # list services + boxes (broker)
#   cbx forwards [box]                      # re-establish the hub-loopback socat forwards
#
#   cbx status                              # what can be merged / rebased / pushed, with commands
#   cbx q  [-n SECS] [--no-bell]            # LIVE dashboard: queue + status in one repainted screen,
#                                           #   and your terminal BELLS when an agent stops working
#                                           #   or a new handoff lands. 'q'/Ctrl-C quits, Enter refreshes
#   cbx q  --text                           # the queue table once, as plain text (for pipes/scripts)
#                                           #   colour: CBX_COLOR=always|never|auto (auto = 'cbx status'
#                                           #   colours a terminal only; the live dashboard always does)
#   cbx review <box> [--full] [--net]       # open the review TUI (tuicr) on the agent's branch: leave
#                                           #   line comments, quit, CONFIRM, and they are sent to the
#                                           #   box — no retyping them into `cbx fix`. Nothing is sent
#                                           #   until you answer 's' at the prompt.
#              [--tui] [--plain]            #   --plain = the old delta/less pager (also used when no
#                                           #   TUI is installed, for --net, and for a RE-review, whose
#                                           #   range-diff a TUI cannot show); --tui forces the TUI.
#                                           #   --full = whole branch, --net = one combined diff.
#                                           #   CBX_REVIEW_TUI picks a different TUI (empty = never one)
#   cbx fix    <box> -m "..."               # send review feedback into that box's claude session
#   cbx prereview <box>                     # ask the agent to self-review its diff before you look
#   cbx merge  <box> [--squash] [--edit]    # merge the agent branch into dev
#                                           #   --squash = one commit, --edit = reword it yourself
#                                           #   (--edit on a 1-commit branch: no merge commit)
#   cbx drop   <box>                        # discard an agent branch (tells the box)
#   cbx rebase <box>|all [--force]          # move agents onto the current dev (light; no recreate)
#
#   cbx export <box>                        # the agent's work, SQUASHED, as one mbox patch on STDOUT
#                                           #   (laptop: `cbxexport <box>` pipes it into a local git am)
#   cbx import <box>                        # read a patch on STDIN, REPLACE the agent's branch with it,
#                                           #   and tell the box to note it — not act (laptop: cbximport)
#
# Commands that TYPE into an agent's session (fix / prereview / rebase) refuse while that agent is
# working — `cbx ls` and `cbx status` show busy | waiting | idle per box. Add --force to interrupt.
#   cbx pull [--rebase]                     # bring dev up to date with origin (merge by default)
#   cbx push [-y]                           # push dev to the real origin (shows a --stat preview and
#                                           #   asks first; -y skips the question)
#
#   cbx golden snapshot [--prep]            # freeze the repo as the new base + move every box onto it
#   cbx golden seal <id>                    # finish a staged golden you fixed up by hand
#   cbx golden ls | reap                    # list snapshots / delete unreferenced ones
#
# What the hub and the boxes MOUNT is project set-up, not a runtime knob: it lives in the stack's
# root-owned `mounts` table (one row per path, a mode for each side), edited on the host and applied
# with `./gen-hub-mounts.sh && docker compose up -d hub && cbx recreate all`. See mounts.example.
#
# The repo lives at the SAME absolute path here and inside every box (/home/dev/repo), because
# installed dependencies bake absolute paths in — npm into node_modules/.bin shebangs, gradle into
# the project-local .gradle cache. So whatever you set up here works unchanged in an agent's box.

REPO="${CHECKOUT:-/home/dev/repo}"
DEV="${DEV_BRANCH:-dev}"
GOLDEN="${GOLDEN_DIR:-/work/golden}"
STAGING="${GOLDEN_STAGING:-/work/golden-staging}"
STATE="$REPO/.git/cbx"
TMUX_SESSION="${TMUX_SESSION:-services}"
BROKER_URL="${BROKER_URL:-http://box-broker:8099}"
BROKER_TOKEN="${BROKER_TOKEN:-}"

# The interactive review TUI `cbx review` opens on an agent's branch. Default: tuicr (tuicr.dev),
# installed into this image by common-setup.sh — scroll the diff, leave line/range comments, quit, and
# cbx offers to send them to the box (see review_tui / review_send).
#
#   CBX_REVIEW_TUI unset      -> tuicr if it is on PATH, else the plain delta/less pager
#   CBX_REVIEW_TUI=           -> never a TUI; always the pager (same as passing --plain every time)
#   CBX_REVIEW_TUI='cmd …'    -> that command instead. The commit range is substituted for a {range}
#                                placeholder, or appended when there is none:
#                                  CBX_REVIEW_TUI='hunk'                -> hunk dev..refs/agents/work1
#                                  CBX_REVIEW_TUI='delta --paging=always {range}'
#                                Only tuicr's comments can be harvested and sent to the box — any other
#                                command is a viewer, and cbx just falls back to `cbx fix -m` after it.
# `-` is accepted as a synonym for empty, since an empty value is easy to lose through a wrapper.
# The placeholder is held in its own variable and NEVER written inline in a ${…}: the '}' of
# '{range}' would close the parameter expansion early, so `${CBX_REVIEW_TUI-tuicr -r {range}}` silently
# means "…-tuicr -r {range" followed by a literal '}' — which appends a stray brace to whatever the
# user set (and only looks right when the variable is unset).
REVIEW_TUI_PLACEHOLDER='{range}'
# --no-update-check: tuicr phones GitHub for a newer release at startup. Here the version is pinned by
# the image (common-setup.sh), so an update notice would only be a slower start and advice you cannot act on.
REVIEW_TUI_DEFAULT="tuicr --no-update-check -r $REVIEW_TUI_PLACEHOLDER"
REVIEW_TUI="${CBX_REVIEW_TUI-$REVIEW_TUI_DEFAULT}"
# `if`, not `[ … ] && …`: under `set -e` a bare test that FAILS becomes the script's exit status, so
# the common case (a value that isn't '-') would kill cbx right here. Same reason for the guards below.
if [ "$REVIEW_TUI" = "-" ]; then REVIEW_TUI=""; fi

# Your project's "make this tree ready to build" command. `cbx golden snapshot --prep` runs it IN THE
# REPO (not in a copy), so it's an optional convenience around the setup you'd otherwise do by hand —
# and whatever it installs is captured at the path it will actually be used from.
GOLDEN_PREP_CMD="${GOLDEN_PREP_CMD:-npm --prefix infostarsFrontend ci}"

# Dev services are declared as MANIFESTS — one file per service in this directory (bind-mounted from
# the stack's hub-services/, so a service can be added or edited by a file sync, no image rebuild).
# See svc_load() for the format. Nothing here parses the command: it is handed VERBATIM to `bash -lc`
# in a tmux window at `cbx up` time, INSIDE the container, so relative paths resolve against the repo
# and shell substitutions ($(…), $VAR) are evaluated then — which is how the backend's aspectj
# `-javaagent:$(find …)` gets a path nobody knows until after the build.
HUB_SERVICES_DIR="${HUB_SERVICES_DIR:-/work/hub-services}"

die() { echo "cbx: $*" >&2; exit 1; }
git_() { git -C "$REPO" "$@"; }

# ---- agent activity -------------------------------------------------------------------------
# Each box's claude writes "<state> <epoch>" to $HOME/.cbx-state via the cbx-activity hooks (the
# broker registers them in the shared ~/.claude/settings.json). That file is the box's home anchor,
# mounted here read-only — so this is a plain file read, no broker round-trip.
BOXES="${BOXES_DIR:-/work/boxes}"
# A 'busy' older than this is reported as 'stale': the hooks stopped firing (claude was killed, the
# box was recreated, hooks aren't installed). Treated as NOT busy, so a stale file can never wedge
# the workflow — the failure mode of this feature is "no protection", never "can't work".
ACTIVITY_STALE="${CBX_ACTIVITY_STALE:-900}"

# Prints "<state> <age-seconds>"; state is busy | waiting | idle | stale | unknown.
box_activity() {
	local f="$BOXES/$1/home/.cbx-state" st ts age
	[ -r "$f" ] || { echo "unknown -"; return 0; }
	read -r st ts < "$f" 2>/dev/null || { echo "unknown -"; return 0; }
	case "$ts" in ''|*[!0-9]*) echo "unknown -"; return 0 ;; esac
	age=$(( $(date +%s) - ts ))
	[ "$st" = busy ] && [ "$age" -gt "$ACTIVITY_STALE" ] && st=stale
	echo "$st $age"
}

# Refuse to interrupt a working agent. 'waiting' is NOT guarded: claude is asking YOU something, so
# typing at it is the point. Returns non-zero when the caller should skip this box.
guard_busy() {
	local box="$1" force="${2:-}" st age
	read -r st age <<< "$(box_activity "$box")"
	if [ "$st" = busy ] && [ "$force" != --force ]; then
		echo "cbx: $box is BUSY (working for ${age}s) — not interrupting it." >&2
		echo "cbx: your text would land in its input mid-task. Wait for idle ('cbx status'), or --force." >&2
		return 1
	fi
	return 0
}
# ---- terminal presentation ------------------------------------------------------------------
# Colour is decided ONCE, by colors_init, from $CBX_COLOR (auto|always|never) — never by a `[ -t 1 ]`
# test at print time. `cbx q` renders a whole frame inside "$(status_overview)", where stdout is a
# pipe, so a print-time auto-detect would silently strip every attribute from the live dashboard.
C_RESET=; C_B=; C_DIM=; C_RED=; C_GRN=; C_YEL=; C_BLU=; C_MAG=; C_CYA=

colors_init() {
	local mode="${1:-${CBX_COLOR:-auto}}"
	case "$mode" in
		never|off|0) mode=off ;;
		always|on|1) mode=on ;;
		*) if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then mode=on; else mode=off; fi ;;
	esac
	if [ "$mode" = on ]; then
		C_RESET=$'\033[0m'; C_B=$'\033[1m'; C_DIM=$'\033[2m'
		C_RED=$'\033[31m'; C_GRN=$'\033[32m'; C_YEL=$'\033[33m'
		C_BLU=$'\033[34m'; C_MAG=$'\033[35m'; C_CYA=$'\033[36m'
	else
		C_RESET=; C_B=; C_DIM=; C_RED=; C_GRN=; C_YEL=; C_BLU=; C_MAG=; C_CYA=
	fi
}

# A section title plus a rule to the right margin, so the screen reads as bands instead of a wall of
# text. The rule is built with a parameter expansion, not `tr`: tr is byte-oriented and would emit
# the first byte of a multi-byte box-drawing char once per column.
hdr() {
	local n bar
	n=$(( $(term_cols) - ${#1} - 4 ))
	[ "$n" -ge 2 ] || n=2
	printf -v bar '%*s' "$n" ''
	printf '%s── %s %s%s\n' "$C_B$C_BLU" "$1" "${bar// /─}" "$C_RESET"
}

# Pad THEN colour: escape sequences are zero-width but printf's %-*s counts them, so colouring first
# would shorten every padded cell by the length of its attribute string and skew the whole table.
cell() { printf '%s%-*s%s' "$1" "$2" "$3" "$C_RESET"; }

# How wide we may draw. $CBX_COLS is set by the watch loop (where stdout IS a terminal); everywhere
# else we ask tput and fall back to a sane 100 rather than wrapping a table nobody can read.
term_cols() {
	local c="${CBX_COLS:-}"
	[ -n "$c" ] || c="$(tput cols 2>/dev/null || true)"
	case "$c" in ''|*[!0-9]*) c=100 ;; esac
	[ "$c" -ge 60 ] || c=100
	printf '%s' "$c"
}

# 20011s is not a duration anyone reads — 5h33m is. Keeps two significant units, never wider than 6.
human_age() {
	local s="${1:-}"
	case "$s" in ''|*[!0-9]*) printf '%s' "${s:--}"; return 0 ;; esac
	if   [ "$s" -lt 60 ];    then printf '%ds' "$s"
	elif [ "$s" -lt 3600 ];  then printf '%dm%02ds' "$((s / 60))" "$((s % 60))"
	elif [ "$s" -lt 86400 ]; then printf '%dh%02dm' "$((s / 3600))" "$((s % 3600 / 60))"
	else printf '%dd%02dh' "$((s / 86400))" "$((s % 86400 / 3600))"; fi
}

trunc() {
	local w="$1" t="$2"
	[ "$w" -ge 8 ] || w=8
	if [ "${#t}" -le "$w" ]; then printf '%s' "$t"; else printf '%s…' "${t:0:$((w - 1))}"; fi
}

# Colour by what the state MEANS to you: yellow = the machine is working (leave it alone), magenta =
# it is blocked on you, green = free, red = something is wrong.
act_color() {
	case "$1" in
		busy)    printf '%s' "$C_YEL" ;;
		waiting) printf '%s' "$C_B$C_MAG" ;;
		idle)    printf '%s' "$C_GRN" ;;
		stale)   printf '%s' "$C_RED" ;;
		*)       printf '%s' "$C_DIM" ;;
	esac
}

# Same idea for the review queue: green/magenta = your move, cyan = ready to land, dim = done.
q_color() {
	case "$1" in
		new)       printf '%s' "$C_B$C_MAG" ;;
		re-review) printf '%s' "$C_YEL" ;;
		reviewed)  printf '%s' "$C_B$C_GRN" ;;
		rebased)   printf '%s' "$C_CYA" ;;
		*)         printf '%s' "$C_DIM" ;;
	esac
}

have_delta() { command -v delta >/dev/null 2>&1; }

# One pager for a whole review (commits + notes + diff), so nothing gets painted over. delta renders
# the diff hunks and passes other lines through, which is why the log can share the stream. Falls
# back to less, and to cat when the output isn't a terminal (piping `cbx review` somewhere).
review_pager() {
	if [ ! -t 1 ]; then cat
	elif have_delta; then delta --paging=always
	else less -R
	fi
}

# ------------------------------------------------------------------ services
#
# A service is one manifest file in $HUB_SERVICES_DIR; the FILENAME is the service name. Fields are
# `key=value`, one per line, '#' comments and blanks ignored:
#   command      (required) the shell run in a tmux window via `bash -lc`. Everything after the first
#                '=' is taken VERBATIM — quotes, &&, and $(…) all survive to the launch shell, so the
#                dynamic aspectj path keeps working. Unlike service-env, $VAR is SAFE here (this file
#                is read only by cbx; compose/the broker never interpolate it).
#   workdir      (optional) cwd for the command; default is the repo ($REPO). $VAR is expanded.
#   writes_repo  (optional) true = the service writes into the repo, so `cbx golden snapshot` refuses
#                to run while it is up (a torn snapshot otherwise). Was the hard-coded backend/frontend.
#   autostart    (optional) true = started automatically at hub boot (`cbx autostart`, from entrypoint).
#   description  (optional) shown by `cbx svcs`.

# Parse one manifest into SVC_* globals. Returns 1 (no such manifest) / 2 (no command) / 0 (ok).
svc_load() {
	local name="$1" file line key val
	file="$HUB_SERVICES_DIR/$name"
	SVC_COMMAND=""; SVC_WORKDIR=""; SVC_WRITES_REPO=""; SVC_AUTOSTART=""; SVC_DESCRIPTION=""
	[ -f "$file" ] || return 1
	while IFS= read -r line || [ -n "$line" ]; do
		case "$line" in ''|'#'*) continue ;; esac
		key="${line%%=*}"
		[ "$key" != "$line" ] || continue          # no '=' on the line — not a field
		val="${line#*=}"
		key="${key#"${key%%[![:space:]]*}"}"; key="${key%"${key##*[![:space:]]}"}"   # trim the KEY only
		case "$key" in
			command)     SVC_COMMAND="$val" ;;
			workdir)     SVC_WORKDIR="$val" ;;
			writes_repo) SVC_WRITES_REPO="$val" ;;
			autostart)   SVC_AUTOSTART="$val" ;;
			description) SVC_DESCRIPTION="$val" ;;
		esac
	done < "$file"
	[ -n "$SVC_COMMAND" ] || return 2
	return 0
}

# true/1/yes/on -> success; anything else (incl. empty) -> failure.
svc_truthy() { case "$1" in 1|true|yes|on|TRUE|Yes|On) return 0 ;; *) return 1 ;; esac; }

# Every manifest name in the dir, sorted. Dotfiles/editor turds are skipped by the glob.
svc_names() {
	local f
	[ -d "$HUB_SERVICES_DIR" ] || return 0
	for f in "$HUB_SERVICES_DIR"/*; do
		[ -f "$f" ] || continue
		printf '%s\n' "${f##*/}"
	done
	return 0
}

svc_running() { tmux list-windows -t "$TMUX_SESSION" -F '#W' 2>/dev/null | grep -qx "$1"; }

svc_up() {
	local svc="$1" cmd
	svc_load "$svc" || die "unknown service '$svc' — no manifest at $HUB_SERVICES_DIR/$svc ('cbx svcs' lists them)"
	if svc_running "$svc"; then
		echo "cbx: $svc already running (cbx logs $svc to view)"; return 0
	fi
	cmd="$SVC_COMMAND"
	# workdir overrides the window's default cwd; unquoted so $REPO/$VAR expand in the launch shell.
	[ -n "$SVC_WORKDIR" ] && cmd="cd $SVC_WORKDIR && $cmd"
	# keep the window alive after the command exits so failures stay readable
	tmux new-window -t "$TMUX_SESSION" -n "$svc" -c "$REPO" \
		"bash -lc $(printf '%q' "$cmd; echo; echo '[cbx] $svc exited — press enter to close'; read _")"
	echo "cbx: started $svc (cbx logs $svc to view)"
}

svc_down() {
	local svc="$1"
	tmux kill-window -t "${TMUX_SESSION}:${svc}" 2>/dev/null && echo "cbx: stopped $svc" \
		|| echo "cbx: $svc not running"
}

svc_logs() {
	exec tmux attach -t "${TMUX_SESSION}" \; select-window -t "${TMUX_SESSION}:$1"
}

# List every defined service with its running state, flags and description.
svc_list() {
	local svc any=0 flags
	echo "== services (from $HUB_SERVICES_DIR) =="
	for svc in $(svc_names); do
		svc_load "$svc" || { printf '  %-12s %-5s (no command — bad manifest)\n' "$svc" "----"; any=1; continue; }
		any=1
		flags=""
		svc_truthy "$SVC_AUTOSTART"   && flags="${flags}autostart "
		svc_truthy "$SVC_WRITES_REPO" && flags="${flags}writes-repo "
		printf '  %-12s %-5s %s%s\n' "$svc" "$(svc_running "$svc" && echo up || echo down)" \
			"${flags:+[$flags] }" "${SVC_DESCRIPTION:-}"
	done
	[ "$any" = 1 ] || echo "  (none — drop a manifest in $HUB_SERVICES_DIR; see hub-services.example)"
}

# Start every service whose manifest sets autostart=true. Called from the hub entrypoint at boot.
svc_autostart() {
	local svc n=0
	for svc in $(svc_names); do
		svc_load "$svc" || continue
		svc_truthy "$SVC_AUTOSTART" || continue
		echo "cbx: autostart $svc" >&2
		svc_up "$svc" || echo "cbx: autostart of $svc failed (continuing)" >&2
		n=$((n + 1))
	done
	[ "$n" -gt 0 ] || echo "cbx: no services marked autostart in $HUB_SERVICES_DIR" >&2
}

# ------------------------------------------------------------------ broker

broker() {
	local method="$1" path="$2"; shift 2
	# --fail-with-body (curl >= 7.76): like -f it still returns non-zero on HTTP >= 400 so callers'
	# `&&` chains detect failure, but UNLIKE -f it prints the response body, so the broker's
	# {"error": "..."} is shown instead of a bare "curl: (22) ... error: 500".
	curl --fail-with-body -sS -X "$method" -H "X-Broker-Token: $BROKER_TOKEN" "$@" "${BROKER_URL}${path}"
}

jqr() { jq -r "$1" 2>/dev/null || true; }

box_new() {
	local name="${1:-$(cut -c1-6 /proc/sys/kernel/random/uuid 2>/dev/null || echo $$)}"
	local resp container
	resp="$(broker POST "/box/$name")" || die "spawning box '$name' failed: $resp"
	container="$(printf '%s' "$resp" | jqr '.container // empty')"
	[ -n "$container" ] || container="$(printf '%s' "$resp" | sed -n 's/.*"container"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p')"
	echo "cbx: box '$name' up as '$container' on branch agent/$name (golden $(printf '%s' "$resp" | jqr '.golden // empty'))."
	echo "  docker exec -it -u dev $container tmux attach -t main      # Ctrl-b d to detach"
}

box_kill() {
	[ $# -ge 1 ] || die "kill needs a box name"
	local resp
	resp="$(broker DELETE "/box/$1")" || die "killing box '$1' failed: $resp"
	echo "cbx: killed box '$1' (its upper layer is kept — 'cbx box $1' reattaches to it)"
}

box_recreate() {
	[ $# -ge 1 ] || die "recreate needs a box name (or 'all')"
	local target="$1" q="" resp
	shift
	[ "${1:-}" = --fresh ] && q="?fresh=1"
	if [ "$target" = all ]; then
		echo "cbx: pulling newest image + recreating all boxes (each resumes its own session)..."
		resp="$(broker POST "/recreate${q}")" || die "recreate all failed: $resp"
		echo "cbx: recreated: $(printf '%s' "$resp" | jqr '.recreated | join(", ")')"
	else
		resp="$(broker POST "/recreate/${target}${q}")" || die "recreate '$target' failed: $resp"
		echo "cbx: box '$target' recreated as '$(printf '%s' "$resp" | jqr '.container // empty')'."
	fi
}

forwards_refresh() {
	# The socat forwarders live in the HUB's netns, so replacing the hub container (any `docker compose
	# up -d hub`) kills them and agent frontends silently stop being reachable from pinchtab. The hub
	# does this on boot; run it by hand if a box's dev server went unreachable without being restarted.
	local resp
	resp="$(broker POST "/forwards${1:+/$1}")" || die "refreshing forwards failed: $resp"
	echo "cbx: re-established forwards for: $(printf '%s' "$resp" | jqr '.forwards | join(", ") // "(none running)"')"
}

box_ls() {
	svc_list
	echo "== boxes (broker) =="
	local resp box st age
	if resp="$(broker GET "/box" 2>/dev/null)"; then
		while IFS=$'\t' read -r box status golden; do
			[ -n "$box" ] || continue
			read -r st age <<< "$(box_activity "$box")"
			printf '  %-12s %-10s %-22s %s\n' "$box" "$st" "$status" "golden=$golden"
		done < <(printf '%s' "$resp" | jq -r '.boxes[]? | "\(.box)\t\(.status)\t\(.golden)"' 2>/dev/null)
	else
		echo "  (broker unreachable)"
	fi
}

say_to_box() {
	# Deliver a line into the box's claude session. Note this is a PROMPT, not a shell command: the
	# window runs claude, so phrase instructions the way you'd type them to the agent.
	# RETURNS non-zero rather than dying: several callers (merge, drop, rebase) treat an unreachable
	# box as a note, not a failure — and a `die` here would abort them AFTER they'd done their work.
	local box="$1" msg="$2" resp
	resp="$(broker POST "/box/$box/say" --data-raw "$msg" 2>&1)" || {
		echo "cbx: could not reach box '$box': $resp" >&2
		return 1
	}
}

paste_to_box() {
	# Same, for a MULTI-LINE prompt (a tuicr review: one numbered point per line). say_to_box cannot
	# carry one — its send-keys types the text, and claude submits on every newline, so an N-line
	# review would arrive as N half-prompts, each acted on before the next lands. /paste puts the text
	# in through tmux's BRACKETED paste instead, exactly like a real paste into the composer, and the
	# Enter that follows is the only thing that submits. --data-binary, not --data-raw: curl's
	# --data-raw is still text and @-free but we want the bytes and newlines untouched.
	local box="$1" msg="$2" resp
	resp="$(broker POST "/box/$box/paste" --data-binary @- <<<"$msg" 2>&1)" || {
		echo "cbx: could not reach box '$box': $resp" >&2
		return 1
	}
}

# ------------------------------------------------------------------ review queue

agent_refs() { git_ for-each-ref --format='%(refname:strip=2)' refs/agents/; }

# The handoff summary, or empty. The `|| true` is load-bearing: `git notes show` exits non-zero when
# a box handed off WITHOUT a summary (bare `handoff`), pipefail propagates that through head, and
# under `set -e` the enclosing `msg="$(note_of …)"` then kills the whole command silently.
note_of() { git_ notes --ref=cbx show "refs/agents/$1" 2>/dev/null | head -1 || true; }

# Conflicted paths between two committishes, without touching the worktree or the index.
# --no-messages drops git's "Auto-merging / CONFLICT (content)" prose, leaving the tree oid on line 1
# and one conflicted path per line after it; a clean merge exits 0 and we report nothing.
conflicts_between() {
	local out
	if out="$(git_ merge-tree --write-tree --name-only --no-messages "$1" "$2" 2>/dev/null)"; then
		return 0                     # clean merge, nothing to report
	fi
	printf '%s' "$out" | tail -n +2 | tr '\n' ' '
}

# Review state per box: "<agent-ref sha> <dev sha>", both as of your last review. The dev sha is what
# lets us tell a REBASE apart from new work — after a rebase every commit gets a new sha, so the ref
# alone always looks changed even when the agent did nothing.
review_state() { cat "$STATE/$1.reviewed" 2>/dev/null || true; }
reviewed_ref() { awk '{print $1}' "$STATE/$1.reviewed" 2>/dev/null || true; }
reviewed_dev() { awk '{print $2}' "$STATE/$1.reviewed" 2>/dev/null || true; }

# Sorted patch-ids for a range. A patch-id hashes the CHANGE, not the commit, so it survives a rebase
# (and any commit-date/parent churn) — identical sets mean identical content.
# NOTE the input must be a PATCH: `git patch-id` fed a list of shas (rev-list) silently reads no diff
# and prints nothing, which would make every comparison below trivially "equal".
patch_ids() {
	git_ log --no-color --no-merges -p "$1..$2" 2>/dev/null | git_ patch-id --stable 2>/dev/null \
		| awk '{print $1}' | sort || true
}

# True when the branch changed only because it was rebased: same patches, different shas. Needs a
# recorded dev sha, so state written before this existed just falls through to "re-review".
rebase_only() {
	local box="$1" pdev pref old new
	pdev="$(reviewed_dev "$box")"; pref="$(reviewed_ref "$box")"
	[ -n "$pdev" ] && [ -n "$pref" ] || return 1
	git_ rev-parse --verify -q "${pdev}^{commit}" >/dev/null || return 1
	old="$(patch_ids "$pdev" "$pref")"
	new="$(patch_ids "$DEV" "refs/agents/$box")"
	# Two empty sets are not evidence of a rebase — they mean we failed to read patches at all.
	[ -n "$old" ] && [ "$old" = "$new" ]
}

# new | reviewed | rebased | re-review
box_status() {
	local box="$1" sha prev
	sha="$(git_ rev-parse "refs/agents/$box")"
	prev="$(reviewed_ref "$box")"
	if [ -z "$prev" ]; then echo new
	elif [ "$prev" = "$sha" ]; then echo reviewed
	elif rebase_only "$box"; then echo rebased
	else echo re-review
	fi
}

queue() {
	local any=0 box sha ahead age note prev status conf other
	printf '%-12s %6s %-14s %-11s %s\n' BOX AHEAD LAST STATUS SUMMARY
	for box in $(agent_refs); do
		any=1
		sha="$(git_ rev-parse "refs/agents/$box")"
		ahead="$(git_ rev-list --count "$DEV..refs/agents/$box" 2>/dev/null || echo '?')"
		age="$(git_ log -1 --format=%cr "refs/agents/$box")"
		note="$(note_of "$box")"
		status="$(box_status "$box")"
		printf '%-12s %6s %-14s %-11s %s\n' "$box" "$ahead" "$age" "$status" "${note:-—}"
		# Conflicts are the shared-checkout collision awareness, moved earlier: you learn that two
		# agents touched the same lines when they push, not when you merge the second one.
		conf="$(conflicts_between "$DEV" "refs/agents/$box")"
		[ -n "$conf" ] && printf '  %-10s ⚠ conflicts with %s: %s\n' "" "$DEV" "$conf"
		for other in $(agent_refs); do
			[ "$other" = "$box" ] && continue
			[[ "$other" > "$box" ]] || continue          # report each pair once
			conf="$(conflicts_between "refs/agents/$box" "refs/agents/$other")"
			[ -n "$conf" ] && printf '  %-10s ⚠ conflicts with %s: %s\n' "" "$other" "$conf"
		done
	done
	[ "$any" = 1 ] || echo "  (nothing waiting — no refs/agents/* pushed yet)"
}

status_overview() {
	# One screen: everything that can move, and the command that moves it. Each section prints state;
	# anything actionable is collected into the "next" list at the bottom in the order you'd do it
	# (pull before merge before push, so agent work never lands on a stale base).
	#
	# `cbx q`'s watch mode repaints THIS, so keep it cheap and side-effect free. Its one network call
	# is the origin fetch, which `--no-fetch` skips (the watch loop throttles it to $WATCH_FETCH).
	local behind ahead box sha st bhd ahd age note conf other list running gprov gsha todo=()
	local cols nw=3 sumw rows=() row bname bstatus bgolden bstate bage detail

	cols="$(term_cols)"

	# Both tables key on the box name, so they share ONE name column: the eye then reads straight down
	# from "who handed off" to "who is still running". That needs the broker list before the queue is
	# printed, which is why the call sits up here rather than in the boxes section below.
	list="$(agent_refs)"
	running="$(broker GET /box 2>/dev/null || true)"
	if [ -n "$running" ]; then
		while IFS=$'\t' read -r bname bstatus bgolden; do
			[ -n "$bname" ] || continue
			rows+=("$bname"$'\t'"$bstatus")
		done < <(printf '%s' "$running" | jq -r '.boxes[]? | "\(.box)\t\(.status)\t\(.golden)"' 2>/dev/null)
	fi
	for box in $list; do [ "${#box}" -gt "$nw" ] && nw="${#box}"; done
	for row in ${rows[@]+"${rows[@]}"}; do
		bname="${row%%$'\t'*}"
		[ "${#bname}" -gt "$nw" ] && nw="${#bname}"
	done
	[ "$nw" -le $(( cols / 3 )) ] || nw=$(( cols / 3 ))   # one pathological name must not eat the table

	hdr branch
	if [ "${1:-}" = --no-fetch ]; then
		:
	else
		git_ fetch -q origin "$DEV" 2>/dev/null \
			|| printf '  %s(origin unreachable — counts below may be stale)%s\n' "$C_YEL" "$C_RESET"
	fi
	read -r behind ahead <<< "$(divergence)"
	printf '  %s%s%s @ %s%s%s — %s%s behind%s, %s%s ahead%s of origin\n' \
		"$C_B" "$DEV" "$C_RESET" "$C_YEL" "$(git_ rev-parse --short "$DEV")" "$C_RESET" \
		"$([ "$behind" = 0 ] && printf '%s' "$C_DIM" || printf '%s' "$C_B$C_RED")" "$behind" "$C_RESET" \
		"$([ "$ahead" = 0 ] && printf '%s' "$C_DIM" || printf '%s' "$C_GRN")" "$ahead" "$C_RESET"
	[ "$behind" != 0 ] && todo+=("cbx pull                # take $behind commit(s) from origin first")

	# The queue lives INSIDE the overview (rather than beside it) so one screen answers both "who is
	# waiting on me" and "what do I do about it" — `cbx q --text` still prints the bare table.
	hdr queue
	# 2 indent + name + status(9) + ahead(5) + behind(6) + last(13), each with a space after it.
	sumw=$(( cols - nw - 39 ))
	if [ -z "$list" ]; then
		printf '  %s(nothing waiting — an agent publishes with '"'"'handoff "summary"'"'"')%s\n' "$C_DIM" "$C_RESET"
	else
		printf '  %s%-*s %-9s %5s %6s %-13s %s%s\n' \
			"$C_DIM" "$nw" BOX STATUS AHEAD BEHIND LAST SUMMARY "$C_RESET"
	fi
	for box in $list; do
		sha="$(git_ rev-parse --short "refs/agents/$box")"
		st="$(box_status "$box")"
		ahd="$(git_ rev-list --count "$DEV..refs/agents/$box" 2>/dev/null || echo '?')"
		bhd="$(git_ rev-list --count "refs/agents/$box..$DEV" 2>/dev/null || echo '?')"
		age="$(git_ log -1 --format=%cr "refs/agents/$box")"; age="${age% ago}"
		note="$(note_of "$box")"
		printf '  %s %s %s%5s%s %s%6s%s %s%-13s%s %s\n' \
			"$(cell "$C_B" "$nw" "$(trunc "$nw" "$box")")" "$(cell "$(q_color "$st")" 9 "$st")" \
			"$C_GRN" "$ahd" "$C_RESET" \
			"$([ "$bhd" = 0 ] && printf '%s' "$C_DIM" || printf '%s' "$C_YEL")" "$bhd" "$C_RESET" \
			"$C_DIM" "$(trunc 13 "$age")" "$C_RESET" \
			"$(trunc "$sumw" "${note:-—}")"
		# Conflicts are the shared-checkout collision awareness, moved earlier: you learn that two
		# agents touched the same lines when they push, not when you merge the second one.
		# 22 = the two-space indent, the space after the name column, and "⚠ conflicts with <x>: ".
		conf="$(conflicts_between "$DEV" "refs/agents/$box")"
		[ -n "$conf" ] && printf '  %*s %s⚠ conflicts with %s:%s %s\n' \
			"$nw" "" "$C_B$C_RED" "$DEV" "$C_RESET" "$(trunc "$((cols - nw - 22 - ${#DEV}))" "$conf")"
		for other in $list; do
			[ "$other" = "$box" ] && continue
			[[ "$other" > "$box" ]] || continue          # report each pair once
			conf="$(conflicts_between "refs/agents/$box" "refs/agents/$other")"
			[ -n "$conf" ] && printf '  %*s %s⚠ conflicts with %s:%s %s\n' \
				"$nw" "" "$C_B$C_RED" "$other" "$C_RESET" "$(trunc "$((cols - nw - 22 - ${#other}))" "$conf")"
		done
		case "$st" in
			new|re-review) todo+=("cbx review $box") ;;
			rebased)       todo+=("cbx merge $box            # rebased only, nothing new to read") ;;
			reviewed)      todo+=("cbx merge $box") ;;
		esac
		[ "$bhd" != 0 ] && [ "$bhd" != '?' ] && todo+=("cbx rebase $box           # $bhd commit(s) behind $DEV")
	done

	hdr boxes
	if [ -z "$running" ]; then
		printf '  %s(broker unreachable)%s\n' "$C_RED" "$C_RESET"
	elif [ "${#rows[@]}" -eq 0 ]; then
		printf '  %s(no boxes running — cbx box <name> to start one)%s\n' "$C_DIM" "$C_RESET"
	fi
	for row in ${rows[@]+"${rows[@]}"}; do
		bname="${row%%$'\t'*}"; bstatus="${row#*$'\t'}"
		read -r bstate bage <<< "$(box_activity "$bname")"
		# The right-hand column answers "and how long has that been true", which is the whole reason to
		# look: a 3s 'waiting' is the agent thinking out loud, a 5h33m one is a session you forgot.
		case "$bstate" in
			busy)    detail="${C_DIM}working for${C_RESET} $(human_age "$bage")" ;;
			waiting) detail="${C_B}${C_MAG}wants your input${C_RESET} ${C_DIM}for${C_RESET} $(human_age "$bage")" ;;
			idle)    detail="${C_DIM}$bstatus, quiet for${C_RESET} $(human_age "$bage")" ;;
			stale)   detail="${C_RED}no hook activity for $(human_age "$bage")${C_RESET} ${C_DIM}($bstatus)${C_RESET}" ;;
			*)       detail="${C_DIM}$bstatus${C_RESET}" ;;
		esac
		printf '  %s %s%s %-8s%s %s\n' \
			"$(cell "$C_B" "$nw" "$(trunc "$nw" "$bname")")" "$(act_color "$bstate")" "●" "$bstate" "$C_RESET" "$detail"
	done

	hdr golden
	gprov="$(cat "$GOLDEN/current/.git/cbx-golden" 2>/dev/null || true)"
	if [ -z "$gprov" ]; then
		printf '  %s(none yet)%s\n' "$C_DIM" "$C_RESET"
		todo+=("cbx golden snapshot     # no base for boxes to overlay")
	else
		printf '  %s%s%s\n' "$C_DIM" "$gprov" "$C_RESET"
		# Field 3 of "g-<id> from <sha> (<branch>) at <date>" — a hint only, so it is never fatal.
		gsha="$(printf '%s' "$gprov" | awk '{print $3}')"
		if [ -n "$gsha" ] && ! git_ merge-base --is-ancestor "$DEV" "$gsha" 2>/dev/null; then
			printf '  %s(%s has moved since — a snapshot would give new boxes a fresher base)%s\n' \
				"$C_YEL" "$DEV" "$C_RESET"
		fi
	fi

	hdr next
	if [ "${#todo[@]}" -eq 0 ]; then
		[ "$ahead" != 0 ] && todo_line "cbx push                # $ahead commit(s) to origin" \
			|| printf '  %s(nothing to do)%s\n' "$C_DIM" "$C_RESET"
	else
		for row in "${todo[@]}"; do todo_line "$row"; done
		[ "$ahead" != 0 ] && [ "$behind" = 0 ] && todo_line "cbx push                # $ahead commit(s) to origin"
	fi
	return 0
}

# One "next" entry: the command in green (it is meant to be copied), the trailing "# why" dimmed so
# the column of commands stays scannable.
todo_line() {
	local t="$1" cmd why
	case "$t" in
		*'#'*) cmd="${t%%#*}"; why="#${t#*#}" ;;
		*)     cmd="$t"; why="" ;;
	esac
	cmd="${cmd%"${cmd##*[![:space:]]}"}"
	printf '  %s▸%s %s%s%s%s\n' "$C_DIM" "$C_RESET" "$C_GRN" "$cmd" "$C_RESET" \
		"${why:+ $C_DIM$why$C_RESET}"
}

# ------------------------------------------------------------------ live watch (`cbx q`)
#
# Repaints status_overview on an interval and RINGS THE TERMINAL BELL on the two things worth
# looking up from what you were doing:
#   * an agent stopped working (busy -> anything else — 'waiting' means it is asking YOU something)
#   * a handoff landed or was updated: refs/agents/<box> appeared or moved = a review request
# The bell is a bare BEL byte on stdout, so it rides the `docker exec -it` + `ssh -t` PTY straight to
# your laptop's terminal — no notification daemon anywhere in the chain, works over the laptop alias.
#
# Everything here is polled, never pushed: the box activity file and the agent refs are both local
# reads on the hub, so a short interval is cheap. The ONE network call in a frame is the origin fetch
# in status_overview, which is throttled to $WATCH_FETCH (the rest of the frames pass --no-fetch).
WATCH_INTERVAL="${CBX_WATCH_INTERVAL:-5}"
WATCH_FETCH="${CBX_WATCH_FETCH:-60}"
WATCH_EVENTS=()
WATCH_RING=0

# watch_event <colour> <text…>. The colour is stored WITH the event rather than applied at print
# time, because only the caller knows whether "box stopped working" was a handoff (good) or a box
# that quietly went idle on you (not).
watch_event() {
	local color="$1"; shift
	WATCH_EVENTS+=("$(date +%H:%M:%S)"$'\t'"$color"$'\t'"$*")
	# Keep the tail only: the frame has to fit on a screen, and old events are scrollback, not state.
	[ "${#WATCH_EVENTS[@]}" -le 8 ] || WATCH_EVENTS=("${WATCH_EVENTS[@]: -8}")
	WATCH_RING=1
}

# "<box> <state>" per running box — what status_overview reads, without the rendering.
activity_snapshot() {
	local resp box st age
	resp="$(broker GET /box 2>/dev/null || true)"
	[ -n "$resp" ] || return 0
	for box in $(printf '%s' "$resp" | jqr '.boxes[]?.box'); do
		read -r st age <<< "$(box_activity "$box")"
		printf '%s %s\n' "$box" "$st"
	done
	return 0
}

# "<box> <sha>" per pushed agent branch. The sha (not the review status) is the trigger: it moves
# exactly once per handoff, whereas the status also flips when YOU review, which is not news.
ref_snapshot() {
	local box
	for box in $(agent_refs); do
		printf '%s %s\n' "$box" "$(git_ rev-parse "refs/agents/$box")"
	done
	return 0
}

watch_queue() {
	local interval="$WATCH_INTERVAL" bell=1 key frame fa hint now fetched=0 first=1
	local box st prev sha clock pad ev ets ecol emsg
	local -A act=() ref=() now_act=() now_ref=()
	while [ $# -gt 0 ]; do
		case "$1" in
			-n|--interval)  shift; interval="${1:-}" ;;
			-n*)            interval="${1#-n}" ;;
			--interval=*)   interval="${1#*=}" ;;
			--no-bell)      bell=0 ;;
			*) die "q: unknown option '$1' (--text | -n SECS | --no-bell)" ;;
		esac
		shift
	done
	case "$interval" in ''|*[!0-9]*) die "q: -n wants whole seconds (e.g. cbx q -n 10)" ;; esac
	[ "$interval" -ge 1 ] || die "q: -n must be at least 1 second"
	# Nothing to watch when the output is a pipe or a file — repainting would just append frames
	# forever. Options are still parsed above, so a typo is an error either way.
	[ -t 1 ] || { queue; return 0; }
	# We KNOW stdout is a terminal here, and the frame is rendered through a command substitution
	# where nothing downstream could work that out — so decide colour and width once, up here, and
	# let status_overview inherit both.
	colors_init "${CBX_COLOR:-always}"

	while :; do
		# Re-read every frame: the window can be resized between repaints, and a stale width would
		# either wrap the table or leave a ragged right margin until the next restart.
		CBX_COLS="$(tput cols 2>/dev/null || echo 100)"
		case "$CBX_COLS" in ''|*[!0-9]*) CBX_COLS=100 ;; esac
		[ "$CBX_COLS" -ge 60 ] || CBX_COLS=100
		now_act=(); now_ref=()
		while read -r box st;  do [ -n "$box" ] && now_act["$box"]="$st"; done < <(activity_snapshot)
		while read -r box sha; do [ -n "$box" ] && now_ref["$box"]="$sha"; done < <(ref_snapshot)

		# The first frame establishes the baseline: without this every box you are ALREADY watching
		# would ring on startup, which trains you to ignore the bell.
		if [ "$first" = 0 ]; then
			for box in "${!now_act[@]}"; do
				st="${now_act[$box]}"; prev="${act[$box]-}"
				if [ "$prev" = busy ] && [ "$st" != busy ]; then
					if [ "$st" = waiting ]; then
						watch_event "$C_B$C_MAG" "$box stopped working and is ASKING YOU something  (cbxbox $box)"
					else
						watch_event "$C_YEL" "$box stopped working — now $st  (cbx q / cbxbox $box)"
					fi
				elif [ "$prev" != waiting ] && [ -n "$prev" ] && [ "$st" = waiting ]; then
					watch_event "$C_B$C_MAG" "$box wants your input  (cbxbox $box)"
				fi
			done
			for box in "${!now_ref[@]}"; do
				if [ -z "${ref[$box]-}" ]; then
					watch_event "$C_B$C_GRN" "$box HANDED OFF — review request  (cbx review $box)"
				elif [ "${ref[$box]}" != "${now_ref[$box]}" ]; then
					watch_event "$C_GRN" "$box pushed again — re-review  (cbx review $box)"
				fi
			done
		fi
		act=(); ref=()
		for box in "${!now_act[@]}"; do act["$box"]="${now_act[$box]}"; done
		for box in "${!now_ref[@]}"; do ref["$box"]="${now_ref[$box]}"; done

		now="$(date +%s)"
		if [ "$((now - fetched))" -ge "$WATCH_FETCH" ]; then fetched="$now"; fa=""; else fa=--no-fetch; fi
		# Render into a variable first, then clear + print in one go: a frame built directly onto the
		# screen flickers for as long as the git plumbing takes, which is most of the interval.
		frame="$(status_overview ${fa:+"$fa"} 2>&1)" || true

		hint="refresh ${interval}s · Enter now · q quits"
		[ "$bell" = 1 ] || hint="$hint · bell OFF"
		clock="$(date +%H:%M:%S)"
		# Title bar: name + hints on the left, clock hard against the right margin. The pad is computed
		# from the PLAIN text (15 = " cbx q · live " plus the space before the hint), never from the
		# printed string — that one carries attribute bytes that occupy no columns.
		pad=$(( CBX_COLS - ${#hint} - ${#clock} - 15 ))
		[ "$pad" -ge 1 ] || pad=1
		printf '\033[H\033[2J'
		printf '%s cbx q · live %s %s%s%s%*s%s%s%s\n\n' \
			"$C_B$C_CYA" "$C_RESET" "$C_DIM" "$hint" "$C_RESET" "$pad" "" "$C_B" "$clock" "$C_RESET"
		printf '%s\n' "$frame"
		if [ "${#WATCH_EVENTS[@]}" -gt 0 ]; then
			hdr "while you were watching"
			for ev in "${WATCH_EVENTS[@]}"; do
				IFS=$'\t' read -r ets ecol emsg <<< "$ev"
				printf '  %s%s%s  %s%s%s\n' "$C_DIM" "$ets" "$C_RESET" "$ecol" "$emsg" "$C_RESET"
			done
		fi
		if [ "$WATCH_RING" = 1 ] && [ "$bell" = 1 ]; then printf '\a'; fi
		WATCH_RING=0
		first=0

		# read doubles as the sleep, so a keypress lands within milliseconds instead of at the end of
		# the interval. Timeout returns non-zero — harmless here, `if` disarms errexit.
		if [ -t 0 ]; then
			if read -rsn1 -t "$interval" key; then
				case "$key" in q|Q) echo; echo "cbx: stopped watching."; return 0 ;; esac
			fi
		else
			sleep "$interval"
		fi
	done
}

# ---- the review TUI (tuicr) ------------------------------------------------------------------
#
# `cbx review` opens $REVIEW_TUI on the agent's branch instead of paging a diff at you. With tuicr
# (the default) the loop closes: you leave line/range comments in the TUI, quit, and cbx reads the
# comments back out and offers to send them to the box — no retyping them into `cbx fix -m`.
#
# The handover is tuicr's PERSISTED SESSION, not its `y`/--stdout clipboard export: the export is a
# key you have to remember to press, and --stdout writes into the same stream the TUI paints on
# (tuicr renders to stdout, alt-screen; only its "tuicr-session: <slug>" announcement goes to
# stderr). The session file is written as soon as a review target becomes active, survives the TUI
# if it holds comments, and is removed by tuicr when it does not — which is exactly the "did you
# write anything?" signal we need. So: capture the slug from stderr, read the comments as JSON
# afterwards, and delete the session once it has been sent.

have_tui() { [ -n "$REVIEW_TUI" ] && command -v "${REVIEW_TUI%% *}" >/dev/null 2>&1; }
# Only tuicr's comments can be harvested; any other CBX_REVIEW_TUI is treated as a viewer.
tui_is_tuicr() { [ "$(basename "${REVIEW_TUI%% *}")" = tuicr ]; }

# Run the TUI on <range>, leaving TUI_SESSION set to tuicr's session slug (empty for anything else).
# stdout is left alone — that is where the TUI draws; only stderr is captured, so a real failure can
# be shown instead of scrolling past behind the alternate screen.
TUI_SESSION=""
run_review_tui() {
	local range="$1" cmd errf rc=0
	if [[ "$REVIEW_TUI" == *"$REVIEW_TUI_PLACEHOLDER"* ]]; then
		cmd="${REVIEW_TUI//"$REVIEW_TUI_PLACEHOLDER"/$range}"
	else cmd="$REVIEW_TUI $range"; fi
	errf="$(mktemp)"
	TUI_SESSION=""
	( cd "$REPO" && eval "$cmd" ) 2>"$errf" || rc=$?
	TUI_SESSION="$(sed -n 's/^tuicr-session: //p' "$errf" | tail -1)"
	if [ "$rc" -ne 0 ]; then
		echo "cbx: the review TUI ('$cmd') failed:" >&2
		sed 's/^/  /' "$errf" >&2
	fi
	rm -f "$errf"
	return "$rc"
}

# Read a session's not-yet-sent comments: REVIEW_MD is the numbered markdown that goes to the agent
# (anchored with tuicr's own `path:line` / `path:start-end` locations, so it can jump to each one),
# REVIEW_IDS the comment ids behind it.
#
# ALREADY-SENT comments are filtered out through cbx's own state ($STATE/<box>.sent), not by deleting
# the session: tuicr keeps an index.json beside the session files, so removing a file under it leaves
# an entry pointing at nothing. This matters because a session is keyed by the COMMIT RANGE — review
# the same unchanged branch twice and tuicr hands back the same comments, which would otherwise be
# sent to the agent a second time. (After a fix round the sha moves, so that session is new anyway.)
REVIEW_MD=""; REVIEW_IDS=""
review_harvest() {
	local slug="$1" box="$2" json seen
	REVIEW_MD=""; REVIEW_IDS=""
	json="$(tuicr review comments --session "$slug" --repo "$REPO" 2>/dev/null || true)"
	[ -n "$json" ] || return 0
	seen="$(cat "$STATE/$box.sent" 2>/dev/null || true)"
	# `.id as $i` BEFORE the pipe: inside `$s | index(.id)` the `.` is already $s (the id list), so
	# `.id` would be looked up on an array and the whole filter would error out into "no comments".
	json="$(printf '%s' "$json" | jq -c --arg seen "$seen" \
		'($seen | split("\n")) as $s | [ .[] | select(.id as $i | ($s | index($i)) == null) ]' 2>/dev/null || true)"
	[ -n "$json" ] || return 0
	REVIEW_IDS="$(printf '%s' "$json" | jq -r '.[].id' 2>/dev/null || true)"
	REVIEW_MD="$(printf '%s' "$json" | jq -r '
		to_entries[]
		| ((.key + 1) | tostring) as $n
		| (if (.value.path == null) then "(overall)" else "`" + .value.location + "`" end) as $where
		| (if ((.value.comment_type // "none") == "none") then "" else " [" + .value.comment_type + "]" end) as $kind
		| $n + ". " + $where + $kind + " — " + (.value.content | gsub("\n"; "\n   "))
	' 2>/dev/null || true)"
}

# Newest local session that actually holds comments — the fallback when the announcement line was
# missed (an older tuicr, or a TUI that died before printing it).
review_session_guess() {
	tuicr review list --repo "$REPO" 2>/dev/null | jq -r '
		[ .[] | select(.kind == "local" and .comment_count > 0) ]
		| sort_by(.updated_at) | last | .slug // empty' 2>/dev/null || true
}

# THE CONFIRM STEP: show what you wrote, and only then let it reach the agent. Nothing is sent by
# quitting the TUI — send is an explicit 's' here, so a review you abandoned halfway stays yours.
review_confirm_send() {
	local box="$1" slug="$2" md ids tmp ans
	review_harvest "$slug" "$box"
	md="$REVIEW_MD"; ids="$REVIEW_IDS"
	[ -n "$md" ] || { echo "cbx: no new comments in the review — nothing to send."; return 0; }
	while :; do
		echo
		printf '%s── feedback for %s ───────────────────────────────%s\n' "$C_B$C_CYA" "$box" "$C_RESET"
		printf '%s\n' "$md"
		printf '%s──────────────────────────────────────────────────%s\n' "$C_DIM" "$C_RESET"
		printf '[s]end to %s  [e]dit  [d]iscard ? ' "$box"
		read -r ans </dev/tty || ans=d
		case "$ans" in
			s|S|"")
				guard_busy "$box" || { echo "cbx: not sent — the review is still saved, re-run 'cbx review $box'."; return 1; }
				paste_to_box "$box" "Review feedback on your handoff:

$md

Please address each point on your branch, then run: handoff" \
					|| { echo "cbx: feedback NOT delivered — is the box running? (cbx ls)" >&2
					     echo "cbx: the review is still saved; re-run 'cbx review $box' to retry." >&2; return 1; }
				# Sent = consumed, recorded HERE rather than by touching tuicr's store (see review_harvest).
				if [ -n "$ids" ]; then printf '%s\n' "$ids" >> "$STATE/$box.sent"; fi
				echo "cbx: sent to $box. It will push again when done ('cbx q' shows re-review)."
				return 0
				;;
			e|E)
				tmp="$(mktemp --suffix=.md)"
				printf '%s\n' "$md" > "$tmp"
				# </dev/tty: stdin here is the terminal already, but be explicit — an editor started
				# with anything else on stdin renders to a dead terminal and hangs.
				"${EDITOR:-vim}" "$tmp" </dev/tty >/dev/tty 2>&1 || true
				md="$(cat "$tmp")"; rm -f "$tmp"
				[ -n "${md//[[:space:]]/}" ] || { echo "cbx: emptied — nothing to send."; return 0; }
				;;
			d|D)
				echo "cbx: not sent. The comments stay in tuicr — 're-run cbx review $box' to pick them up,"
				echo "     or drop them with: tuicr review list --repo $REPO"
				return 0
				;;
			*) echo "cbx: answer s (send), e (edit) or d (discard)." ;;
		esac
	done
}

review() {
	[ $# -ge 1 ] || die "review needs a box name"
	local box="$1" full="" net="" plain="" tui="" arg ref sha prev
	shift
	for arg in "$@"; do
		case "$arg" in
			--full)  full=1 ;;
			--net)   net=1 ;;
			--plain) plain=1 ;;
			--tui)   tui=1 ;;
			*) die "review: unknown option '$arg' (--full | --net | --tui | --plain)" ;;
		esac
	done
	if [ -n "$plain" ] && [ -n "$tui" ]; then die "review: --tui and --plain are opposites, pick one"; fi
	ref="refs/agents/$box"
	git_ rev-parse --verify -q "$ref" >/dev/null || die "no branch pushed for '$box' (has it run handoff?)"
	sha="$(git_ rev-parse "$ref")"
	prev="$(reviewed_ref "$box")"
	mkdir -p "$STATE"
	# A rebase rewrites every sha, so the branch looks changed even when the agent added nothing. Say
	# so up front — otherwise the range-diff below (one '=' line per carried-over commit) reads like
	# new work you have to re-read.
	if [ -n "$prev" ] && [ "$prev" != "$sha" ] && rebase_only "$box"; then
		echo "cbx: $box was only REBASED onto a newer $DEV since your last review — same patches, new shas."
		echo "cbx: nothing new to read; 'cbx merge $box' when ready (--full to see the branch anyway)."
		echo
	fi

	# --- viewer: the TUI, or the plain pager -----------------------------------------------------
	# Incremental = you have reviewed this box before and it has moved since. That case is the pager's,
	# because it is a `git range-diff` — only what changed since you last looked, correct across the
	# amends and rebases a fix round produces. A TUI can only be pointed at a commit RANGE, and after
	# an amend `prev..ref` is no longer "the new work" (the old commits are not ancestors any more), so
	# it would silently degrade to the whole branch. --tui asks for that anyway.
	local incremental="" use_tui=""
	if [ -n "$prev" ] && [ "$prev" != "$sha" ] && [ -z "$full" ] \
	   && git_ rev-parse --verify -q "$prev^{commit}" >/dev/null; then incremental=1; fi
	if [ -n "$plain" ]; then use_tui=""
	elif ! have_tui; then
		if [ -n "$tui" ]; then die "review: no review TUI on PATH (CBX_REVIEW_TUI='$REVIEW_TUI')"; fi
		use_tui=""
	elif [ -n "$tui" ]; then use_tui=1
	elif [ -n "$net" ]; then use_tui=""      # --net names a pager rendering (one combined diff)
	elif [ -n "$incremental" ]; then
		use_tui=""
		echo "cbx: $box changed since your last review — showing the range-diff (pager)."
		echo "cbx: '--tui' opens ${REVIEW_TUI%% *} on the whole branch instead."
		echo
	else use_tui=1
	fi

	if [ -n "$use_tui" ]; then
		if run_review_tui "$DEV..$ref"; then
			printf '%s %s' "$sha" "$(git_ rev-parse "$DEV")" > "$STATE/$box.reviewed"
			if tui_is_tuicr; then
				local slug="$TUI_SESSION"
				[ -n "$slug" ] || slug="$(review_session_guess)"
				if [ -n "$slug" ]; then
					review_confirm_send "$box" "$slug" || true
				else
					echo "cbx: no comments in the review — nothing to send."
				fi
			fi
			echo "cbx: reviewed up to $(git_ rev-parse --short "$sha"). Next: cbx fix $box -m '...' | cbx merge $box | cbx drop $box"
			return 0
		fi
		echo "cbx: falling back to the plain pager." >&2
		echo >&2
	fi

	# Everything goes through ONE pager. Printing the log first and then piping a diff to delta would
	# lose the log: delta pages on the alternate screen and paints straight over it.
	{
		echo "== $box: $(git_ rev-list --count "$DEV..$ref") commit(s) on top of $DEV =="
		echo
		if [ -n "$prev" ] && [ "$prev" != "$sha" ] && [ -z "$full" ] \
		   && git_ rev-parse --verify -q "$prev^{commit}" >/dev/null; then
			# Re-review after a fix round: show ONLY what changed since you last looked. range-diff copes
			# with the amends and rebases a fix round produces, which a plain diff cannot. Keep the plain
			# commit list above it, since range-diff shows subjects but not messages or notes.
			git_ log --color=always --notes=cbx "$DEV..$ref"
			echo
			echo "-- changes since your last review ($(git_ rev-parse --short "$prev")); --full for the whole branch --"
			echo
			# --color=always because delta does NOT understand range-diff (its inner diff is indented by
			# four spaces and carries a second +/- column, so delta passes every line through verbatim).
			# Without this, git sees a pipe, drops its own colouring, and the whole range-diff comes out
			# as flat grey text. git's dual-colour range-diff survives delta untouched.
			git_ range-diff --color=always "$DEV..$prev" "$DEV..$ref"
		elif [ -n "$net" ]; then
			# The branch's NET effect, as it will land: one combined diff, no per-commit split.
			git_ log --color=always --notes=cbx "$DEV..$ref"
			echo
			git_ diff "$DEV...$ref"
		else
			# Default: each commit with ITS OWN message, notes and diff, oldest first — so a branch with
			# several commits reads as a sequence of changes instead of one merged blob you can't
			# attribute. `--net` gives the combined diff when you want the end state instead.
			git_ log --color=always --notes=cbx --reverse --patch --stat "$DEV..$ref"
		fi
	} | review_pager

	printf '%s %s' "$sha" "$(git_ rev-parse "$DEV")" > "$STATE/$box.reviewed"
	echo
	echo "cbx: reviewed up to $(git_ rev-parse --short "$sha"). Next: cbx fix $box -m '...' | cbx merge $box | cbx drop $box"
}

fix() {
	[ $# -ge 1 ] || die "fix needs a box name"
	local box="$1" msg="" force="" a args=()
	shift
	for a in "$@"; do
		case "$a" in --force) force=--force ;; *) args+=("$a") ;; esac
	done
	set -- "${args[@]+"${args[@]}"}"
	[ "${1:-}" = -m ] && { shift; msg="$*"; } || msg="$*"
	[ -n "$msg" ] || die "fix needs a message: cbx fix $box -m 'what to change'"
	guard_busy "$box" "$force" || exit 1
	say_to_box "$box" "Review feedback on your handoff: ${msg}. Please fix it on your branch, then run: handoff" \
		|| die "feedback NOT delivered — is the box running? (cbx ls)"
	echo "cbx: sent to $box. It will push again when done ('cbx q' shows re-review)."
}

prereview() {
	[ $# -ge 1 ] || die "prereview needs a box name"
	guard_busy "$1" "${2:-}" || exit 1
	# Cheap capacity multiplier: the agent re-reads its OWN diff critically before you spend a round on
	# it. This is self-review, not an independent reviewer — see README-remote.md for the difference.
	say_to_box "$1" "Before I review this: run 'mydiff' and read your own change critically against the project's conventions in CLAUDE.md — dead code, missing tests, unhandled errors, anything you would flag in someone else's PR. Fix what you find, then run: handoff"
	echo "cbx: asked $1 to self-review and re-hand off."
}

merge() {
	[ $# -ge 1 ] || die "merge needs a box name"
	local box="$1" squash="" edit="" single="" a ref msg
	shift
	for a in "$@"; do
		case "$a" in
			--squash) squash=1 ;;
			--edit|-e) edit=1 ;;
			*) die "merge: unknown option '$a' (--squash | --edit)" ;;
		esac
	done
	ref="refs/agents/$box"
	git_ rev-parse --verify -q "$ref" >/dev/null || die "no branch pushed for '$box'"
	# The hub tree is EXPECTED to carry local setup work (it's what goldens are snapshotted from), so a
	# dirty tree is not an error here. Just show it and let git decide: it refuses precisely when the
	# merge would overwrite a file you've modified, which is the only case that actually matters.
	if [ -n "$(git_ status --porcelain)" ]; then
		echo "cbx: note — local changes in $REPO (kept; the merge aborts only if it would overwrite one):" >&2
		git_ status --short | sed 's/^/  /' >&2
	fi
	msg="$(note_of "$box")"; msg="${msg:-work from agent box $box}"

	# Don't land agent work on a stale base. If origin moved (you pushed from the laptop, a colleague
	# pushed), merging here produces a merge commit on an old tip and `cbx push` is then rejected —
	# leaving you to untangle it after the fact. Check BEFORE touching anything, and say what to do.
	local before after behind ahead
	echo "cbx: checking $DEV against origin"
	git_ fetch -q origin "$DEV" 2>/dev/null || echo "cbx: (could not reach origin — merging against the local $DEV)" >&2
	read -r behind ahead <<< "$(divergence)"
	if [ "$behind" != 0 ]; then
		echo "cbx: origin/$DEV has $behind commit(s) that $DEV doesn't." >&2
		echo "cbx: merging now would put this agent's work on a stale base and 'cbx push' would be rejected." >&2
		echo "cbx: do this first:" >&2
		echo "    cbx pull              # merge origin into $DEV (or: cbx pull --rebase)" >&2
		echo "    cbx rebase $box       # let the agent re-base its branch on the updated $DEV" >&2
		echo "    cbx review $box       # re-check what it looks like on the new base, then merge" >&2
		die "refusing to merge onto a stale $DEV"
	fi

	local ncommits
	ncommits="$(git_ rev-list --count "$DEV..$ref")"
	echo "cbx: merging refs/agents/$box ($ncommits commit(s)) into $DEV"
	# `--edit` on a single commit means "let me fix up that commit's message" — a merge commit wrapping
	# one commit is pure noise there, and having to remember `--squash` for it is a papercut. So take
	# the squash path and seed the editor with the agent's own message (see below).
	if [ -n "$edit" ] && [ -z "$squash" ] && [ "$ncommits" = 1 ]; then
		squash=1 single=1
		echo "cbx: one commit — landing it directly (no merge commit); its message is what you'll edit"
	fi
	git_ checkout -q "$DEV"
	before="$(git_ rev-parse HEAD)"
	# --edit opens an editor on the message. For a squash that message is git's SQUASH_MSG, which
	# lists EVERY squashed commit — so you rewrite the agent's history into one message starting from
	# what it actually wrote, rather than from a blank buffer. git falls back to `vi` when nothing is
	# configured; common-setup.sh puts vim in both images, so name it explicitly.
	local -a ed=()
	[ -n "$edit" ] && ed=(env GIT_EDITOR="${EDITOR:-${VISUAL:-vim}}")
	if [ -n "$squash" ]; then
		git_ merge --squash "$ref" || die "merge conflicts — resolve in $REPO, then commit"
		if [ -n "$edit" ]; then
			if [ -n "$single" ]; then
				# One commit: SQUASH_MSG's "Squashed commit of the following:" preamble is noise, so
				# open the commit's own message instead — you are editing that commit, not summarising.
				"${ed[@]}" git -C "$REPO" commit -e \
					--author="$(git_ log -1 --format='%an <%ae>' "$ref")" \
					-m "$(git_ log -1 --format=%B "$ref")" -m "Cbx-Box: $box" \
					|| die "commit aborted (empty message?) — the change is staged, finish it in $REPO"
			else
				# Append the trailer to SQUASH_MSG so it's in the buffer you edit (and can be removed).
				printf '\n%s\n' "Cbx-Box: $box" >> "$REPO/.git/SQUASH_MSG"
				"${ed[@]}" git -C "$REPO" commit \
					|| die "commit aborted (empty message?) — the squash is staged, finish it in $REPO"
			fi
		else
			git_ commit -m "$msg" -m "Cbx-Box: $box" || die "nothing to commit"
		fi
	else
		"${ed[@]+"${ed[@]}"}" git -C "$REPO" merge --no-ff ${edit:+--edit} "$ref" \
			-m "$msg" -m "Cbx-Box: $box" \
			|| die "merge conflicts — resolve in $REPO, then 'git commit'"
	fi
	after="$(git_ rev-parse HEAD)"
	[ "$before" != "$after" ] || die "nothing was merged — $DEV is unchanged (already up to date?)"

	echo "cbx: $DEV is now $(git_ rev-parse --short HEAD)"
	git_ --no-pager log --oneline -1 | sed 's/^/  /'
	git_ --no-pager diff --shortstat "$before" "$after" | sed 's/^/  /'
	git_ update-ref -d "$ref"
	# .sent goes with it: the branch this box will push next is a new review from scratch.
	rm -f "$STATE/$box.reviewed" "$STATE/$box.sent"
	echo "cbx: dropped refs/agents/$box (merged)"
	# The agent is still sitting on the now-merged branch; move it onto the new dev so its next piece
	# of work starts from what you just landed.
	if say_to_box "$box" "Your work was merged into ${DEV}. Please run: git fetch hub && git rebase hub/${DEV} — then continue with the next task."; then
		echo "cbx: asked $box to rebase onto $DEV"
	else
		echo "cbx: (box $box not reachable — rebase it later with 'cbx rebase $box')"
	fi
	echo "cbx: NOT pushed yet — the merge is local to the hub. Run: cbx push"
}

drop() {
	[ $# -ge 1 ] || die "drop needs a box name"
	local box="$1"
	git_ update-ref -d "refs/agents/$box" 2>/dev/null || true
	# .sent goes with it: the branch this box will push next is a new review from scratch.
	rm -f "$STATE/$box.reviewed" "$STATE/$box.sent"
	say_to_box "$box" "I dropped your handoff — that approach is not going in. Do not re-push it; wait for new instructions." 2>/dev/null || true
	echo "cbx: dropped refs/agents/$box (the box still has the commits locally until it rebases)"
}

rebase() {
	[ $# -ge 1 ] || die "rebase needs a box name (or 'all')"
	local box list behind n=0 ok=0 force=""
	[ "${2:-}" = --force ] && force=--force
	if [ "$1" = all ]; then
		list="$(broker GET /box 2>/dev/null | jqr '.boxes[]?.box')"
		[ -n "$list" ] || die "no boxes exist — 'cbx ls' to check"
	else
		list="$1"
	fi

	echo "cbx: $DEV is at $(git_ rev-parse --short "$DEV") ($(git_ log -1 --format=%s "$DEV"))"
	for box in $list; do
		n=$((n + 1))
		# Skip, don't abort: with 'all' one working agent shouldn't stop the others being told.
		if ! guard_busy "$box" "$force"; then
			echo "  $box: skipped (busy) — 'cbx rebase $box --force' to interrupt anyway"
			continue
		fi
		# How far the agent's PUSHED branch trails the branch it's based on. A box that never handed
		# off has no ref here, which is normal — it just means we can't say how stale it is.
		if git_ rev-parse --verify -q "refs/agents/$box" >/dev/null; then
			behind="$(git_ rev-list --count "refs/agents/$box..$DEV" 2>/dev/null || echo '?')"
			behind="behind by $behind commit(s)"
		else
			behind="nothing pushed yet"
		fi
		if say_to_box "$box" "Please run: git fetch hub && git rebase hub/${DEV} — the ${DEV} branch has moved. Resolve any conflicts, then carry on."; then
			ok=$((ok + 1))
			echo "  $box: asked to rebase ($behind)"
		else
			echo "  $box: NOT reachable, skipped ($behind) — 'cbx box $box' to start it"
		fi
	done

	echo "cbx: delivered to $ok of $n box(es)."
	# The single most confusing thing about this command: nothing has rebased yet.
	echo "cbx: NOTE this is a prompt typed into each agent's session, not a rebase that already ran."
	echo "     Each agent runs 'git fetch hub && git rebase hub/$DEV' when it picks the message up,"
	echo "     which may be a while if it is mid-task, and it may hit conflicts and ask you about them."
	echo "     Watch one:  cbxbox <box>      Re-check later:  cbx q"
}

divergence() {
	# "<behind> <ahead>" of $DEV relative to origin/$DEV. Needs a fetch first to mean anything.
	git_ rev-list --left-right --count "origin/$DEV...$DEV" 2>/dev/null || echo "0 0"
}

pull() {
	# Bring the hub's branch up to date with origin. Needed whenever you (or anyone) pushed to the
	# branch elsewhere: the hub's merges then sit on an older base and `cbx push` is rejected.
	local mode="${1:-}" behind ahead
	echo "cbx: fetching origin"
	git_ fetch origin || die "fetch failed"
	read -r behind ahead <<< "$(divergence)"
	if [ "$behind" = 0 ]; then
		echo "cbx: $DEV is up to date with origin ($ahead local commit(s) to push)"
		return 0
	fi
	echo "cbx: origin has $behind commit(s) you don't; you have $ahead it doesn't"
	if [ "$ahead" = 0 ]; then
		git_ merge --ff-only "origin/$DEV" || die "fast-forward failed — resolve in $REPO"
		echo "cbx: fast-forwarded to $(git_ rev-parse --short HEAD)"
	elif [ "$mode" = --rebase ]; then
		git_ rebase "origin/$DEV" || die "rebase conflicts — resolve in $REPO, then 'git rebase --continue'"
		echo "cbx: rebased onto origin/$DEV ($(git_ rev-parse --short HEAD))"
	else
		git_ merge "origin/$DEV" -m "Merge origin/$DEV" \
			|| die "merge conflicts — resolve in $REPO, then 'git commit'"
		echo "cbx: merged origin/$DEV ($(git_ rev-parse --short HEAD))"
	fi
	echo "cbx: agents are now behind — 'cbx rebase all' after you push."
}

push() {
	local ahead behind yes="" a reply
	for a in "$@"; do
		case "$a" in
			-y|--yes) yes=1 ;;
			*) die "push: unknown option '$a' (-y | --yes)" ;;
		esac
	done
	read -r behind ahead <<< "$(divergence)"
	[ "$behind" = 0 ] || die "origin has $behind commit(s) $DEV doesn't — run 'cbx pull' (or 'cbx pull --rebase') first"
	# Don't report "pushed" when there was nothing to push — that reads as "my merge went out" when
	# in fact nothing was ever merged (a silent `cbx merge` failure looks exactly like this).
	if [ "$ahead" = 0 ]; then
		echo "cbx: nothing to push — $DEV already matches origin ($(git_ rev-parse --short "$DEV"))."
		echo "cbx: expecting an agent's work here? It is merged only after 'cbx merge <box>' succeeds — check 'cbx q'."
		return 0
	fi
	# Show exactly what leaves the hub before it leaves. A push is the one irreversible step in the
	# loop (agents' work is public from here on), and it is easy to have merged more than you meant —
	# so the per-commit --stat is the last chance to notice a stray file or a second box's work.
	echo "cbx: $ahead commit(s) would go to origin/$DEV:"
	# `|| true`: quitting the pager early SIGPIPEs git, and pipefail would otherwise abort the push
	# right there — pressing 'q' must mean "seen enough", not "cancelled".
	git_ log --stat --oneline "origin/$DEV..$DEV" | review_pager || true
	# Only ask when someone is there to answer: piped/cron use keeps the old non-interactive behaviour.
	if [ -z "$yes" ] && [ -t 0 ] && [ -t 1 ]; then
		read -r -p "cbx: push these $ahead commit(s) to origin/$DEV? [y/N] " reply
		case "$reply" in
			y|Y|yes|YES) ;;
			*) echo "cbx: not pushed ($DEV is unchanged; nothing was sent)"; return 1 ;;
		esac
	fi
	echo "cbx: pushing $DEV ($ahead commit(s) ahead of origin) -> $(git_ remote get-url origin)"
	if git_ push origin "$DEV"; then
		echo "cbx: pushed $DEV to origin"
	else
		# The three things that actually go wrong here, in the order they're worth checking.
		echo "cbx: push FAILED. Usual causes:" >&2
		echo "  * the deploy key is read-only — GitHub: Settings -> Deploy keys -> 'Allow write access'" >&2
		echo "  * no key offered ('Permission denied (publickey)') — check the identity dir matches the" >&2
		echo "    hub user's HOME: ls -l \$HOME/.gitidentity, and that git-identity/gitconfig has no" >&2
		echo "    stale core.sshCommand pointing at another home" >&2
		echo "  * a branch ruleset protects $DEV — the key is not in the bypass list" >&2
		exit 1
	fi
}

# ------------------------------------------------------------------ goldens

golden_ls() {
	local resp g prov
	resp="$(broker GET /golden)" || die "broker unreachable: $resp"
	echo "current: $(printf '%s' "$resp" | jqr '.current')"
	for g in $(printf '%s' "$resp" | jqr '.goldens[]?.golden'); do
		# Provenance is stored INSIDE .git (not as a file in the tree), so it never shows up as an
		# untracked file in every agent's `git status`.
		prov="$(cat "$GOLDEN/$g/.git/cbx-golden" 2>/dev/null | tr '\n' ' ')"
		printf '  %-22s %s\n' "$g" "${prov:-(no provenance recorded)}"
		printf '%s' "$resp" | jq -r --arg g "$g" '.goldens[]? | select(.golden==$g) | "      \(if .current then "current  " else "" end)boxes: \(if (.boxes|length)>0 then (.boxes|join(",")) else "-" end)"' 2>/dev/null
	done
}

golden_seal() {
	# Finish a golden you staged and then fixed up by hand (e.g. after a failed --prep). Same tail as
	# snapshot: seal, move every box onto it, drop the ones nothing references any more.
	[ $# -ge 1 ] || die "seal needs a staged golden id (see $STAGING)"
	[ -d "$STAGING/$1" ] || die "no staged golden at $STAGING/$1"
	broker POST "/golden/seal/$1" >/dev/null || die "sealing $1 failed"
	echo "cbx: sealed $1 as current"
	broker POST "/recreate?fresh=1" >/dev/null || die "recreate failed"
	golden_reap
}

golden_reap() {
	local resp
	resp="$(broker POST /golden/reap)" || die "reap failed: $resp"
	echo "cbx: reaped: $(printf '%s' "$resp" | jqr '.reaped | join(", ") // "(none)"')"
}

golden_snapshot() {
	# Freeze THIS repo — exactly as you have it set up — as the base every box overlays.
	#
	# The snapshot is taken from, and mounted back at, the SAME absolute path ($REPO is also the box's
	# checkout path). So anything with baked-in absolute paths — npm's node_modules/.bin shebangs and
	# .package-lock.json, a project-local .gradle cache, a python venv — keeps working inside the box.
	# That is also why nothing is built in the staging copy: a build there would record the staging
	# path and be wrong everywhere. Run `--prep` (or your own commands) HERE, then snapshot.
	#
	# We can't skip the copy and point the boxes' lowerdir straight at $REPO: overlayfs requires the
	# lower layer to be immutable while boxes are mounted on it, and you keep editing this tree.
	local id st prep=0 boxes box dirty svc
	[ "${1:-}" = --prep ] && prep=1

	# A build running in the hub's tmux writes into $REPO while we copy it — the snapshot would be a
	# torn mixture of before and after. Cheap to avoid, miserable to debug. Any service whose manifest
	# sets writes_repo=true counts (this replaced the hard-coded backend/frontend list).
	for svc in $(svc_names); do
		svc_load "$svc" || continue
		svc_truthy "$SVC_WRITES_REPO" || continue
		if svc_running "$svc"; then
			die "'$svc' is running and writing into $REPO — 'cbx down $svc' first, then snapshot"
		fi
	done

	if [ "$prep" = 1 ]; then
		echo "cbx: preparing the repo (${GOLDEN_PREP_CMD})"
		( cd "$REPO" && bash -lc "$GOLDEN_PREP_CMD" ) || die "prep failed — fix it in $REPO and re-run"
	fi

	# Recreating the boxes discards their upper layers, so anything not committed AND pushed is lost.
	# Refuse rather than eat it — this is the one destructive step in the whole workflow.
	boxes="$(broker GET /box 2>/dev/null | jqr '.boxes[]?.box')"
	for box in $boxes; do
		dirty="$(broker GET "/box/$box/dirty" 2>/dev/null | jqr '.dirty[]?' | head -5)"
		if [ -n "$dirty" ]; then
			echo "cbx: box '$box' has uncommitted changes:" >&2
			printf '  %s\n' $dirty >&2
			die "commit + handoff in that box first (or 'cbx kill $box' to abandon it)"
		fi
	done

	# Whatever is dirty here gets baked in and becomes every agent's starting `git status`. That's the
	# deal — it's how your local setup reaches the boxes — but it should never be a surprise, and
	# modified TRACKED files are the ones an agent can sweep into a commit by accident.
	if [ -n "$(git_ status --porcelain)" ]; then
		echo "cbx: baking these local changes into the golden — every box will start with them:"
		git_ status --short | sed 's/^/  /'
	fi

	id="g-$(date +%Y%m%d-%H%M%S)"
	st="$STAGING/$id"
	mkdir -p "$STAGING"
	rm -rf "$st"
	echo "cbx: snapshotting $REPO -> staging/$id (reflink)"
	cp --reflink=auto -a "$REPO/." "$st" || die "snapshot copy failed"

	# The boxes reach the hub repo over the cbx network; bake that in so a box's git works immediately.
	git -C "$st" remote remove hub 2>/dev/null || true
	git -C "$st" remote add hub "${HUB_GIT_URL:-git://hub/repo}"
	# Hub-only bits that have no business in a box: the push-restriction hook (nothing pushes into a
	# box) and the review state. Provenance goes inside .git so it can never appear as an untracked
	# file in every agent's `git status`.
	rm -f  "$st/.git/hooks/update"
	rm -rf "$st/.git/cbx"
	printf '%s from %s (%s) at %s\n' "$id" "$(git_ rev-parse --short HEAD)" "$DEV" "$(date -Is)" \
		> "$st/.git/cbx-golden"

	# The hub mounts $GOLDEN read-only on purpose, so the broker performs the move + symlink flip.
	broker POST "/golden/seal/$id" >/dev/null \
		|| die "sealing $id failed (staged tree kept — retry with: cbx golden seal $id)"
	echo "cbx: sealed $id as current"

	echo "cbx: moving every box onto it (fresh upper layers)..."
	broker POST "/recreate?fresh=1" >/dev/null || die "recreate failed"
	golden_reap
	echo "cbx: done. Boxes are on $id and back on their pushed branches."
}

# ------------------------------------------------------------------ patch bridge (laptop <-> hub)

# The two halves of moving a changeset between the hub and your laptop checkout as PLAIN PATCHES —
# not git transport. Patches apply by context, so neither side has to share the other's exact base
# sha; the laptop's `dev` can be anywhere. STDOUT/STDIN are the payload here, so every diagnostic in
# these two goes to STDERR (via die / >&2) and nothing else is printed — the stream stays clean for a
# pipe. The laptop aliases (cbxexport / cbximport) drive both without a PTY, which would corrupt bytes.

export_patch() {
	# The agent's whole branch, squashed to ONE commit, streamed as an mbox on STDOUT. `git am` on the
	# laptop replays it as a single commit carrying the handoff summary. We assemble the squash with
	# commit-tree so NOTHING here is touched — no ref, no worktree, no index — and re-running is a no-op.
	[ $# -ge 1 ] || die "export needs a box name"
	local box="$1" ref tip base tree msg squash
	ref="refs/agents/$box"
	git_ rev-parse --verify -q "$ref" >/dev/null || die "no branch pushed for '$box' (has it run handoff?)"
	tip="$(git_ rev-parse "$ref")"
	base="$(git_ merge-base "$DEV" "$ref")" || die "no common base between $DEV and $ref"
	tree="$(git_ rev-parse "$ref^{tree}")"
	# A branch whose tree equals its base's tree is all no-op commits — there is no diff to send.
	[ "$(git_ rev-parse "$base^{tree}")" != "$tree" ] || die "'$box' has no net change against $DEV — nothing to export"
	msg="$(note_of "$box")"; msg="${msg:-work from agent box $box}"
	squash="$(printf '%s\n\nCbx-Box: %s\nCbx-Src: %s\n' "$msg" "$box" "$tip" | git_ commit-tree "$tree" -p "$base")" \
		|| die "could not assemble the squashed commit (is a git identity configured on the hub?)"
	# -1 emits just this commit; its parent is $base, so the patch IS the branch's net diff. --binary so
	# binary files survive git am on the far end.
	git_ format-patch --stdout --binary -1 "$squash"
}

import_patch() {
	# Replace refs/agents/<box> with a patch read from STDIN (your `git format-patch` mbox), then tell
	# the box its old edits were superseded — to NOTE it, not redo it. We `git am` the patch in a throwaway
	# detached worktree based on $DEV so the hub's own checkout (often dirty) is never touched.
	[ $# -ge 1 ] || die "import needs a box name"
	local box="$1" ref pf wt new
	ref="refs/agents/$box"
	pf="$(mktemp "${TMPDIR:-/tmp}/cbx-import-XXXXXX.mbox")"
	cat > "$pf"
	[ -s "$pf" ] || { rm -f "$pf"; die "no patch on STDIN — pipe a 'git format-patch' mbox in (see cbximport)"; }
	wt="$(mktemp -u "${TMPDIR:-/tmp}/cbx-import-wt-XXXXXX")"
	git_ worktree add -q --detach "$wt" "$DEV" || { rm -f "$pf"; die "could not create a temporary worktree"; }
	if ! git -C "$wt" am --3way "$pf" >&2; then
		git -C "$wt" am --abort >/dev/null 2>&1 || true
		git_ worktree remove --force "$wt" >/dev/null 2>&1 || true
		rm -f "$pf"
		die "your patch did not apply onto $DEV — is your laptop checkout based on the same history? (try 'cbx pull' first)"
	fi
	new="$(git -C "$wt" rev-parse HEAD)"
	git_ worktree remove --force "$wt" >/dev/null 2>&1 || true
	rm -f "$pf"
	[ "$new" != "$(git_ rev-parse "$DEV")" ] || die "the patch added nothing on top of $DEV — refs/agents/$box left unchanged"

	git_ update-ref "$ref" "$new"
	# It is YOUR vetted commit, so record it as already reviewed — 'cbx status' then offers merge directly.
	mkdir -p "$STATE"
	printf '%s %s' "$new" "$(git_ rev-parse "$DEV")" > "$STATE/$box.reviewed"
	echo "cbx: refs/agents/$box now points at your commit $(git_ rev-parse --short "$new") ($(git_ rev-list --count "$DEV..$ref") on top of $DEV)." >&2
	echo "cbx: next — 'cbx merge $box' to land it on $DEV (or push from your laptop as usual)." >&2

	# FYI to the box, exactly like drop/merge: unconditional (the point is to stop it re-pushing its old
	# version), and it must NOT act. The box fetches refs/agents/* as refs/remotes/hub-agents/*.
	if say_to_box "$box" "Heads up: I replaced the changes on your branch (agent/$box) with my own commit. Sync your local branch to it with: git fetch hub && git reset --hard hub-agents/$box . This is FYI ONLY — just NOTE that your earlier edits were superseded by my version; do NOT re-apply your previous work or take any action on this. Wait for new instructions."; then
		echo "cbx: told $box to reset onto your commit and just note it." >&2
	else
		echo "cbx: (box $box not reachable — it will pick up your commit next time it fetches: git reset --hard hub-agents/$box)" >&2
	fi
}

cmd="${1:-}"; shift || true
case "$cmd" in
	up)     [ $# -ge 1 ] || die "up needs a service (cbx svcs to list)"; svc_up "$1" ;;
	down)   [ $# -ge 1 ] || die "down needs a service (cbx svcs to list)"; svc_down "$1" ;;
	logs)   [ $# -ge 1 ] || die "logs needs a service (cbx svcs to list)"; svc_logs "$1" ;;
	svcs|services) svc_list ;;
	autostart)     svc_autostart ;;
	box)      box_new "$@" ;;
	kill)     box_kill "$@" ;;
	recreate) box_recreate "$@" ;;
	ls)       box_ls ;;
	forwards) forwards_refresh "${1:-}" ;;
	# Default is the LIVE dashboard; --text (or a non-terminal stdout, i.e. a pipe) gives the plain
	# one-shot table, so `cbx q | grep …` and scripts behave as they always did.
	q|queue)
		case "${1:-}" in
			--text|--once|-1) queue ;;
			*) watch_queue "$@" ;;   # falls back to the one-shot table when stdout is not a terminal
		esac ;;
	# Colour auto-detects here: `cbx status | less` or a redirect gets plain text, a terminal gets the
	# same rendering as the live dashboard. CBX_COLOR=always|never overrides.
	status|st) colors_init; status_overview ;;
	review)   review "$@" ;;
	fix)      fix "$@" ;;
	prereview) prereview "$@" ;;
	merge)    merge "$@" ;;
	drop)     drop "$@" ;;
	rebase)   rebase "$@" ;;
	export)   export_patch "$@" ;;
	import)   import_patch "$@" ;;
	pull)     pull "$@" ;;
	push)     push "$@" ;;
	golden)
		sub="${1:-}"; shift || true
		case "$sub" in
			snapshot) golden_snapshot "$@" ;;
			seal)     golden_seal "$@" ;;
			ls)       golden_ls ;;
			reap)     golden_reap ;;
			*) die "golden needs: snapshot [--prep] | seal <id> | ls | reap" ;;
		esac ;;
	*) sed -n '4,52p' "$0" | sed 's/^# \?//'; exit 1 ;;
esac
