#!/bin/bash
set -euo pipefail

# muster — hub-side control CLI. Three jobs:
#   * start/stop the on-demand dev services in the hub's tmux (declared in hub-services/, e.g. backend)
#   * spawn/kill/list agent boxes via the box-broker (the hub itself never touches the docker socket)
#   * THE REVIEW QUEUE: each agent works on its own branch (agent/<box>) in an overlay of a shared
#     prepared "golden" checkout and pushes to refs/agents/<box> here; you review and merge into dev.
#
# Usage:
#   $SELF svcs | services                     # list dev services (declared in hub-services/) + state
#   $SELF ready <service>                     # is it USABLE? runs the manifest's ready= probe,
#                                             #   with timing — 'up' only means it is running
#   $SELF up   <service>                      # start a service in its tmux window
#   $SELF down <service>                      # stop it
#   $SELF logs <service>|gitd                 # attach that service window (Ctrl-b d to detach)
#   $SELF logs <service> --tail [N]         #   …or PRINT the captured output instead of attaching —
#   $SELF logs <service> --file             #   what you want when it FAILED to start (a pane you
#                                           #   cannot scroll is no help), or its path
#   $SELF autostart                           # start every service whose manifest sets autostart=true
#   $SELF box  [name]                         # spawn an agent box (own branch, overlay checkout);
#                                             # a name that is already up just reattaches to it
#   $SELF kill <name>                         # remove an agent box (its upper layer is kept)
#   $SELF purge <name> [--force]              # …and remove it FOR GOOD: upper layer, caches, session.
#                                           #   Refuses while its handoff is still unreviewed.
#   $SELF recreate <name>|all [--fresh]       # pull newest image + respawn (--fresh = discard upper)
#   $SELF ls                                  # list services + boxes (broker)
#   $SELF forwards [box]                      # re-establish the hub-loopback socat forwards
#
#   $SELF status | st                         # what can be merged / rebased / pushed, with commands
#   $SELF q | queue [-n SECS] [--no-bell]     # LIVE dashboard: queue + status in one repainted screen,
#                                           #   and your terminal BELLS when an agent stops working
#                                           #   or a new handoff lands. 'q'/Ctrl-C quits, Enter refreshes
#   $SELF q  --text                           # the queue table once, as plain text (for pipes/scripts)
#                                           #   colour: MUSTER_COLOR=always|never|auto (auto = '$SELF status'
#                                           #   colours a terminal only; the live dashboard always does)
#   $SELF review <box> [--full] [--net]       # open the review TUI (tuicr) on the agent's branch: leave
#                                           #   line comments, quit, CONFIRM, and they are sent to the
#                                           #   box — no retyping them into `$SELF fix`. Nothing is sent
#                                           #   until you answer 's' at the prompt.
#              [--tui] [--plain]            #   --plain = the old delta/less pager (also used when no
#                                           #   TUI is installed, for --net, and for a RE-review, whose
#                                           #   range-diff a TUI cannot show); --tui forces the TUI.
#                                           #   --full = whole branch, --net = one combined diff.
#                                           #   MUSTER_REVIEW_TUI picks a different TUI (empty = never one)
#   $SELF fix    <box> -m "..."               # send review feedback into that box's claude session
#   $SELF prereview <box>                     # ask the agent to self-review its diff before you look
#   $SELF say    <box> "..."                  # say something into that box's claude, no review framing
#   $SELF peek   <box> [--snap] [--full]      # SEE what that agent sees: a screenshot of ITS browser tab
#             [-o FILE]                     #   --snap = the accessibility tree instead (what it reads)
#                                           #   --full = the whole scrollable page
#   $SELF point  <box> [--selector CSS]       # same, with pinchtab's labelled overlay drawn on first —
#             [--clear] [-o FILE]           #   the refs in the image are that agent's own, so you can
#                                           #   then say "e5 is the misaligned one". --clear removes it
#   $SELF hold   <box> [--reason "..."]       # PAUSE that box's browser tab so you can drive it into the
#             [--timeout SECS]              #   state you want it to work on; its actions get a 409
#   $SELF release <box>                       # let it browse again (and tell it the page moved)
#   $SELF merge  <box> [--squash] [--edit]    # merge the agent branch into dev
#                                           #   --squash = one commit, --edit = reword it yourself
#                                           #   (--edit on a 1-commit branch: no merge commit)
#             [--reword|-r]                 #   KEEP every commit and rewrite each MESSAGE, in a little
#                                           #   editor loop: lists the commits, [n] edits one, [a] all,
#                                           #   [d<n>] shows its diff, [r<n>] reverts to the agent's
#                                           #   wording, [m] merges. Nothing is rewritten until you
#                                           #   confirm, and your edits survive quitting. Trees and
#                                           #   authors are untouched — only the messages change.
#             [--undo]                      #   put $DEV back and the branch back in the queue (only
#                                           #   while the merge is still the tip and unpushed)
#             [--landed]                    #   the merge CONFLICTED and you finished it by hand: retire
#                                           #   the branch + tell the box, without merging again. Only
#                                           #   needed when your fix was a squash/hand-written commit —
#                                           #   if the agent's commits ended up in dev, plain `$SELF merge`
#                                           #   detects it and closes out by itself.
#   $SELF drop   <box>                        # discard an agent branch (tells the box)
#   $SELF rebase <box>|all [--force]          # move agents onto the current dev (light; no recreate)
#
#   $SELF minto <branch>                      # merge dev INTO another branch (staging, a release branch).
#                                           #   A fast-forward, or a merge computed in the OBJECT STORE:
#                                           #   the hub's own checkout never moves either way. On a
#                                           #   CONFLICT it asks what the branch is for, then offers:
#             [--box] [--here]              #   --box  = spawn an agent that opens on the conflicted
#                                           #            tree with BOTH branches and both histories
#                                           #   --here = a linked worktree under .git/cbx/wt you resolve
#             [--intent "..."]              #   what the branch is FOR ("integration for staging") —
#                                           #   remembered per branch, and handed to the agent
#             --land <box>                  #   take the agent's resolved merge, move the branch onto it
#             --landed                      #   you finished the --here worktree: verify + tear it down
#             --abort                       #   drop whatever minto has open for that branch
#             --pull                        #   fast-forward the branch to origin first
#
#   $SELF export <box>                        # the agent's work, SQUASHED, as one mbox patch on STDOUT
#                                           #   (laptop: `<prefix>export <box>` pipes it into a local git am)
#   $SELF import <box>                        # read a patch on STDIN, REPLACE the agent's branch with it,
#                                           #   and tell the box to note it — not act (laptop: <prefix>import)
#
# Commands that TYPE into an agent's session (fix / prereview / rebase) refuse while that agent is
# working — `$SELF ls` and `$SELF status` show busy | waiting | idle per box. Add --force to interrupt.
#   $SELF pull [--rebase]                     # bring dev up to date with origin (merge by default)
#   $SELF push [-y]                           # push dev to the real origin (shows a --stat preview and
#                                           #   asks first; -y skips BOTH the preview and the question)
#
#   $SELF golden snapshot [--prep]            # freeze the repo as the new base + move every box onto it
#   $SELF golden seal <id>                    # finish a staged golden you fixed up by hand
#   $SELF golden ls | reap                    # list snapshots / delete unreferenced ones
#   $SELF golden retire <id>                  # free one that boxes are still on: move them onto the
#                                           #   current golden, or purge them, then reap
#
# What the hub and the boxes MOUNT is project set-up, not a runtime knob: it lives in the stack's
# root-owned `mounts` table (one row per path, a mode for each side), edited on the host and applied
# with `./gen-hub-mounts.sh && docker compose up -d hub && $SELF recreate all`. See mounts.example.
#
# The repo lives at the SAME absolute path here and inside every box (/home/dev/repo), because
# installed dependencies bake absolute paths in — npm into node_modules/.bin shebangs, gradle into
# the project-local .gradle cache. So whatever you set up here works unchanged in an agent's box.

# What this run was invoked AS. The hub symlinks /usr/local/bin/$MUSTER_PREFIX to this binary (see
# hub/entrypoint.sh), so the same code answers to `muster`, to your stack's prefix, and to whatever a
# second stack chose. Every hint below is printed with $SELF so a copied command names the binary you
# actually have, not the one this file happens to be called.
#
# MUSTER_SELF overrides it. The laptop aliases invoke `muster` (always present) rather than the
# prefix (a symlink, and only there once MUSTER_PREFIX has reached the container), and pass the name
# you typed in this variable — so `cbx q` still prints hints that say `cbx`, without the working
# command depending on a symlink someone has to deploy first.
SELF="${MUSTER_SELF:-${0##*/}}"

# Which muster this hub image is. Baked in by the Dockerfile; "unknown" for a hand-built image. The
# broker and the box image carry the same stamp, and version_drift() below compares all three —
# see `$SELF status`.
MUSTER_VERSION="${MUSTER_VERSION:-unknown}"

REPO="${CHECKOUT:-/home/dev/repo}"
DEV="${DEV_BRANCH:-dev}"
GOLDEN="${GOLDEN_DIR:-/work/golden}"
STAGING="${GOLDEN_STAGING:-/work/golden-staging}"
STATE="$REPO/.git/cbx"
TMUX_SESSION="${TMUX_SESSION:-services}"
BROKER_URL="${BROKER_URL:-http://box-broker:8099}"
BROKER_TOKEN="${BROKER_TOKEN:-}"

# The interactive review TUI `$SELF review` opens on an agent's branch. Default: tuicr (tuicr.dev),
# installed into this image by common-setup.sh — scroll the diff, leave line/range comments, quit, and
# muster offers to send them to the box (see review_tui / review_send).
#
#   MUSTER_REVIEW_TUI unset      -> tuicr if it is on PATH, else the plain delta/less pager
#   MUSTER_REVIEW_TUI=           -> never a TUI; always the pager (same as passing --plain every time)
#   MUSTER_REVIEW_TUI='cmd …'    -> that command instead. The commit range is substituted for a {range}
#                                placeholder, or appended when there is none:
#                                  MUSTER_REVIEW_TUI='hunk'                -> hunk dev..refs/agents/work1
#                                  MUSTER_REVIEW_TUI='delta --paging=always {range}'
#                                Only tuicr's comments can be harvested and sent to the box — any other
#                                command is a viewer, and muster just falls back to `$SELF fix -m` after it.
# `-` is accepted as a synonym for empty, since an empty value is easy to lose through a wrapper.
# The placeholder is held in its own variable and NEVER written inline in a ${…}: the '}' of
# '{range}' would close the parameter expansion early, so `${MUSTER_REVIEW_TUI-tuicr -r {range}}` silently
# means "…-tuicr -r {range" followed by a literal '}' — which appends a stray brace to whatever the
# user set (and only looks right when the variable is unset).
REVIEW_TUI_PLACEHOLDER='{range}'
# --no-update-check: tuicr phones GitHub for a newer release at startup. Here the version is pinned by
# the image (common-setup.sh), so an update notice would only be a slower start and advice you cannot act on.
REVIEW_TUI_DEFAULT="tuicr --no-update-check -r $REVIEW_TUI_PLACEHOLDER"
REVIEW_TUI="${MUSTER_REVIEW_TUI-$REVIEW_TUI_DEFAULT}"
# `if`, not `[ … ] && …`: under `set -e` a bare test that FAILS becomes the script's exit status, so
# the common case (a value that isn't '-') would kill muster right here. Same reason for the guards below.
if [ "$REVIEW_TUI" = "-" ]; then REVIEW_TUI=""; fi

# Your project's "make this tree ready to build" command. `$SELF golden snapshot --prep` runs it IN THE
# REPO (not in a copy), so it's an optional convenience around the setup you'd otherwise do by hand —
# and whatever it installs is captured at the path it will actually be used from. Empty by default:
# muster knows nothing about your build — set GOLDEN_PREP_CMD in the stack's .env.
GOLDEN_PREP_CMD="${GOLDEN_PREP_CMD:-}"

# Dev services are declared as MANIFESTS — one file per service in this directory (bind-mounted from
# the stack's hub-services/, so a service can be added or edited by a file sync, no image rebuild).
# See svc_load() for the format. Nothing here parses the command: it is handed VERBATIM to `bash -lc`
# in a tmux window at `$SELF up` time, INSIDE the container, so relative paths resolve against the repo
# and shell substitutions ($(…), $VAR) are evaluated then — which is how the backend's aspectj
# `-javaagent:$(find …)` gets a path nobody knows until after the build.
HUB_SERVICES_DIR="${HUB_SERVICES_DIR:-/work/hub-services}"
# Manifests muster itself SHIPS, in the image (hub/services/*). pinchtab lives here rather than in
# hub-services.example because it is not an example: the browser is how an agent checks that what it
# built works, and a stack that silently has no browser is a stack where agents verify against
# fixtures. A file of the same name in HUB_SERVICES_DIR wins, so a project can still change or
# disable one.
HUB_SERVICES_BUILTIN="${HUB_SERVICES_BUILTIN:-/opt/muster/hub-services}"

die() { echo "$SELF: $*" >&2; exit 1; }

# FLAGS WHEREVER YOU TYPED THEM. `merge --squash mybox` and `merge mybox --squash` are the same
# command, and having to remember which one a given subcommand wanted is a papercut you hit at the
# worst moment — mid-review, with a name you just tab-completed.
#
# It reorders rather than parses: positionals first, then the flags in the order they were given, so
# every command below keeps its own `local box="$1"; shift; for a in "$@"` parsing unchanged and there
# is exactly one place that knows about argument order.
#
#   argsort "<flags-that-take-a-value>" "$@"   # a flag suffixed with ? takes one only if it is a number
#   set -- ${ARGV[@]+"${ARGV[@]}"}             # the +"" form: an empty array under `set -u` is an error
#
# `--` ends the flags: everything after it is positional, verbatim, for the commands that hand a tail
# to git.
argsort() {
	local spec=" $1 "; shift
	local a pos=() opt=()
	while [ $# -gt 0 ]; do
		a="$1"; shift
		case "$a" in
			--) while [ $# -gt 0 ]; do pos+=("$1"); shift; done ;;
			-*)
				opt+=("$a")
				case "$spec" in
					*" $a "*)  [ $# -gt 0 ] && { opt+=("$1"); shift; } ;;
					# An OPTIONAL value (--tail [N]): consume the next argument only when it is a
					# number, or `logs web --tail` would swallow a box name that is not there.
					*" $a? "*) case "${1:-}" in ''|*[!0-9]*) ;; *) opt+=("$1"); shift ;; esac ;;
				esac ;;
			*) pos+=("$a") ;;
		esac
	done
	ARGV=(${pos[@]+"${pos[@]}"} ${opt[@]+"${opt[@]}"})
}

# THE HEADER BLOCK AT THE TOP OF THIS FILE IS THE HELP. Printed from the comments themselves, so the
# usage cannot drift from the file you are reading — an earlier version sliced it with a hard-coded
# line range and silently stopped covering new commands as they were added. $SELF is substituted by
# awk because comments expand nothing: the listing then names whichever symlink you invoked.
usage() {
	awk -v self="$SELF" 'NR < 4 { next }
	     /^#/ { sub(/^# ?/, ""); gsub(/\$SELF/, self); print; next }
	     { exit }' "$0"
}
git_() { git -C "$REPO" "$@"; }

# ---- agent activity -------------------------------------------------------------------------
# Each box's claude writes "<state> <epoch>" to $HOME/.cbx-state via the muster-activity hooks (the
# broker registers them in the shared ~/.claude/settings.json). That file is the box's home anchor,
# mounted here read-only — so this is a plain file read, no broker round-trip.
BOXES="${BOXES_DIR:-/work/boxes}"
# A 'busy' older than this is reported as 'stale': the hooks stopped firing (claude was killed, the
# box was recreated, hooks aren't installed). Treated as NOT busy, so a stale file can never wedge
# the workflow — the failure mode of this feature is "no protection", never "can't work".
ACTIVITY_STALE="${MUSTER_ACTIVITY_STALE:-900}"

# Prints "<state> <age-seconds>"; state is busy | waiting | idle | stale | unknown.
box_activity() {
	local f="$BOXES/$1/home/.cbx-state" st ts age
	[ -r "$f" ] || { echo "unknown -"; return 0; }
	read -r st ts < "$f" 2>/dev/null || { echo "unknown -"; return 0; }
	case "$ts" in ''|*[!0-9]*) echo "unknown -"; return 0 ;; esac
	age=$(( $(date +%s) - ts ))
	[ "$st" = busy ] && [ "$age" -gt "$ACTIVITY_STALE" ] && st=stale
	echo "$st $age"
}

# Refuse to interrupt a working agent. 'waiting' is NOT guarded: claude is asking YOU something, so
# typing at it is the point. Returns non-zero when the caller should skip this box.
guard_busy() {
	local box="$1" force="${2:-}" st age
	read -r st age <<< "$(box_activity "$box")"
	if [ "$st" = busy ] && [ "$force" != --force ]; then
		echo "$SELF: $box is BUSY (working for ${age}s) — not interrupting it." >&2
		echo "$SELF: your text would land in its input mid-task. Wait for idle ('$SELF status'), or --force." >&2
		return 1
	fi
	return 0
}
# ---- terminal presentation ------------------------------------------------------------------
# Colour is decided ONCE, by colors_init, from $MUSTER_COLOR (auto|always|never) — never by a `[ -t 1 ]`
# test at print time. `$SELF q` renders a whole frame inside "$(status_overview)", where stdout is a
# pipe, so a print-time auto-detect would silently strip every attribute from the live dashboard.
C_RESET=; C_B=; C_DIM=; C_RED=; C_GRN=; C_YEL=; C_BLU=; C_MAG=; C_CYA=

colors_init() {
	local mode="${1:-${MUSTER_COLOR:-auto}}"
	case "$mode" in
		never|off|0) mode=off ;;
		always|on|1) mode=on ;;
		*) if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then mode=on; else mode=off; fi ;;
	esac
	if [ "$mode" = on ]; then
		C_RESET=$'\033[0m'; C_B=$'\033[1m'; C_DIM=$'\033[2m'
		C_RED=$'\033[31m'; C_GRN=$'\033[32m'; C_YEL=$'\033[33m'
		C_BLU=$'\033[34m'; C_MAG=$'\033[35m'; C_CYA=$'\033[36m'
	else
		C_RESET=; C_B=; C_DIM=; C_RED=; C_GRN=; C_YEL=; C_BLU=; C_MAG=; C_CYA=
	fi
}

# A section title plus a rule to the right margin, so the screen reads as bands instead of a wall of
# text. The rule is built with a parameter expansion, not `tr`: tr is byte-oriented and would emit
# the first byte of a multi-byte box-drawing char once per column.
hdr() {
	local n bar
	n=$(( $(term_cols) - ${#1} - 4 ))
	[ "$n" -ge 2 ] || n=2
	printf -v bar '%*s' "$n" ''
	printf '%s── %s %s%s\n' "$C_B$C_BLU" "$1" "${bar// /─}" "$C_RESET"
}

# Pad THEN colour: escape sequences are zero-width but printf's %-*s counts them, so colouring first
# would shorten every padded cell by the length of its attribute string and skew the whole table.
cell() { printf '%s%-*s%s' "$1" "$2" "$3" "$C_RESET"; }

# How wide we may draw. $MUSTER_COLS is set by the watch loop (where stdout IS a terminal); everywhere
# else we ask tput and fall back to a sane 100 rather than wrapping a table nobody can read.
term_cols() {
	local c="${MUSTER_COLS:-}"
	[ -n "$c" ] || c="$(tput cols 2>/dev/null || true)"
	case "$c" in ''|*[!0-9]*) c=100 ;; esac
	[ "$c" -ge 60 ] || c=100
	printf '%s' "$c"
}

# 20011s is not a duration anyone reads — 5h33m is. Keeps two significant units, never wider than 6.
human_age() {
	local s="${1:-}"
	case "$s" in ''|*[!0-9]*) printf '%s' "${s:--}"; return 0 ;; esac
	if   [ "$s" -lt 60 ];    then printf '%ds' "$s"
	elif [ "$s" -lt 3600 ];  then printf '%dm%02ds' "$((s / 60))" "$((s % 60))"
	elif [ "$s" -lt 86400 ]; then printf '%dh%02dm' "$((s / 3600))" "$((s % 3600 / 60))"
	else printf '%dd%02dh' "$((s / 86400))" "$((s % 86400 / 3600))"; fi
}

trunc() {
	local w="$1" t="$2"
	[ "$w" -ge 8 ] || w=8
	if [ "${#t}" -le "$w" ]; then printf '%s' "$t"; else printf '%s…' "${t:0:$((w - 1))}"; fi
}

# Colour by what the state MEANS to you: yellow = the machine is working (leave it alone), magenta =
# it is blocked on you, green = free, red = something is wrong.
act_color() {
	case "$1" in
		busy)    printf '%s' "$C_YEL" ;;
		waiting) printf '%s' "$C_B$C_MAG" ;;
		idle)    printf '%s' "$C_GRN" ;;
		stale)   printf '%s' "$C_RED" ;;
		*)       printf '%s' "$C_DIM" ;;
	esac
}

# Same idea for the review queue: green/magenta = your move, cyan = ready to land, dim = done.
q_color() {
	case "$1" in
		merged)    printf '%s' "$C_B$C_CYA" ;;
		new)       printf '%s' "$C_B$C_MAG" ;;
		re-review) printf '%s' "$C_YEL" ;;
		reviewed)  printf '%s' "$C_B$C_GRN" ;;
		rebased)   printf '%s' "$C_CYA" ;;
		*)         printf '%s' "$C_DIM" ;;
	esac
}

have_delta() { command -v delta >/dev/null 2>&1; }

# One pager for a whole review (commits + notes + diff), so nothing gets painted over. delta renders
# the diff hunks and passes other lines through, which is why the log can share the stream. Falls
# back to less, and to cat when the output isn't a terminal (piping `$SELF review` somewhere).
review_pager() {
	if [ ! -t 1 ]; then cat
	elif have_delta; then delta --paging=always
	else less -R
	fi
}

# ------------------------------------------------------------------ services
#
# A service is one manifest file in $HUB_SERVICES_DIR (or the built-in set muster ships, which the
# stack's own dir overrides by filename); the FILENAME is the service name. Fields are
# `key=value`, one per line, '#' comments and blanks ignored:
#   command      (required) the shell run in a tmux window via `bash -lc`. Everything after the first
#                '=' is taken VERBATIM — quotes, &&, and $(…) all survive to the launch shell, so the
#                dynamic aspectj path keeps working. Unlike service-env, $VAR is SAFE here (this file
#                is read only by muster; compose/the broker never interpolate it).
#   workdir      (optional) cwd for the command; default is the repo ($REPO). $VAR is expanded.
#   writes_repo  (optional) true = the service writes into the repo, so `$SELF golden snapshot` refuses
#                to run while it is up (a torn snapshot otherwise). Was the hard-coded backend/frontend.
#   autostart    (optional) true = started automatically at hub boot (`$SELF autostart`, from entrypoint).
#   description  (optional) shown by `$SELF svcs`.
#   ready        (optional) a command that answers "is this service USABLE", not merely running —
#                e.g. `pinchtab health`. Run by `$SELF svcs` / `$SELF ready <svc>`; REPORTING ONLY,
#                nothing waits for it or restarts anything. $VAR/$(…) as in `command`.
#   ready_timeout   (optional) seconds before the probe counts as SLOW (default 5).
#   ready_warn_ms   (optional) a probe slower than this, but returning, is SLOW too (default 1000) —
#                the state that matters, because a client with a shorter deadline calls it DOWN.

# Parse one manifest into SVC_* globals. Returns 1 (no such manifest) / 2 (no command) / 0 (ok).
# The stack's manifest for a name, else muster's own. Overriding is by FILENAME, so a project that
# wants pinchtab started differently — or not at all — writes its own hub-services/pinchtab.
svc_file() {
	[ -f "$HUB_SERVICES_DIR/$1" ] && { printf '%s\n' "$HUB_SERVICES_DIR/$1"; return 0; }
	[ -f "$HUB_SERVICES_BUILTIN/$1" ] && { printf '%s\n' "$HUB_SERVICES_BUILTIN/$1"; return 0; }
	return 1
}

svc_load() {
	local name="$1" file line key val
	file="$(svc_file "$name")" || file=""
	SVC_COMMAND=""; SVC_WORKDIR=""; SVC_WRITES_REPO=""; SVC_AUTOSTART=""; SVC_DESCRIPTION=""
	SVC_READY=""; SVC_READY_TIMEOUT=""; SVC_READY_WARN_MS=""
	[ -f "$file" ] || return 1
	while IFS= read -r line || [ -n "$line" ]; do
		case "$line" in ''|'#'*) continue ;; esac
		key="${line%%=*}"
		[ "$key" != "$line" ] || continue          # no '=' on the line — not a field
		val="${line#*=}"
		key="${key#"${key%%[![:space:]]*}"}"; key="${key%"${key##*[![:space:]]}"}"   # trim the KEY only
		case "$key" in
			command)     SVC_COMMAND="$val" ;;
			workdir)     SVC_WORKDIR="$val" ;;
			writes_repo) SVC_WRITES_REPO="$val" ;;
			autostart)   SVC_AUTOSTART="$val" ;;
			description) SVC_DESCRIPTION="$val" ;;
			# USABLE is not the same fact as RUNNING, and only the service knows how to tell. A
			# process can hold its port, answer some endpoints and still be no use to the thing that
			# depends on it — a pinchtab whose /health took 3s was up, authenticated and driving
			# Chrome, while every agent was told "server is not running" because the CLI's preflight
			# gave up first. Nothing on the hub disagreed, because nothing on the hub had ever asked.
			ready)          SVC_READY="$val" ;;
			ready_timeout)  SVC_READY_TIMEOUT="$val" ;;
			ready_warn_ms)  SVC_READY_WARN_MS="$val" ;;
		esac
	done < "$file"
	[ -n "$SVC_COMMAND" ] || return 2
	return 0
}

# ------------------------------------------------------------------ readiness
#
# REPORTING ONLY. Nothing here starts, stops or waits for anything: `ready=` answers "is this service
# any use right now", `svcs` shows it, and what to do about it stays yours. That line is the whole
# feature — the evening this came from was spent proving, from a box, that a server the hub called
# `up` was answering /sessions in 1ms and /health in 3s.
#
# States, printed by svc_ready_state: ok | SLOW(<n>s) | UNREADY | (empty when no ready= is declared).
# SLOW is deliberately distinct from UNREADY: a probe that RETURNS, late, is the case that misleads —
# it looks healthy from every angle except the one with a deadline.
SVC_READY_TIMEOUT_DEFAULT=5
SVC_READY_WARN_MS_DEFAULT=1000
# How long a cached verdict is reused. `q` repaints on a timer and must not run a probe per repaint;
# `svcs` is typed by a human and forces a fresh one.
SVC_READY_TTL=15

svc_ready_cache() { printf '%s/ready/%s\n' "$STATE" "$1"; }

# "<state> <ms>" for a service, running its probe. Empty output when the manifest declares none.
svc_ready_probe() {
	local svc="$1" t0 t1 ms rc cmd to warn
	svc_load "$svc" || return 0
	[ -n "$SVC_READY" ] || return 0
	to="${SVC_READY_TIMEOUT:-$SVC_READY_TIMEOUT_DEFAULT}"
	warn="${SVC_READY_WARN_MS:-$SVC_READY_WARN_MS_DEFAULT}"
	cmd="$SVC_READY"
	[ -n "$SVC_WORKDIR" ] && cmd="cd $SVC_WORKDIR && $cmd"
	t0="$(date +%s%N)"
	# `timeout` rather than a bare run: a probe that HANGS must not hang `svcs`, and 124 is how we
	# learn it did. Output is dropped — this is a verdict, not a log; `logs <svc>` is for reading.
	timeout "$to" bash -lc "$cmd" >/dev/null 2>&1; rc=$?
	t1="$(date +%s%N)"
	ms=$(( (t1 - t0) / 1000000 ))
	if [ "$rc" = 124 ]; then printf 'SLOW %s\n' "$ms"
	elif [ "$rc" != 0 ];  then printf 'UNREADY %s\n' "$ms"
	elif [ "$ms" -gt "$warn" ]; then printf 'SLOW %s\n' "$ms"
	else printf 'ok %s\n' "$ms"
	fi
}

# Same, memoised for SVC_READY_TTL seconds. force=1 skips the cache (what `svcs` and `ready` pass).
svc_ready_state() {
	local svc="$1" force="${2:-0}" f age now out
	f="$(svc_ready_cache "$svc")"
	mkdir -p "${f%/*}" 2>/dev/null || true
	if [ "$force" != 1 ] && [ -f "$f" ]; then
		now="$(date +%s)"; age=$(( now - $(stat -c %Y "$f" 2>/dev/null || echo 0) ))
		[ "$age" -lt "$SVC_READY_TTL" ] && { cat "$f"; return 0; }
	fi
	out="$(svc_ready_probe "$svc")"
	[ -n "$out" ] || { rm -f "$f"; return 0; }
	printf '%s\n' "$out" > "$f"
	printf '%s\n' "$out"
}

# The column `svcs`/`q` print: up | up(SLOW 3.0s) | up(UNREADY) | DEAD(n) | down.
svc_state_label() {
	local svc="$1" force="${2:-0}" st ms
	if svc_dead "$svc"; then printf 'DEAD(%s)\n' "$(svc_exit_status "$svc")"; return 0; fi
	svc_running "$svc" || { printf 'down\n'; return 0; }
	read -r st ms <<< "$(svc_ready_state "$svc" "$force")"
	case "${st:-}" in
		SLOW)    printf 'up(SLOW %s.%ss)\n' "$((ms / 1000))" "$(( (ms % 1000) / 100 ))" ;;
		UNREADY) printf 'up(UNREADY)\n' ;;
		*)       printf 'up\n' ;;
	esac
}

# ONE LINE ON THE OVERVIEW, and only when something is wrong. This is what the whole feature is for:
# the screen you already stare at says "pinchtab up(SLOW 3.0s)" instead of you learning it from an
# agent, two containers away, reporting the wrong component. Cached (see SVC_READY_TTL) because this
# renders on every repaint and a browser probe is not free. A merely-`down` service is not a warning:
# services are on-demand by design, and shouting about the ones you chose not to run trains you to
# ignore the line.
svc_trouble_line() {
	local svc st out=""
	for svc in $(svc_names); do
		st="$(svc_state_label "$svc")"
		case "$st" in up|down) continue ;; esac
		out="${out}${out:+, }${svc} ${st}"
	done
	[ -n "$out" ] || return 0
	printf '  %s⚠ services: %s%s  %s($SELF ready <svc> for the timing, $SELF logs <svc> --tail 50)%s\n' \
		"$C_B$C_YEL" "$out" "$C_RESET" "$C_DIM" "$C_RESET"
}

# `<cli> ready <svc>` — the verdict on stdout, non-zero when it is not ok, for a script or a person
# who wants the number rather than the column.
svc_ready_cmd() {
	[ $# -ge 1 ] || die "ready needs a service name ('$SELF svcs' lists them)"
	local svc="$1" st ms
	svc_load "$svc" || die "unknown service '$svc'"
	[ -n "$SVC_READY" ] || { echo "$SELF: $svc declares no ready= probe — 'up' only means its command is running"; return 0; }
	if ! svc_running "$svc"; then
		echo "$SELF: $svc is $(svc_state_label "$svc" 1)"
		return 1
	fi
	read -r st ms <<< "$(svc_ready_state "$svc" 1)"
	echo "$SELF: $svc ready=$st (${ms}ms, probe: $SVC_READY)"
	case "$st" in
		ok) return 0 ;;
		SLOW) echo "     it ANSWERS, just slowly — a client with a shorter deadline will report it as down." >&2; return 1 ;;
		*) return 1 ;;
	esac
}

# true/1/yes/on -> success; anything else (incl. empty) -> failure.
svc_truthy() { case "$1" in 1|true|yes|on|TRUE|Yes|On) return 0 ;; *) return 1 ;; esac; }

# Every manifest name in the dir, sorted. Dotfiles/editor turds are skipped by the glob.
svc_names() {
	local f d
	for d in "$HUB_SERVICES_DIR" "$HUB_SERVICES_BUILTIN"; do
		[ -d "$d" ] || continue
		for f in "$d"/*; do
			[ -f "$f" ] || continue
			printf '%s\n' "${f##*/}"
		done
	done | sort -u          # a name in both dirs is ONE service; svc_file decides which file wins
	return 0
}

# UP MEANS THE COMMAND IS STILL RUNNING, NOT THAT A WINDOW EXISTS. svc_up deliberately keeps the
# window open after the command exits so the failure stays readable ("press enter to close") — which
# means a service that CRASHED leaves a window behind, and a window was all this used to look at. A
# dead pinchtab then reads as `up` in `svcs`, `up pinchtab` answers "already running" and does
# nothing, and the agent is left with a browser that half-works and no way to fix it. The window
# wrapper drops the exit status in a file; its presence is what tells the two apart.
# NOT "$(svc_log …).exit": svc_log already ends in .log, so that spelled <svc>.log.exit — a name
# nobody would guess when looking for it by hand.
svc_exit_file() { printf '%s/logs/%s.exit\n' "$STATE" "$1"; }
svc_window() { tmux list-windows -t "$TMUX_SESSION" -F '#W' 2>/dev/null | grep -qx "$1"; }
svc_running() { svc_window "$1" && [ ! -f "$(svc_exit_file "$1")" ]; }
# A window whose command exited and is sitting on its "press enter" — the state that has to be
# distinguishable from both up and down, because it is the one that needs saying out loud.
svc_dead() { svc_window "$1" && [ -f "$(svc_exit_file "$1")" ]; }
svc_exit_status() { cat "$(svc_exit_file "$1")" 2>/dev/null || echo '?'; }

svc_up() {
	local svc="$1" cmd
	svc_load "$svc" || die "unknown service '$svc' — no manifest at $HUB_SERVICES_DIR/$svc or $HUB_SERVICES_BUILTIN/$svc ('$SELF svcs' lists them)"
	if svc_running "$svc"; then
		echo "$SELF: $svc already running ($SELF logs $svc to view)"; return 0
	fi
	# Crashed, window still open: START IT. Refusing with "already running" is what turned a service
	# that died into one nobody could bring back without knowing to kill a tmux window first.
	if svc_dead "$svc"; then
		echo "$SELF: $svc had exited (status $(svc_exit_status "$svc")) — restarting it ($SELF logs $svc --tail 200 for why)"
		tmux kill-window -t "${TMUX_SESSION}:${svc}" 2>/dev/null || true
	fi
	# The hub's entrypoint starts this server at boot and every service is a WINDOW in it. If it is
	# gone, tmux would fail with a bare "error connecting to /tmp/tmux-<uid>/default", which says
	# nothing about what to do.
	tmux has-session -t "$TMUX_SESSION" 2>/dev/null \
		|| die "no tmux session '$TMUX_SESSION' — the hub's tmux server is not running. It is started at
     boot, so recreate the hub: docker compose up -d --force-recreate hub"
	cmd="$SVC_COMMAND"
	# workdir overrides the window's default cwd; unquoted so $REPO/$VAR expand in the launch shell.
	[ -n "$SVC_WORKDIR" ] && cmd="cd $SVC_WORKDIR && $cmd"
	local log exitf; log="$(svc_log "$svc")"; exitf="$(svc_exit_file "$svc")"
	mkdir -p "${log%/*}"; : > "$log"
	# Clear LAST run's death certificate before this one starts, or the service comes up already
	# looking dead.
	rm -f "$exitf"
	# Keep the window alive after the command exits so failures stay readable — and SAY the exit
	# status and where the output is. "backend exited" alone sends you hunting through a pane you may
	# not be able to scroll: nested tmux eats the scroll keys, and the window is gone once you press
	# enter. $? is captured on the very next line, before echo overwrites it.
	tmux new-window -t "$TMUX_SESSION" -n "$svc" -c "$REPO" \
		"bash -lc $(printf '%q' "$cmd; _rc=\$?; printf '%s\\n' \"\$_rc\" > $exitf; echo; echo \"[muster] $svc exited (status \$_rc) — full output: $log\"; echo '[muster] read it from anywhere with: $SELF logs $svc --tail 200'; echo '[muster] scroll here: Shift-PageUp — inside another tmux, press Ctrl-b twice first'; echo '[muster] press enter to close this window'; read _")"
	# pipe-pane copies everything the pane shows into a FILE, without touching the process: the service
	# keeps its tty (so gradle/ng keep their colours and progress), and the output survives both the
	# scrollback and the window itself. -o toggles it on for this pane only.
	tmux pipe-pane -o -t "${TMUX_SESSION}:${svc}" "cat >> $(printf '%q' "$log")" 2>/dev/null || true
	echo "$SELF: started $svc ($SELF logs $svc to view, $SELF logs $svc --tail N to read the output)"
}

svc_down() {
	local svc="$1"
	tmux kill-window -t "${TMUX_SESSION}:${svc}" 2>/dev/null && echo "$SELF: stopped $svc" \
		|| echo "$SELF: $svc not running"
}

# Where a service's captured output lives. Under $STATE (the repo's .git/cbx) so it is bind-mounted —
# it survives a hub recreate — and invisible to git, like every other piece of muster state.
svc_log() { printf '%s/logs/%s.log\n' "$STATE" "$1"; }

svc_logs() {
	argsort "--tail?" "$@"; set -- ${ARGV[@]+"${ARGV[@]}"}
	local svc="$1"; shift
	local n=""
	case "${1:-}" in
		--tail) n="${2:-200}" ;;
		--file) printf '%s\n' "$(svc_log "$svc")"; return 0 ;;
		'') ;;
		*) die "logs: unknown option '$1' (want: --tail [N] | --file)" ;;
	esac
	# READING beats attaching when something has gone wrong. Attaching gives you a pane you may not be
	# able to scroll (a laptop tmux around the ssh eats the scroll keys) and that disappears the moment
	# you dismiss it; --tail prints into YOUR terminal, where your own scrollback keeps it.
	if [ -n "$n" ]; then
		local f; f="$(svc_log "$svc")"
		[ -f "$f" ] || die "no captured output for '$svc' at $f — has it been started since the hub booted?"
		tail -n "$n" "$f"
		return 0
	fi
	exec tmux attach -t "${TMUX_SESSION}" \; select-window -t "${TMUX_SESSION}:$svc"
}

# List every defined service with its running state, flags and description.
svc_list() {
	local svc any=0 flags
	echo "== services (from $HUB_SERVICES_DIR, plus muster's own) =="
	for svc in $(svc_names); do
		svc_load "$svc" || { printf '  %-12s %-5s (no command — bad manifest)\n' "$svc" "----"; any=1; continue; }
		any=1
		flags=""
		svc_truthy "$SVC_AUTOSTART"   && flags="${flags}autostart "
		svc_truthy "$SVC_WRITES_REPO" && flags="${flags}writes-repo "
		# force=1: `svcs` is typed by a person who wants the truth now, not a cached verdict.
		printf '  %-12s %-14s %s%s\n' "$svc" "$(svc_state_label "$svc" 1)" \
			"${flags:+[$flags] }" "${SVC_DESCRIPTION:-}"
	done
	[ "$any" = 1 ] || echo "  (none — drop a manifest in $HUB_SERVICES_DIR; see hub-services.example)"
	return 0
}

# Start every service whose manifest sets autostart=true. Called from the hub entrypoint at boot.
svc_autostart() {
	local svc n=0
	for svc in $(svc_names); do
		svc_load "$svc" || continue
		svc_truthy "$SVC_AUTOSTART" || continue
		echo "$SELF: autostart $svc" >&2
		svc_up "$svc" || echo "$SELF: autostart of $svc failed (continuing)" >&2
		n=$((n + 1))
	done
	[ "$n" -gt 0 ] || echo "$SELF: no services marked autostart in $HUB_SERVICES_DIR" >&2
}

# ------------------------------------------------------------------ broker

broker() {
	local method="$1" path="$2"; shift 2
	# --fail-with-body (curl >= 7.76): like -f it still returns non-zero on HTTP >= 400 so callers'
	# `&&` chains detect failure, but UNLIKE -f it prints the response body, so the broker's
	# {"error": "..."} is shown instead of a bare "curl: (22) ... error: 500".
	curl --fail-with-body -sS -X "$method" -H "X-Broker-Token: $BROKER_TOKEN" "$@" "${BROKER_URL}${path}"
}

jqr() { jq -r "$1" 2>/dev/null || true; }

# THE VERSION HANDSHAKE. The hub, the broker and the box image are three images produced by up to
# three different build paths — muster publishes the first two, a project builds its own box add-on —
# and nothing in the stack forces them to move together. When they don't, the failures are silent
# rather than loud: an older broker simply ignores query parameters a newer hub sends (a `minto` box
# quietly starts on $DEV instead of the target branch), and a broker naming binaries an older box
# image doesn't have leaves boxes that never initialise.
#
# So: say so. Prints one line per disagreement, nothing at all when they match, and treats "unknown"
# as "cannot tell" rather than as a mismatch — a hand-built image is not a fault.
version_drift() {
	local resp broker box ref
	resp="$(broker GET /version 2>/dev/null)" || return 0     # old broker: no endpoint, nothing to say
	broker="$(printf '%s' "$resp" | jqr '.broker // empty')"
	box="$(printf '%s' "$resp" | jqr '.box_image // empty')"
	ref="$(printf '%s' "$resp" | jqr '.box_image_ref // empty')"
	[ -n "$broker" ] || return 0
	local drift=0
	if [ "$MUSTER_VERSION" != unknown ] && [ "$broker" != unknown ] && [ "$MUSTER_VERSION" != "$broker" ]; then
		printf '  %sVERSION DRIFT — this hub is muster %s, the broker is %s%s\n' \
			"$C_B$C_RED" "$MUSTER_VERSION" "$broker" "$C_RESET"
		drift=1
	fi
	if [ "$MUSTER_VERSION" != unknown ] && [ "$box" != unknown ] && [ "$MUSTER_VERSION" != "$box" ]; then
		printf '  %sVERSION DRIFT — this hub is muster %s, the box image (%s) was built on %s%s\n' \
			"$C_B$C_RED" "$MUSTER_VERSION" "$ref" "$box" "$C_RESET"
		drift=1
	fi
	[ "$drift" = 0 ] || printf '  %sthe three images must come from one muster version; redeploy the stack%s\n' \
		"$C_YEL" "$C_RESET"
	return 0
}

box_new() {
	local name="${1:-$(cut -c1-6 /proc/sys/kernel/random/uuid 2>/dev/null || echo $$)}"
	local resp container
	resp="$(broker POST "/box/$name")" || die "spawning box '$name' failed: $resp"
	container="$(printf '%s' "$resp" | jqr '.container // empty')"
	[ -n "$container" ] || container="$(printf '%s' "$resp" | sed -n 's/.*"container"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p')"
	# A NAME YOU ALREADY HAVE IS A REQUEST TO GO BACK INTO IT, not a mistake — so the broker answers
	# with the existing box (or, if its container had stopped, a recreated one) instead of letting
	# docker's "container name is already in use" conflict out, and the only difference here is which
	# line we print. `cbxbox`/the alias attaches after either one, which is the whole point.
	case "$(printf '%s' "$resp" | jqr '.existing // empty')" in
		true)
			if [ "$(printf '%s' "$resp" | jqr '.restarted // empty')" = true ]; then
				echo "$SELF: box '$name' already up as '$container' (it had stopped — recreated on golden $(printf '%s' "$resp" | jqr '.golden // empty'), resuming its session)."
			else
				echo "$SELF: box '$name' already up as '$container' on branch agent/$name (golden $(printf '%s' "$resp" | jqr '.golden // empty')) — attaching, nothing was respawned."
			fi
			;;
		*)
			echo "$SELF: box '$name' up as '$container' on branch agent/$name (golden $(printf '%s' "$resp" | jqr '.golden // empty'))."
			;;
	esac
	echo "  docker exec -it -u dev $container tmux attach -t main      # Ctrl-b d to detach"
}

box_kill() {
	[ $# -ge 1 ] || die "kill needs a box name"
	local resp
	resp="$(broker DELETE "/box/$1")" || die "killing box '$1' failed: $resp"
	echo "$SELF: killed box '$1' (its upper layer is kept — '$SELF box $1' reattaches to it)"
}

box_recreate() {
	argsort "" "$@"; set -- ${ARGV[@]+"${ARGV[@]}"}
	[ $# -ge 1 ] || die "recreate needs a box name (or 'all')"
	local target="$1" q="" resp
	shift
	[ "${1:-}" = --fresh ] && q="?fresh=1"
	if [ "$target" = all ]; then
		echo "$SELF: pulling newest image + recreating all boxes (each resumes its own session)..."
		resp="$(broker POST "/recreate${q}")" || die "recreate all failed: $resp"
		echo "$SELF: recreated: $(printf '%s' "$resp" | jqr '.recreated | join(", ")')"
	else
		resp="$(broker POST "/recreate/${target}${q}")" || die "recreate '$target' failed: $resp"
		echo "$SELF: box '$target' recreated as '$(printf '%s' "$resp" | jqr '.container // empty')'."
	fi
}

forwards_refresh() {
	# The socat forwarders live in the HUB's netns, so replacing the hub container (any `docker compose
	# up -d hub`) kills them and agent frontends silently stop being reachable from pinchtab. The hub
	# does this on boot; run it by hand if a box's dev server went unreachable without being restarted.
	local resp
	resp="$(broker POST "/forwards${1:+/$1}")" || die "refreshing forwards failed: $resp"
	echo "$SELF: re-established forwards for: $(printf '%s' "$resp" | jqr '.forwards | join(", ") // "(none running)"')"
}

box_ls() {
	svc_list
	echo "== boxes (broker) =="
	local resp box st age
	if resp="$(broker GET "/box" 2>/dev/null)"; then
		while IFS=$'\t' read -r box status golden; do
			[ -n "$box" ] || continue
			read -r st age <<< "$(box_activity "$box")"
			printf '  %-12s %-10s %-22s %s\n' "$box" "$st" "$status" "golden=$golden"
		done < <(printf '%s' "$resp" | jq -r '.boxes[]? | "\(.box)\t\(.status)\t\(.golden)"' 2>/dev/null)
		# Boxes with a directory but no container. `kill` keeps that directory on purpose (unpushed work
		# + warm caches, and `box <same name>` reattaches to it), so they pile up unseen — one of these
		# is what "out of port-forward slots with two boxes running" used to be about.
		local rbox rgold rsize any=0
		while IFS=$'\t' read -r rbox rgold rsize; do
			[ -n "$rbox" ] || continue
			[ "$any" = 1 ] || { echo "== retired (kept for '$SELF box <name>' to reattach) =="; any=1; }
			printf '  %-12s %-10s %-22s %s\n' "$rbox" "-" "on disk: $(human_size "${rsize:-0}")" "golden=$rgold"
		done < <(printf '%s' "$resp" | jq -r '.retired[]? | "\(.box)\t\(.golden)\t\(.size)"' 2>/dev/null)
		[ "$any" = 0 ] || echo "  ($SELF purge <name> removes one for good)"
	else
		echo "  (broker unreachable)"
	fi
}

# Bytes as something you can read at a glance. Deciding what to purge is a size question.
human_size() {
	local b="${1:-0}"
	if   [ "$b" -ge 1073741824 ] 2>/dev/null; then printf '%s.%sG' "$((b/1073741824))" "$(((b%1073741824)*10/1073741824))"
	elif [ "$b" -ge 1048576 ]    2>/dev/null; then printf '%sM' "$((b/1048576))"
	elif [ "$b" -ge 1024 ]       2>/dev/null; then printf '%sK' "$((b/1024))"
	else printf '%sB' "$b"; fi
}

# Remove a box FOR GOOD — container, volumes, upper layer, caches, session. The one irreversible thing
# here, so it refuses while the box still has a handoff nobody merged, and asks before doing it.
box_purge() {
	[ $# -ge 1 ] || die "purge needs a box name ('$SELF ls' lists them)"
	local box="$1" force="" resp
	[ "${2:-}" = --force ] && force=1
	if git_ rev-parse --verify -q "refs/agents/$box" >/dev/null && [ -z "$force" ]; then
		echo "$SELF: '$box' still has a handoff waiting in the review queue." >&2
		echo "$SELF: review it  — $SELF review $box" >&2
		echo "$SELF: merge it   — $SELF merge $box" >&2
		echo "$SELF: bin it     — $SELF drop $box   (then purge)" >&2
		die "refusing to purge a box whose work you have not looked at ($SELF purge $box --force overrides)"
	fi
	if [ -t 0 ] && [ -z "$force" ]; then
		tty_flush
		printf "%s: permanently remove '%s' — container, upper layer, caches, session? [y/N] " "$SELF" "$box" > /dev/tty
		local answer=""; read -r answer < /dev/tty || answer=n
		case "$answer" in y|Y|yes|YES) ;; *) die "not purged" ;; esac
	fi
	resp="$(broker DELETE "/box/$box/purge")" || die "purging '$box' failed: $resp"
	rm -f "$STATE/$box.reviewed" "$STATE/$box.sent" "$STATE/$box.mergeinto"
	rm -rf "$(reword_dir "$box")"
	echo "$SELF: purged '$box' — freed $(human_size "$(printf '%s' "$resp" | jqr '.freed // 0')")"
}

say_to_box() {
	# Deliver a line into the box's claude session. Note this is a PROMPT, not a shell command: the
	# window runs claude, so phrase instructions the way you'd type them to the agent.
	# RETURNS non-zero rather than dying: several callers (merge, drop, rebase) treat an unreachable
	# box as a note, not a failure — and a `die` here would abort them AFTER they'd done their work.
	local box="$1" msg="$2" resp
	resp="$(broker POST "/box/$box/say" --data-raw "$msg" 2>&1)" || {
		echo "$SELF: could not reach box '$box': $resp" >&2
		return 1
	}
}

paste_to_box() {
	# Same, for a MULTI-LINE prompt (a tuicr review: one numbered point per line). say_to_box cannot
	# carry one — its send-keys types the text, and claude submits on every newline, so an N-line
	# review would arrive as N half-prompts, each acted on before the next lands. /paste puts the text
	# in through tmux's BRACKETED paste instead, exactly like a real paste into the composer, and the
	# Enter that follows is the only thing that submits. --data-binary, not --data-raw: curl's
	# --data-raw is still text and @-free but we want the bytes and newlines untouched.
	local box="$1" msg="$2" resp
	resp="$(broker POST "/box/$box/paste" --data-binary @- <<<"$msg" 2>&1)" || {
		echo "$SELF: could not reach box '$box': $resp" >&2
		return 1
	}
}

# ------------------------------------------------------------------ review queue

agent_refs() { git_ for-each-ref --format='%(refname:strip=2)' refs/agents/; }

# The handoff summary, or empty. The `|| true` is load-bearing: `git notes show` exits non-zero when
# a box handed off WITHOUT a summary (bare `handoff`), pipefail propagates that through head, and
# under `set -e` the enclosing `msg="$(note_of …)"` then kills the whole command silently.
note_of() { git_ notes --ref=cbx show "refs/agents/$1" 2>/dev/null | head -1 || true; }

# `--notes=cbx`, but only when that ref exists. Otherwise git prefixes EVERY log with "warning: notes
# ref refs/notes/cbx is invalid" — which is the first thing you see in a stack where no agent has yet
# handed off with a summary, and it reads like something is broken.
notes_arg() { git_ rev-parse --verify -q refs/notes/cbx >/dev/null && printf '%s' --notes=cbx || true; }

# Conflicted paths between two committishes, without touching the worktree or the index.
# --no-messages drops git's "Auto-merging / CONFLICT (content)" prose, leaving the tree oid on line 1
# and one conflicted path per line after it; a clean merge exits 0 and we report nothing.
conflicts_between() {
	local out
	if out="$(git_ merge-tree --write-tree --name-only --no-messages "$1" "$2" 2>/dev/null)"; then
		return 0                     # clean merge, nothing to report
	fi
	printf '%s' "$out" | tail -n +2 | tr '\n' ' '
}

# Review state per box: "<agent-ref sha> <dev sha>", both as of your last review. The dev sha is what
# lets us tell a REBASE apart from new work — after a rebase every commit gets a new sha, so the ref
# alone always looks changed even when the agent did nothing.
review_state() { cat "$STATE/$1.reviewed" 2>/dev/null || true; }
reviewed_ref() { awk '{print $1}' "$STATE/$1.reviewed" 2>/dev/null || true; }
reviewed_dev() { awk '{print $2}' "$STATE/$1.reviewed" 2>/dev/null || true; }

# Sorted patch-ids for a range. A patch-id hashes the CHANGE, not the commit, so it survives a rebase
# (and any commit-date/parent churn) — identical sets mean identical content.
# NOTE the input must be a PATCH: `git patch-id` fed a list of shas (rev-list) silently reads no diff
# and prints nothing, which would make every comparison below trivially "equal".
patch_ids() {
	git_ log --no-color --no-merges -p "$1..$2" 2>/dev/null | git_ patch-id --stable 2>/dev/null \
		| awk '{print $1}' | sort || true
}

# True when the branch changed only because it was rebased: same patches, different shas. Needs a
# recorded dev sha, so state written before this existed just falls through to "re-review".
rebase_only() {
	local box="$1" pdev pref old new base
	base="$(base_of "$box")"
	pdev="$(reviewed_dev "$box")"; pref="$(reviewed_ref "$box")"
	[ -n "$pdev" ] && [ -n "$pref" ] || return 1
	git_ rev-parse --verify -q "${pdev}^{commit}" >/dev/null || return 1
	old="$(patch_ids "$pdev" "$pref")"
	new="$(patch_ids "$base" "refs/agents/$box")"
	# Two empty sets are not evidence of a rebase — they mean we failed to read patches at all.
	[ -n "$old" ] && [ "$old" = "$new" ]
}

# merged | new | reviewed | rebased | re-review
# Measured against the box's BASE, which is $DEV for an ordinary box and the target branch for one
# spawned by `$SELF minto` — a merge box's branch sits on top of the target and would otherwise read as
# "hundreds of commits ahead of dev, conflicts with everything".
box_status() {
	# `base`, NOT a local shadowing $DEV: bash locals are dynamically scoped, so a `local DEV` here
	# would still be unset while base_of (which reads $DEV) runs, and `set -u` would kill muster.
	local box="$1" sha prev base
	base="$(base_of "$box")"
	sha="$(git_ rev-parse "refs/agents/$box")"
	prev="$(reviewed_ref "$box")"
	# Nothing on top of the base = this branch is already contained in it: it was merged, and only the
	# ref and the review state were left behind (a conflicted `$SELF merge` that you finished by hand
	# does exactly that). Say so FIRST — otherwise the box sits in the queue as 'new' or 're-review'
	# forever, `$SELF review` has an empty range to show, and there is no obvious way out.
	if [ "$(git_ rev-list --count "$base..refs/agents/$box" 2>/dev/null || echo 1)" = 0 ]; then
		echo merged
	elif [ -z "$prev" ]; then echo new
	elif [ "$prev" = "$sha" ]; then echo reviewed
	elif rebase_only "$box"; then echo rebased
	else echo re-review
	fi
}

queue() {
	local any=0 box sha ahead age note prev status conf other base mt
	printf '%-12s %6s %-14s %-11s %s\n' BOX AHEAD LAST STATUS SUMMARY
	for box in $(agent_refs); do
		any=1
		base="$(base_of "$box")"; mt="$(minto_target "$box")"
		sha="$(git_ rev-parse "refs/agents/$box")"
		# AHEAD for a minto box counts what the BOX added (the merge commit), not what the merge brings
		# in with it — see minto_own_count. The target it is merging into goes in the summary rather
		# than the STATUS column, which stays new/re-review/reviewed and keeps the table aligned.
		if [ -n "$mt" ]; then
			ahead="$(minto_own_count "$box" "$base")"
		else
			ahead="$(git_ rev-list --count "$base..refs/agents/$box" 2>/dev/null || echo '?')"
		fi
		age="$(git_ log -1 --format=%cr "refs/agents/$box")"
		note="$(note_of "$box")"
		status="$(box_status "$box")"
		[ -n "$mt" ] && note="[minto -> $mt] ${note:-—}"
		printf '%-12s %6s %-14s %-11s %s\n' "$box" "$ahead" "$age" "$status" "${note:-—}"
		# A minto box conflicts with $DEV and with every other box BY CONSTRUCTION — its branch is the
		# target branch plus a merge. Reporting that would be noise on every single line.
		[ -n "$mt" ] && continue
		# Conflicts are the shared-checkout collision awareness, moved earlier: you learn that two
		# agents touched the same lines when they push, not when you merge the second one.
		conf="$(conflicts_between "$DEV" "refs/agents/$box")"
		[ -n "$conf" ] && printf '  %-10s ⚠ conflicts with %s: %s\n' "" "$DEV" "$conf"
		for other in $(agent_refs); do
			[ "$other" = "$box" ] && continue
			[[ "$other" > "$box" ]] || continue          # report each pair once
			[ -n "$(minto_target "$other")" ] && continue
			conf="$(conflicts_between "refs/agents/$box" "refs/agents/$other")"
			[ -n "$conf" ] && printf '  %-10s ⚠ conflicts with %s: %s\n' "" "$other" "$conf"
		done
	done
	[ "$any" = 1 ] || echo "  (nothing waiting — no refs/agents/* pushed yet)"
}

status_overview() {
	# One screen: everything that can move, and the command that moves it. Each section prints state;
	# anything actionable is collected into the "next" list at the bottom in the order you'd do it
	# (pull before merge before push, so agent work never lands on a stale base).
	#
	# `$SELF q`'s watch mode repaints THIS, so keep it cheap and side-effect free. Its one network call
	# is the origin fetch, which `--no-fetch` skips (the watch loop throttles it to $WATCH_FETCH).
	local behind ahead box sha st bhd ahd age note conf dconf act other list running gprov gsha gbehind todo=()
	local cols nw=3 sumw rows=() row bname bstatus bgolden bstate bage detail

	cols="$(term_cols)"

	# Both tables key on the box name, so they share ONE name column: the eye then reads straight down
	# from "who handed off" to "who is still running". That needs the broker list before the queue is
	# printed, which is why the call sits up here rather than in the boxes section below.
	list="$(agent_refs)"
	running="$(broker GET /box 2>/dev/null || true)"
	if [ -n "$running" ]; then
		while IFS=$'\t' read -r bname bstatus bgolden; do
			[ -n "$bname" ] || continue
			rows+=("$bname"$'\t'"$bstatus")
		done < <(printf '%s' "$running" | jq -r '.boxes[]? | "\(.box)\t\(.status)\t\(.golden)"' 2>/dev/null)
	fi
	for box in $list; do [ "${#box}" -gt "$nw" ] && nw="${#box}"; done
	for row in ${rows[@]+"${rows[@]}"}; do
		bname="${row%%$'\t'*}"
		[ "${#bname}" -gt "$nw" ] && nw="${#bname}"
	done
	[ "$nw" -le $(( cols / 3 )) ] || nw=$(( cols / 3 ))   # one pathological name must not eat the table

	hdr branch
	if [ "${1:-}" = --no-fetch ]; then
		:
	else
		git_ fetch -q origin "$DEV" 2>/dev/null \
			|| printf '  %s(origin unreachable — counts below may be stale)%s\n' "$C_YEL" "$C_RESET"
	fi
	read -r behind ahead <<< "$(divergence)"
	printf '  %s%s%s @ %s%s%s — %s%s behind%s, %s%s ahead%s of origin\n' \
		"$C_B" "$DEV" "$C_RESET" "$C_YEL" "$(git_ rev-parse --short "$DEV")" "$C_RESET" \
		"$([ "$behind" = 0 ] && printf '%s' "$C_DIM" || printf '%s' "$C_B$C_RED")" "$behind" "$C_RESET" \
		"$([ "$ahead" = 0 ] && printf '%s' "$C_DIM" || printf '%s' "$C_GRN")" "$ahead" "$C_RESET"
	[ "$behind" != 0 ] && todo+=("$SELF pull                # take $behind commit(s) from origin first")

	# Open `$SELF minto` worktrees. These have no box and no agent ref, so nothing else on this screen
	# would show them — and an unfinished merge sitting in .git/cbx/wt is exactly the thing you forget.
	local wtd wtb
	for wtd in "$MINTO_WT"/*; do
		[ -d "$wtd" ] || continue
		wtb="$(git -C "$wtd" symbolic-ref --short -q HEAD 2>/dev/null || basename "$wtd")"
		printf '  %s%s%s — %sunfinished merge of %s%s, in %s\n' \
			"$C_B" "$wtb" "$C_RESET" "$C_YEL" "$DEV" "$C_RESET" "$wtd"
		todo+=("$SELF minto $wtb --landed   # finish the merge you started (or --abort)")
	done

	svc_trouble_line

	# The queue lives INSIDE the overview (rather than beside it) so one screen answers both "who is
	# waiting on me" and "what do I do about it" — `$SELF q --text` still prints the bare table.
	hdr "review queue"
	# 2 indent + name + status(9) + ahead(5) + behind(6) + last(13), each with a space after it.
	sumw=$(( cols - nw - 39 ))
	if [ -z "$list" ]; then
		printf '  %s(nothing waiting — an agent publishes with '"'"'handoff "summary"'"'"')%s\n' "$C_DIM" "$C_RESET"
	else
		printf '  %s%-*s %-9s %5s %6s %-13s %s%s\n' \
			"$C_DIM" "$nw" BOX STATUS AHEAD BEHIND LAST SUMMARY "$C_RESET"
	fi
	for box in $list; do
		# A minto box is measured against the branch it is merging INTO, not $DEV: its branch is that
		# branch plus one merge commit, so dev-relative counts would read as hundreds of commits ahead.
		local mbase mtgt
		mtgt="$(minto_target "$box")"; mbase="${mtgt:-$DEV}"
		sha="$(git_ rev-parse --short "refs/agents/$box")"
		st="$(box_status "$box")"
		ahd="$(git_ rev-list --count "$mbase..refs/agents/$box" 2>/dev/null || echo '?')"
		bhd="$(git_ rev-list --count "refs/agents/$box..$mbase" 2>/dev/null || echo '?')"
		age="$(git_ log -1 --format=%cr "refs/agents/$box")"; age="${age% ago}"
		note="$(note_of "$box")"
		if [ -n "$mtgt" ]; then
			# The target goes in the SUMMARY, not the STATUS column: status still means new / reviewed /
			# re-review (it is what decides the suggestion below), and a branch name would blow the
			# column's width apart. AHEAD is what the box itself added — the merge commit — not the
			# commits the merge brings along with it.
			ahd="$(minto_own_count "$box" "$mtgt")"
			printf '  %s %s %s%5s%s %s%6s%s %s%-13s%s %s%s%s\n' \
				"$(cell "$C_B" "$nw" "$(trunc "$nw" "$box")")" "$(cell "$(q_color "$st")" 9 "$st")" \
				"$C_GRN" "$ahd" "$C_RESET" "$C_DIM" 0 "$C_RESET" \
				"$C_DIM" "$(trunc 13 "$age")" "$C_RESET" \
				"$C_MAG" "$(trunc "$sumw" "[minto -> $mtgt] ${note:-—}")" "$C_RESET"
			# No conflict scan: a merge box collides with $DEV and with every other box by construction.
			case "$st" in
				new|re-review) todo+=("$SELF review $box            # the conflict resolution for $mtgt") ;;
				*)             todo+=("$SELF minto $mtgt --land $box   # land the resolved merge") ;;
			esac
			continue
		fi
		printf '  %s %s %s%5s%s %s%6s%s %s%-13s%s %s\n' \
			"$(cell "$C_B" "$nw" "$(trunc "$nw" "$box")")" "$(cell "$(q_color "$st")" 9 "$st")" \
			"$C_GRN" "$ahd" "$C_RESET" \
			"$([ "$bhd" = 0 ] && printf '%s' "$C_DIM" || printf '%s' "$C_YEL")" "$bhd" "$C_RESET" \
			"$C_DIM" "$(trunc 13 "$age")" "$C_RESET" \
			"$(trunc "$sumw" "${note:-—}")"
		# Conflicts are the shared-checkout collision awareness, moved earlier: you learn that two
		# agents touched the same lines when they push, not when you merge the second one.
		# 22 = the two-space indent, the space after the name column, and "⚠ conflicts with <x>: ".
		# Kept in its own variable: `conf` is reused by the box-vs-box loop below, and the suggestion
		# built afterwards needs to know specifically whether this branch collides with $DEV.
		dconf="$(conflicts_between "$DEV" "refs/agents/$box")"
		[ -n "$dconf" ] && printf '  %*s %s⚠ conflicts with %s:%s %s\n' \
			"$nw" "" "$C_B$C_RED" "$DEV" "$C_RESET" "$(trunc "$((cols - nw - 22 - ${#DEV}))" "$dconf")"
		for other in $list; do
			[ "$other" = "$box" ] && continue
			[[ "$other" > "$box" ]] || continue          # report each pair once
			conf="$(conflicts_between "refs/agents/$box" "refs/agents/$other")"
			[ -n "$conf" ] && printf '  %*s %s⚠ conflicts with %s:%s %s\n' \
				"$nw" "" "$C_B$C_RED" "$other" "$C_RESET" "$(trunc "$((cols - nw - 22 - ${#other}))" "$conf")"
		done
		case "$st" in
			merged)        act="$SELF merge $box            # already in $DEV — retires the branch, tells the box" ;;
			new|re-review) act="$SELF review $box" ;;
			rebased)       act="$SELF merge $box            # rebased only, nothing new to read" ;;
			reviewed)      act="$SELF merge $box" ;;
			*)             act="" ;;
		esac
		# 'merged' outranks the conflict check below: there is nothing left to rebase or review, and
		# the conflict is against work of its own that already landed.
		if [ "$st" = merged ]; then todo+=("$act"); continue; fi
		# ORDER MATTERS HERE — this list is read as "do the top one next".
		#
		# A branch that CONFLICTS with $DEV has to rebase before anything else: the rebase rewrites the
		# very lines you would be reading, so a review done first is read twice, and `$SELF merge` would
		# stop halfway through with conflicts in the hub's worktree. So the rebase replaces the
		# review/merge suggestion rather than trailing it — reviewing is not the next step, it is the
		# step after. Merely being BEHIND is different: the patches still apply, so the review stands
		# and the rebase is the follow-up (cheap, and `$SELF merge` does it for you anyway).
		if [ -n "$dconf" ]; then
			todo+=("$SELF rebase $box           # CONFLICTS with $DEV — rebase before reviewing/merging")
		else
			if [ -n "$act" ]; then todo+=("$act"); fi
			if [ "$bhd" != 0 ] && [ "$bhd" != '?' ]; then
				todo+=("$SELF rebase $box           # $bhd commit(s) behind $DEV")
			fi
		fi
	done

	hdr boxes
	version_drift
	if [ -z "$running" ]; then
		printf '  %s(broker unreachable)%s\n' "$C_RED" "$C_RESET"
	elif [ "${#rows[@]}" -eq 0 ]; then
		printf '  %s(no boxes running — $SELF box <name> to start one)%s\n' "$C_DIM" "$C_RESET"
	fi
	for row in ${rows[@]+"${rows[@]}"}; do
		bname="${row%%$'\t'*}"; bstatus="${row#*$'\t'}"
		read -r bstate bage <<< "$(box_activity "$bname")"
		# The right-hand column answers "and how long has that been true", which is the whole reason to
		# look: a 3s 'waiting' is the agent thinking out loud, a 5h33m one is a session you forgot.
		case "$bstate" in
			busy)    detail="${C_DIM}working for${C_RESET} $(human_age "$bage")" ;;
			waiting) detail="${C_B}${C_MAG}wants your input${C_RESET} ${C_DIM}for${C_RESET} $(human_age "$bage")" ;;
			idle)    detail="${C_DIM}$bstatus, quiet for${C_RESET} $(human_age "$bage")" ;;
			stale)   detail="${C_RED}no hook activity for $(human_age "$bage")${C_RESET} ${C_DIM}($bstatus)${C_RESET}" ;;
			*)       detail="${C_DIM}$bstatus${C_RESET}" ;;
		esac
		printf '  %s %s%s %-8s%s %s\n' \
			"$(cell "$C_B" "$nw" "$(trunc "$nw" "$bname")")" "$(act_color "$bstate")" "●" "$bstate" "$C_RESET" "$detail"
	done

	hdr golden
	gprov="$(cat "$GOLDEN/current/.git/cbx-golden" 2>/dev/null || true)"
	if [ -z "$gprov" ]; then
		printf '  %s(none yet)%s\n' "$C_DIM" "$C_RESET"
		todo+=("$SELF golden snapshot     # no base for boxes to overlay")
	else
		printf '  %s%s%s\n' "$C_DIM" "$gprov" "$C_RESET"
		# Field 3 of "g-<id> from <sha> (<branch>) at <date>" — a hint only, so it is never fatal.
		#
		# HOW FAR behind, not just whether: every box overlays this tree, so the number is the size of
		# the gap each new agent starts with and has to rebase across. "dev has moved" reads the same
		# after one merge as after thirty, and those are different decisions.
		gsha="$(printf '%s' "$gprov" | awk '{print $3}')"
		gbehind=""
		[ -n "$gsha" ] && git_ rev-parse -q --verify "${gsha}^{commit}" >/dev/null 2>&1 \
			&& gbehind="$(git_ rev-list --count "${gsha}..${DEV}" 2>/dev/null || true)"
		if [ -n "$gbehind" ] && [ "$gbehind" != 0 ]; then
			# WHAT A SNAPSHOT ACTUALLY BUYS, which is not what this line used to claim. A new box does
			# `git checkout -B agent/<box> hub/<dev>` in muster-box-init, so its git state is the hub's
			# CURRENT dev however old the golden is — "a fresher base" was simply untrue.
			#
			# What an old golden costs is COPY-UP. The checkout rewrites every file that differs between
			# the golden's commit and dev, and each rewrite copies that file out of the shared lower
			# layer into the box's own upper one: paid per box, in disk, for files that would otherwise
			# be shared by all of them. The same files are what invalidates the prepared build the
			# golden carries (GOLDEN_PREP_CMD), so the first build in each box redoes that much work.
			#
			# The size is the files' size AT DEV, which is what lands in the upper layer. Skipped past a
			# few thousand files: this renders on every dashboard repaint, and a number nobody reads is
			# not worth a second of git.
			local gfiles gbytes gnote gid gboxes gd
			gfiles="$(git_ diff --name-only "${gsha}..${DEV}" 2>/dev/null | grep -c . || true)"
			gnote=""
			# How many boxes sit on this golden — running or stopped, since a killed box keeps its
			# directory and its upper layer with it. Counted from the box dirs rather than the broker so
			# the dashboard needs no extra request per repaint.
			gid="$(printf '%s' "$gprov" | awk '{print $1}')"
			gboxes=0
			if [ -n "$gid" ] && [ -d "$BOXES" ]; then
				for gd in "$BOXES"/*/golden; do
					[ -f "$gd" ] || continue
					[ "$(cat "$gd" 2>/dev/null)" = "$gid" ] && gboxes=$((gboxes + 1))
				done
			fi
			if [ "${gfiles:-0}" -gt 0 ] 2>/dev/null; then
				gnote="$gfiles file(s)"
				if [ "$gfiles" -le 3000 ]; then
					# `git -C "$REPO"`, not the git_ helper: xargs execs a PROGRAM, and git_ is a shell
					# function — it fails with "No such file or directory" and takes the status with it.
					gbytes="$(git_ diff --name-only -z "${gsha}..${DEV}" 2>/dev/null \
						| xargs -0 -r git -C "$REPO" ls-tree -r -l "$DEV" -- 2>/dev/null \
						| awk '{s += $4} END {printf "%d", s + 0}')"
					[ -n "$gbytes" ] && [ "$gbytes" != 0 ] && gnote="$gnote / $(human_size "$gbytes")"
				fi
				gnote=" — each new box copies up $gnote of changed files instead of sharing them, and redoes that much of the golden's prepared build"
				# …times the boxes on it. UP TO, not exactly: a box that spawned while this golden was
				# younger copied up the smaller diff of that moment, and none of it is refunded by a
				# snapshot — moving a box keeps its upper layer. It is the scale of what is duplicated
				# across their upper layers, which is the number worth knowing before deciding.
				if [ "$gboxes" -gt 0 ] && [ -n "$gbytes" ] && [ "$gbytes" != 0 ]; then
					gnote="$gnote; $gboxes box(es) sit on it, so up to $(human_size "$((gbytes * gboxes))") is duplicated across their upper layers"
				elif [ "$gboxes" -gt 0 ]; then
					gnote="$gnote; $gboxes box(es) sit on it"
				fi
			fi
			printf '  %s(%s commit(s) behind %s%s)%s\n' \
				"$C_YEL" "$gbehind" "$DEV" "$gnote" "$C_RESET"
		elif [ -z "$gbehind" ] && [ -n "$gsha" ] && ! git_ merge-base --is-ancestor "$DEV" "$gsha" 2>/dev/null; then
			# The recorded commit is not in this repo any more (history rewritten, or a golden from
			# another clone). Say the thing we still know rather than a number we would be inventing.
			# Same correction as above, for the case where the recorded commit is not in this repo any
			# more so the cost cannot be measured: a snapshot changes what boxes SHARE, not what they
			# check out.
			printf '  %s(%s has moved since — a snapshot would cut what each new box copies up)%s\n' \
				"$C_YEL" "$DEV" "$C_RESET"
		fi
	fi

	hdr next
	if [ "${#todo[@]}" -eq 0 ]; then
		[ "$ahead" != 0 ] && todo_line "$SELF push                # $ahead commit(s) to origin" \
			|| printf '  %s(nothing to do)%s\n' "$C_DIM" "$C_RESET"
	else
		for row in "${todo[@]}"; do todo_line "$row"; done
		[ "$ahead" != 0 ] && [ "$behind" = 0 ] && todo_line "$SELF push                # $ahead commit(s) to origin"
	fi
	return 0
}

# One "next" entry: the command in green (it is meant to be copied), the trailing "# why" dimmed so
# the column of commands stays scannable.
todo_line() {
	local t="$1" cmd why
	case "$t" in
		*'#'*) cmd="${t%%#*}"; why="#${t#*#}" ;;
		*)     cmd="$t"; why="" ;;
	esac
	cmd="${cmd%"${cmd##*[![:space:]]}"}"
	printf '  %s▸%s %s%s%s%s\n' "$C_DIM" "$C_RESET" "$C_GRN" "$cmd" "$C_RESET" \
		"${why:+ $C_DIM$why$C_RESET}"
}

# ------------------------------------------------------------------ live watch (`$SELF q`)
#
# Repaints status_overview on an interval and RINGS THE TERMINAL BELL on the two things worth
# looking up from what you were doing:
#   * an agent stopped working (busy -> anything else — 'waiting' means it is asking YOU something)
#   * a handoff landed or was updated: refs/agents/<box> appeared or moved = a review request
# The bell is a bare BEL byte on stdout, so it rides the `docker exec -it` + `ssh -t` PTY straight to
# your laptop's terminal — no notification daemon anywhere in the chain, works over the laptop alias.
#
# Everything here is polled, never pushed: the box activity file and the agent refs are both local
# reads on the hub, so a short interval is cheap. The ONE network call in a frame is the origin fetch
# in status_overview, which is throttled to $WATCH_FETCH (the rest of the frames pass --no-fetch).
WATCH_INTERVAL="${MUSTER_WATCH_INTERVAL:-5}"
WATCH_FETCH="${MUSTER_WATCH_FETCH:-60}"
WATCH_EVENTS=()
WATCH_RING=0

# watch_event <colour> <text…>. The colour is stored WITH the event rather than applied at print
# time, because only the caller knows whether "box stopped working" was a handoff (good) or a box
# that quietly went idle on you (not).
watch_event() {
	local color="$1"; shift
	WATCH_EVENTS+=("$(date +%H:%M:%S)"$'\t'"$color"$'\t'"$*")
	# Keep the tail only: the frame has to fit on a screen, and old events are scrollback, not state.
	[ "${#WATCH_EVENTS[@]}" -le 8 ] || WATCH_EVENTS=("${WATCH_EVENTS[@]: -8}")
	WATCH_RING=1
}

# "<box> <state>" per running box — what status_overview reads, without the rendering.
activity_snapshot() {
	local resp box st age
	resp="$(broker GET /box 2>/dev/null || true)"
	[ -n "$resp" ] || return 0
	for box in $(printf '%s' "$resp" | jqr '.boxes[]?.box'); do
		read -r st age <<< "$(box_activity "$box")"
		printf '%s %s\n' "$box" "$st"
	done
	return 0
}

# "<box> <sha>" per pushed agent branch. The sha (not the review status) is the trigger: it moves
# exactly once per handoff, whereas the status also flips when YOU review, which is not news.
ref_snapshot() {
	local box
	for box in $(agent_refs); do
		printf '%s %s\n' "$box" "$(git_ rev-parse "refs/agents/$box")"
	done
	return 0
}

watch_queue() {
	local interval="$WATCH_INTERVAL" bell=1 key frame fa hint now fetched=0 first=1
	local box st prev sha clock pad ev ets ecol emsg
	local -A act=() ref=() now_act=() now_ref=()
	while [ $# -gt 0 ]; do
		case "$1" in
			-n|--interval)  shift; interval="${1:-}" ;;
			-n*)            interval="${1#-n}" ;;
			--interval=*)   interval="${1#*=}" ;;
			--no-bell)      bell=0 ;;
			*) die "q: unknown option '$1' (--text | -n SECS | --no-bell)" ;;
		esac
		shift
	done
	case "$interval" in ''|*[!0-9]*) die "q: -n wants whole seconds (e.g. $SELF q -n 10)" ;; esac
	[ "$interval" -ge 1 ] || die "q: -n must be at least 1 second"
	# Nothing to watch when the output is a pipe or a file — repainting would just append frames
	# forever. Options are still parsed above, so a typo is an error either way.
	[ -t 1 ] || { queue; return 0; }
	# We KNOW stdout is a terminal here, and the frame is rendered through a command substitution
	# where nothing downstream could work that out — so decide colour and width once, up here, and
	# let status_overview inherit both.
	colors_init "${MUSTER_COLOR:-always}"

	while :; do
		# Re-read every frame: the window can be resized between repaints, and a stale width would
		# either wrap the table or leave a ragged right margin until the next restart.
		MUSTER_COLS="$(tput cols 2>/dev/null || echo 100)"
		case "$MUSTER_COLS" in ''|*[!0-9]*) MUSTER_COLS=100 ;; esac
		[ "$MUSTER_COLS" -ge 60 ] || MUSTER_COLS=100
		now_act=(); now_ref=()
		while read -r box st;  do [ -n "$box" ] && now_act["$box"]="$st"; done < <(activity_snapshot)
		while read -r box sha; do [ -n "$box" ] && now_ref["$box"]="$sha"; done < <(ref_snapshot)

		# The first frame establishes the baseline: without this every box you are ALREADY watching
		# would ring on startup, which trains you to ignore the bell.
		if [ "$first" = 0 ]; then
			for box in "${!now_act[@]}"; do
				st="${now_act[$box]}"; prev="${act[$box]-}"
				if [ "$prev" = busy ] && [ "$st" != busy ]; then
					if [ "$st" = waiting ]; then
						watch_event "$C_B$C_MAG" "$box stopped working and is ASKING YOU something  (<prefix>box $box)"
					else
						watch_event "$C_YEL" "$box stopped working — now $st  ($SELF q / cbxbox $box)"
					fi
				elif [ "$prev" != waiting ] && [ -n "$prev" ] && [ "$st" = waiting ]; then
					watch_event "$C_B$C_MAG" "$box wants your input  (cbxbox $box)"
				fi
			done
			for box in "${!now_ref[@]}"; do
				if [ -z "${ref[$box]-}" ]; then
					watch_event "$C_B$C_GRN" "$box HANDED OFF — review request  ($SELF review $box)"
				elif [ "${ref[$box]}" != "${now_ref[$box]}" ]; then
					watch_event "$C_GRN" "$box pushed again — re-review  ($SELF review $box)"
				fi
			done
		fi
		act=(); ref=()
		for box in "${!now_act[@]}"; do act["$box"]="${now_act[$box]}"; done
		for box in "${!now_ref[@]}"; do ref["$box"]="${now_ref[$box]}"; done

		now="$(date +%s)"
		if [ "$((now - fetched))" -ge "$WATCH_FETCH" ]; then fetched="$now"; fa=""; else fa=--no-fetch; fi
		# Render into a variable first, then clear + print in one go: a frame built directly onto the
		# screen flickers for as long as the git plumbing takes, which is most of the interval.
		frame="$(status_overview ${fa:+"$fa"} 2>&1)" || true

		hint="refresh ${interval}s · Enter now · q quits"
		[ "$bell" = 1 ] || hint="$hint · bell OFF"
		clock="$(date +%H:%M:%S)"
		# Title bar: name + hints on the left, clock hard against the right margin. The pad is computed
		# from the PLAIN text (15 = " $SELF q · live " plus the space before the hint), never from the
		# printed string — that one carries attribute bytes that occupy no columns.
		pad=$(( MUSTER_COLS - ${#hint} - ${#clock} - 15 ))
		[ "$pad" -ge 1 ] || pad=1
		printf '\033[H\033[2J'
		printf '%s $SELF q · live %s %s%s%s%*s%s%s%s\n\n' \
			"$C_B$C_CYA" "$C_RESET" "$C_DIM" "$hint" "$C_RESET" "$pad" "" "$C_B" "$clock" "$C_RESET"
		printf '%s\n' "$frame"
		if [ "${#WATCH_EVENTS[@]}" -gt 0 ]; then
			hdr "while you were watching"
			for ev in "${WATCH_EVENTS[@]}"; do
				IFS=$'\t' read -r ets ecol emsg <<< "$ev"
				printf '  %s%s%s  %s%s%s\n' "$C_DIM" "$ets" "$C_RESET" "$ecol" "$emsg" "$C_RESET"
			done
		fi
		if [ "$WATCH_RING" = 1 ] && [ "$bell" = 1 ]; then printf '\a'; fi
		WATCH_RING=0
		first=0

		# read doubles as the sleep, so a keypress lands within milliseconds instead of at the end of
		# the interval. Timeout returns non-zero — harmless here, `if` disarms errexit.
		if [ -t 0 ]; then
			if read -rsn1 -t "$interval" key; then
				case "$key" in q|Q) echo; echo "$SELF: stopped watching."; return 0 ;; esac
			fi
		else
			sleep "$interval"
		fi
	done
}

# ---- the review TUI (tuicr) ------------------------------------------------------------------
#
# `$SELF review` opens $REVIEW_TUI on the agent's branch instead of paging a diff at you. With tuicr
# (the default) the loop closes: you leave line/range comments in the TUI, quit, and cbx reads the
# comments back out and offers to send them to the box — no retyping them into `$SELF fix -m`.
#
# The handover is tuicr's PERSISTED SESSION, not its `y`/--stdout clipboard export: the export is a
# key you have to remember to press, and --stdout writes into the same stream the TUI paints on
# (tuicr renders to stdout, alt-screen; only its "tuicr-session: <slug>" announcement goes to
# stderr). The session file is written as soon as a review target becomes active, survives the TUI
# if it holds comments, and is removed by tuicr when it does not — which is exactly the "did you
# write anything?" signal we need. So: capture the slug from stderr, read the comments as JSON
# afterwards, and delete the session once it has been sent.

have_tui() { [ -n "$REVIEW_TUI" ] && command -v "${REVIEW_TUI%% *}" >/dev/null 2>&1; }
# Only tuicr's comments can be harvested; any other MUSTER_REVIEW_TUI is treated as a viewer.
tui_is_tuicr() { [ "$(basename "${REVIEW_TUI%% *}")" = tuicr ]; }

# Run the TUI on <range>, leaving TUI_SESSION set to tuicr's session slug (empty for anything else).
# stdout is left alone — that is where the TUI draws; only stderr is captured, so a real failure can
# be shown instead of scrolling past behind the alternate screen.
TUI_SESSION=""
run_review_tui() {
	local range="$1" cmd errf rc=0
	if [[ "$REVIEW_TUI" == *"$REVIEW_TUI_PLACEHOLDER"* ]]; then
		cmd="${REVIEW_TUI//"$REVIEW_TUI_PLACEHOLDER"/$range}"
	else cmd="$REVIEW_TUI $range"; fi
	errf="$(mktemp)"
	TUI_SESSION=""
	( cd "$REPO" && eval "$cmd" ) 2>"$errf" || rc=$?
	TUI_SESSION="$(sed -n 's/^tuicr-session: //p' "$errf" | tail -1)"
	if [ "$rc" -ne 0 ]; then
		echo "$SELF: the review TUI ('$cmd') failed:" >&2
		sed 's/^/  /' "$errf" >&2
	fi
	rm -f "$errf"
	return "$rc"
}

# Read a session's not-yet-sent comments: REVIEW_MD is the numbered markdown that goes to the agent
# (anchored with tuicr's own `path:line` / `path:start-end` locations, so it can jump to each one),
# REVIEW_IDS the comment ids behind it.
#
# ALREADY-SENT comments are filtered out through cbx's own state ($STATE/<box>.sent), not by deleting
# the session: tuicr keeps an index.json beside the session files, so removing a file under it leaves
# an entry pointing at nothing. This matters because a session is keyed by the COMMIT RANGE — review
# the same unchanged branch twice and tuicr hands back the same comments, which would otherwise be
# sent to the agent a second time. (After a fix round the sha moves, so that session is new anyway.)
REVIEW_MD=""; REVIEW_IDS=""
review_harvest() {
	local slug="$1" box="$2" json seen
	REVIEW_MD=""; REVIEW_IDS=""
	json="$(tuicr review comments --session "$slug" --repo "$REPO" 2>/dev/null || true)"
	[ -n "$json" ] || return 0
	seen="$(cat "$STATE/$box.sent" 2>/dev/null || true)"
	# `.id as $i` BEFORE the pipe: inside `$s | index(.id)` the `.` is already $s (the id list), so
	# `.id` would be looked up on an array and the whole filter would error out into "no comments".
	json="$(printf '%s' "$json" | jq -c --arg seen "$seen" \
		'($seen | split("\n")) as $s | [ .[] | select(.id as $i | ($s | index($i)) == null) ]' 2>/dev/null || true)"
	[ -n "$json" ] || return 0
	REVIEW_IDS="$(printf '%s' "$json" | jq -r '.[].id' 2>/dev/null || true)"
	REVIEW_MD="$(printf '%s' "$json" | jq -r '
		to_entries[]
		| ((.key + 1) | tostring) as $n
		| (if (.value.path == null) then "(overall)" else "`" + .value.location + "`" end) as $where
		| (if ((.value.comment_type // "none") == "none") then "" else " [" + .value.comment_type + "]" end) as $kind
		| $n + ". " + $where + $kind + " — " + (.value.content | gsub("\n"; "\n   "))
	' 2>/dev/null || true)"
}

# Newest local session that actually holds comments — the fallback when the announcement line was
# missed (an older tuicr, or a TUI that died before printing it).
review_session_guess() {
	tuicr review list --repo "$REPO" 2>/dev/null | jq -r '
		[ .[] | select(.kind == "local" and .comment_count > 0) ]
		| sort_by(.updated_at) | last | .slug // empty' 2>/dev/null || true
}

# "You have looked at this branch, up to <sha>, while $DEV was at <sha>." Drives the queue status
# (new / re-review / reviewed) and the incremental range-diff.
mark_reviewed() { printf '%s %s' "$2" "$(git_ rev-parse "$(base_of "$1")")" > "$STATE/$1.reviewed"; }

# The review TUI leaves things in the terminal's input queue: keys you typed while it was repainting,
# plus the tail of its own query/response sequences. Whatever is pending gets echoed into — and can
# outright answer — the next prompt, which is where the garbled "[m]ark / [l]eave" line comes from.
# Drop it before asking anything.
tty_flush() {
	[ -e /dev/tty ] || return 0
	# -n with a big count and -d '' (NUL): nothing short of the timeout stops it, so a partial line
	# with no trailing newline is consumed too. Timing out is the normal exit, hence `|| true`.
	read -rs -t 0.05 -n 10000 -d '' _ </dev/tty 2>/dev/null || true
	return 0
}

# THE CONFIRM STEP, and the ONLY place a TUI review becomes real. Quitting the TUI decides nothing:
# not whether the comments are sent, and not whether the review is recorded at all. That matters
# because "I opened it, looked at the first hunk and backed out" has to be indistinguishable from
# never having run `$SELF review` — otherwise the box silently leaves the 'new' queue and you lose the
# one signal that says nobody has read this yet.
review_finish() {
	local box="$1" sha="$2" slug="$3" md ids tmp ans
	if [ -z "$slug" ]; then REVIEW_MD=""; REVIEW_IDS=""; else review_harvest "$slug" "$box"; fi
	md="$REVIEW_MD"; ids="$REVIEW_IDS"
	if [ -z "$md" ]; then
		# Nothing written. Still a decision: reviewed-and-happy, or "I did not really look".
		tty_flush
		printf '$SELF: no comments. [m]ark %s reviewed  [l]eave it unreviewed ? ' "$box"
		read -r ans </dev/tty || ans=l
		case "$ans" in
			l|L) echo "$SELF: left alone — $box is still '$(box_status "$box")'." ;;
			*)   mark_reviewed "$box" "$sha"
			     echo "$SELF: reviewed up to $(git_ rev-parse --short "$sha"). Next: $SELF merge $box | $SELF fix $box -m '...' | $SELF drop $box" ;;
		esac
		return 0
	fi
	while :; do
		tty_flush
		echo
		printf '%s── feedback for %s ───────────────────────────────%s\n' "$C_B$C_CYA" "$box" "$C_RESET"
		printf '%s\n' "$md"
		printf '%s──────────────────────────────────────────────────%s\n' "$C_DIM" "$C_RESET"
		printf '[s]end to %s  [e]dit  [d]iscard ? ' "$box"
		read -r ans </dev/tty || ans=d
		# NB an EOF/read failure lands on 'd' — the option that changes nothing.
		case "$ans" in
			s|S|"")
				guard_busy "$box" || { echo "$SELF: not sent — the review is still saved, re-run '$SELF review $box'."; return 1; }
				paste_to_box "$box" "Review feedback on your handoff:

$md

Please address each point on your branch, then run: handoff" \
					|| { echo "$SELF: feedback NOT delivered — is the box running? ($SELF ls)" >&2
					     echo "$SELF: the review is still saved; re-run '$SELF review $box' to retry." >&2; return 1; }
				# Sent = consumed, recorded HERE rather than by touching tuicr's store (see review_harvest).
				if [ -n "$ids" ]; then printf '%s\n' "$ids" >> "$STATE/$box.sent"; fi
				mark_reviewed "$box" "$sha"
				echo "$SELF: sent to $box. It will push again when done ('$SELF q' shows re-review)."
				return 0
				;;
			e|E)
				tmp="$(mktemp --suffix=.md)"
				printf '%s\n' "$md" > "$tmp"
				# </dev/tty: stdin here is the terminal already, but be explicit — an editor started
				# with anything else on stdin renders to a dead terminal and hangs.
				"${EDITOR:-vim}" "$tmp" </dev/tty >/dev/tty 2>&1 || true
				md="$(cat "$tmp")"; rm -f "$tmp"
				[ -n "${md//[[:space:]]/}" ] || { echo "$SELF: emptied — nothing to send."; return 0; }
				;;
			d|D)
				# Deliberately records NOTHING: no feedback to the box and no .reviewed, so the queue
				# looks exactly as it did before you ran `$SELF review`. The comments stay in tuicr, so
				# re-running it picks the same review back up.
				echo "$SELF: nothing sent, nothing recorded — $box is still '$(box_status "$box")'."
				echo "     Your comments stay in tuicr; '$SELF review $box' picks them up again."
				echo "     To throw them away: tuicr review list --repo $REPO   (then delete that session's file)"
				return 0
				;;
			*) echo "$SELF: answer s (send), e (edit) or d (discard)." ;;
		esac
	done
}

review() {
	argsort "" "$@"; set -- ${ARGV[@]+"${ARGV[@]}"}
	[ $# -ge 1 ] || die "review needs a box name"
	local box="$1" full="" net="" plain="" tui="" arg ref sha prev
	shift
	for arg in "$@"; do
		case "$arg" in
			--full)  full=1 ;;
			--net)   net=1 ;;
			--plain) plain=1 ;;
			--tui)   tui=1 ;;
			*) die "review: unknown option '$arg' (--full | --net | --tui | --plain)" ;;
		esac
	done
	if [ -n "$plain" ] && [ -n "$tui" ]; then die "review: --tui and --plain are opposites, pick one"; fi
	ref="refs/agents/$box"
	git_ rev-parse --verify -q "$ref" >/dev/null || die "no branch pushed for '$box' (has it run handoff?)"
	sha="$(git_ rev-parse "$ref")"
	prev="$(reviewed_ref "$box")"
	mkdir -p "$STATE"

	# --- a minto box: review the RESOLUTION, not the branch ---------------------------------------
	# The useful view is the COMBINED diff (`git show --cc`): it shows only the hunks that differ from
	# BOTH parents — i.e. exactly what the agent decided, with everything it merely carried across from
	# one side or the other left out. `$DEV..$ref` (what a normal review shows) would be the entire
	# target branch, and a TUI cannot render a combined diff at all, so this path is always the pager.
	local mtgt; mtgt="$(minto_target "$box")"
	if [ -n "$mtgt" ]; then
		if [ -n "$prev" ] && [ "$prev" != "$sha" ]; then
			echo "$SELF: $box re-resolved since your last look ($(git_ rev-parse --short "$prev") -> $(git_ rev-parse --short "$sha"))."
			echo
		fi
		{
			echo "== $box: merge of $DEV into $mtgt =="
			echo "== what $mtgt is for: $(minto_field "$box" 4) =="
			echo
			if [ -n "$full" ]; then
				git_ --no-pager log --color=always $(notes_arg) -1 "$ref"
				echo
				echo "-- everything $DEV brings to $mtgt --"
				echo
				git_ diff "$mtgt...$ref"
			else
				echo "-- THE RESOLUTION: hunks that match neither side ('--full' for the whole merge) --"
				echo
				# --cc, not -m: -m prints one full diff per parent (the whole target branch, then the
				# whole of $DEV). --cc keeps only what the resolution itself changed.
				git_ show --cc $(notes_arg) --color=always "$ref"
			fi
		} | review_pager
		mark_reviewed "$box" "$sha"
		echo
		echo "$SELF: reviewed $(git_ rev-parse --short "$sha")."
		echo "$SELF: land it     — $SELF minto $mtgt --land $box"
		echo "$SELF: or fix it   — $SELF fix $box -m 'take the ... side in <file>, because ...'"
		echo "$SELF: or drop it  — $SELF minto $mtgt --abort"
		return 0
	fi
	# Nothing on top of $DEV: the work is already in, so there is no diff to show. Without this you get
	# an empty range-diff ("1: abc123 < -: ---------") and no hint that the way out is a merge that
	# only does bookkeeping.
	if [ "$(git_ rev-list --count "$DEV..$ref")" = 0 ]; then
		echo "$SELF: $box has nothing on top of $DEV — its work is already merged."
		echo "$SELF: nothing to review. Retire the branch and tell the box with: $SELF merge $box"
		return 0
	fi
	# A rebase rewrites every sha, so the branch looks changed even when the agent added nothing. Say
	# so up front — otherwise the range-diff below (one '=' line per carried-over commit) reads like
	# new work you have to re-read.
	if [ -n "$prev" ] && [ "$prev" != "$sha" ] && rebase_only "$box"; then
		echo "$SELF: $box was only REBASED onto a newer $DEV since your last review — same patches, new shas."
		echo "$SELF: nothing new to read; '$SELF merge $box' when ready (--full to see the branch anyway)."
		echo
	fi

	# --- viewer: the TUI, or the plain pager -----------------------------------------------------
	# "It moved since I last looked" is TWO different situations, and conflating them was a bug: a
	# re-review showed the new commits' subjects and no diffs at all.
	#
	#   ADDED    — the agent pushed MORE commits on top; your $prev is still an ancestor. The new work
	#              is exactly `$prev..$ref`, a normal commit range: the TUI handles it, and the pager
	#              shows it as an ordinary patch series.
	#   REWRITTEN — a fix round amended or rebased what you already read, so `$prev..$ref` is NOT the
	#              new work (the old commits are no longer ancestors). Only `git range-diff` can line
	#              the two versions up, and a TUI cannot render one — hence the pager.
	#
	# The old code called both "incremental" and sent both to range-diff. range-diff only prints a
	# patch for commits it can PAIR; a brand-new commit has no counterpart, so it comes out as a bare
	# "-: ------- > 3: 0bcd6e6 subject" line. For the ADDED case that is every single commit, which is
	# why the whole review rendered as a list of subjects with no file diffs anywhere.
	local incremental="" added="" use_tui=""
	if [ -n "$prev" ] && [ "$prev" != "$sha" ] && [ -z "$full" ] \
	   && git_ rev-parse --verify -q "$prev^{commit}" >/dev/null; then
		if git_ merge-base --is-ancestor "$prev" "$ref" 2>/dev/null; then added=1; else incremental=1; fi
	fi
	if [ -n "$plain" ]; then use_tui=""
	elif ! have_tui; then
		if [ -n "$tui" ]; then die "review: no review TUI on PATH (MUSTER_REVIEW_TUI='$REVIEW_TUI')"; fi
		use_tui=""
	elif [ -n "$tui" ]; then use_tui=1
	elif [ -n "$net" ]; then use_tui=""      # --net names a pager rendering (one combined diff)
	elif [ -n "$incremental" ]; then
		use_tui=""
		echo "$SELF: $box AMENDED what you already reviewed — showing the range-diff (pager)."
		echo "$SELF: '--tui' opens ${REVIEW_TUI%% *} on the whole branch instead."
		echo
	else use_tui=1
	fi

	if [ -n "$use_tui" ]; then
		# THE FORK POINT, not $DEV. A TUI's `A..B` is a two-dot DIFF (`git diff A B`), not git's
		# commit-range: point it at `$DEV..$ref` while the agent is behind and it renders everything
		# $DEV gained since the fork as REMOVED by the agent — a one-commit branch showed up as 309
		# changed files. Diffing from the merge base is what `git diff $DEV...$ref` (and every code
		# review UI) shows: what this branch ADDS, independent of how far $DEV has moved. The two are
		# identical when the branch is up to date, so this only ever removes noise.
		local base rc=0 slug
		base="$(git_ merge-base "$DEV" "$ref" 2>/dev/null || true)"
		[ -n "$base" ] || base="$DEV"      # unrelated histories: nothing better to offer
		# Only the commits added since your last review, when that is what this is — the TUI's own
		# range, so its comments anchor to the new work instead of the whole branch again.
		if [ -n "$added" ]; then
			base="$prev"
			echo "$SELF: $box added $(git_ rev-list --count "$prev..$ref") commit(s) since your last review — showing just those ('--full' for the branch)."
			echo
		fi
		run_review_tui "$base..$ref" || rc=$?
		# Interrupted (Ctrl-C, SIGHUP, the terminal going away) is NOT a broken TUI: you bailed out.
		# Fall through to neither the pager nor the confirm step, and leave the queue untouched.
		if [ "$rc" -ge 128 ]; then
			echo "$SELF: review interrupted — nothing sent, nothing recorded ($box is still '$(box_status "$box")')."
			return 0
		fi
		if [ "$rc" -eq 0 ]; then
			if tui_is_tuicr; then
				slug="$TUI_SESSION"
				[ -n "$slug" ] || slug="$(review_session_guess)"
				review_finish "$box" "$sha" "$slug"
			else
				# A viewer with no comments to harvest: nothing to confirm, so record it like the pager.
				mark_reviewed "$box" "$sha"
				echo "$SELF: reviewed up to $(git_ rev-parse --short "$sha"). Next: $SELF fix $box -m '...' | $SELF merge $box | $SELF drop $box"
			fi
			return 0
		fi
		echo "$SELF: falling back to the plain pager." >&2
		echo >&2
	fi

	# Everything goes through ONE pager. Printing the log first and then piping a diff to delta would
	# lose the log: delta pages on the alternate screen and paints straight over it.
	{
		echo "== $box: $(git_ rev-list --count "$DEV..$ref") commit(s) on top of $DEV =="
		echo
		if [ -n "$added" ]; then
			# The agent pushed MORE commits on top of what you read. `$prev..$ref` IS the new work, so
			# show it the way the default view shows a branch: every new commit with its own message,
			# notes and full patch. (A range-diff here would print one subject line per commit and no
			# diff at all — see the ADDED/REWRITTEN split above.)
			git_ log --color=always $(notes_arg) "$DEV..$ref"
			echo
			echo "-- the $(git_ rev-list --count "$prev..$ref") commit(s) added since your last review ($(git_ rev-parse --short "$prev")); --full for the whole branch --"
			echo
			git_ log --color=always $(notes_arg) --reverse --patch --stat "$prev..$ref"
		elif [ -n "$incremental" ]; then
			# Re-review after a fix round REWROTE what you read (amend/rebase): only range-diff can line
			# the old and new versions up. Keep the plain commit list above it, since range-diff shows
			# subjects but not messages or notes.
			git_ log --color=always $(notes_arg) "$DEV..$ref"
			echo
			echo "-- what changed in the commits you already reviewed ($(git_ rev-parse --short "$prev")); --full for the whole branch --"
			echo
			# --color=always because delta does NOT understand range-diff (its inner diff is indented by
			# four spaces and carries a second +/- column, so delta passes every line through verbatim).
			# Without this, git sees a pipe, drops its own colouring, and the whole range-diff comes out
			# as flat grey text. git's dual-colour range-diff survives delta untouched.
			git_ range-diff --color=always "$DEV..$prev" "$DEV..$ref"
		elif [ -n "$net" ]; then
			# The branch's NET effect, as it will land: one combined diff, no per-commit split.
			git_ log --color=always $(notes_arg) "$DEV..$ref"
			echo
			git_ diff "$DEV...$ref"
		else
			# Default: each commit with ITS OWN message, notes and diff, oldest first — so a branch with
			# several commits reads as a sequence of changes instead of one merged blob you can't
			# attribute. `--net` gives the combined diff when you want the end state instead.
			git_ log --color=always $(notes_arg) --reverse --patch --stat "$DEV..$ref"
		fi
	} | review_pager

	# The pager has nothing to confirm, so it still records on exit (unchanged behaviour). Only the
	# TUI path asks first — that is where "I opened it and backed out" is a thing that happens.
	mark_reviewed "$box" "$sha"
	echo
	echo "$SELF: reviewed up to $(git_ rev-parse --short "$sha"). Next: $SELF fix $box -m '...' | $SELF merge $box | $SELF drop $box"
}

fix() {
	[ $# -ge 1 ] || die "fix needs a box name"
	local box="$1" msg="" force="" a args=()
	shift
	for a in "$@"; do
		case "$a" in --force) force=--force ;; *) args+=("$a") ;; esac
	done
	set -- "${args[@]+"${args[@]}"}"
	[ "${1:-}" = -m ] && { shift; msg="$*"; } || msg="$*"
	[ -n "$msg" ] || die "fix needs a message: $SELF fix $box -m 'what to change'"
	guard_busy "$box" "$force" || exit 1
	say_to_box "$box" "Review feedback on your handoff: ${msg}. Please fix it on your branch, then run: handoff" \
		|| die "feedback NOT delivered — is the box running? ($SELF ls)"
	echo "$SELF: sent to $box. It will push again when done ('$SELF q' shows re-review)."
}

prereview() {
	[ $# -ge 1 ] || die "prereview needs a box name"
	guard_busy "$1" "${2:-}" || exit 1
	# Cheap capacity multiplier: the agent re-reads its OWN diff critically before you spend a round on
	# it. This is self-review, not an independent reviewer — see README-remote.md for the difference.
	say_to_box "$1" "Before I review this: run 'mydiff' and read your own change critically against the project's conventions in CLAUDE.md — dead code, missing tests, unhandled errors, anything you would flag in someone else's PR. Fix what you find, then run: handoff"
	echo "$SELF: asked $1 to self-review and re-hand off."
}

# ---- looking at what an agent is looking at (pinchtab) ---------------------------------------
#
# Every box creates its own pinchtab session at boot (box-bin/muster-pinchtab-session) and pinchtab
# gives each session its own dedicated browser tab. The session TOKEN is therefore the whole address:
# any request carrying it lands on that box's current tab, with no tab id to look up and nothing to
# keep in step. The box writes it into its home, which the hub mounts read-only — the same channel
# the activity hooks use.
PT_URL="${PINCHTAB_SERVER:-http://127.0.0.1:9867}"

# One JSON string, quoted and escaped by jq rather than by hand — a reason with a quote or a newline in
# it would otherwise produce a body the server rejects, which reads as "hold is broken".
json_str() { printf '%s' "$1" | jq -Rs .; }

# RETURNS, does not die. Both callers below read it through $( ), and a `die` in there kills only the
# subshell: the message prints, the status is swallowed by the assignment, and the command carries on
# to capture somebody else's tab. Hence the explicit `|| return 1` at every call site.
box_pt_token() {
	local f="$BOXES/$1/home/.muster-pinchtab-session" tok
	tok="$(cat "$f" 2>/dev/null || true)"
	if [ -z "$tok" ]; then
		echo "$SELF: box '$1' has no pinchtab session yet ($f is empty or missing).
     It is created when the box starts and needs the server up: $SELF up pinchtab, then in the box
     run 'muster-pinchtab-session'. A box that has never browsed has nothing to look at either." >&2
		return 1
	fi
	printf '%s' "$tok"
}

# The CLI, as the box. Everything the box could run, run from here against the same tab.
pt_cli() {
	local box="$1" tok; shift
	tok="$(box_pt_token "$box")" || return 1
	PINCHTAB_SESSION="$tok" pinchtab "$@"
}

# The HTTP API, as the box. Used where the CLI would need a tab id we deliberately do not track:
# `pinchtab tab handoff <id>` wants one, while the shorthand route acts on the session's CURRENT tab,
# which is exactly the tab we mean. `Authorization: Session <token>` is how a session authenticates
# (a server token would be `Bearer`, and would land on the wrong — global — current tab).
pt_api() {
	local box="$1" method="$2" path="$3" tok; shift 3
	tok="$(box_pt_token "$box")" || return 1
	curl -sS -X "$method" -H "Authorization: Session $tok" \
		-H "Content-Type: application/json" "${PT_URL}${path}" "$@"
}

# Where a capture lands when you do not say. Under $STATE so it is inside the repo's .git and gets
# cleaned with the rest of the hub's scratch state, and named per box so a second peek at the same box
# overwrites rather than accumulates.
pt_out() { mkdir -p "$STATE/peek"; printf '%s/peek/%s.png' "$STATE" "$1"; }

peek() {
	argsort "-o" "$@"; set -- ${ARGV[@]+"${ARGV[@]}"}
	[ $# -ge 1 ] || die "peek needs a box name"
	local box="$1" out="" snap="" full="" a; shift
	for a in "$@"; do
		case "$a" in
			--snap|--text) snap=1 ;;
			--full)        full=--beyond-viewport ;;
			-o)            ;;                      # its value follows, handled below
			-*)            die "peek: unknown option '$a' (--snap | --full | -o FILE)" ;;
			*)             out="$a" ;;
		esac
	done
	# The accessibility tree, not the picture: it is literally the text the agent reasons over, so when
	# an agent "doesn't get it" this is more often the answer than a screenshot is.
	if [ -n "$snap" ]; then
		pt_cli "$box" snap || exit 1
		return
	fi
	[ -n "$out" ] || out="$(pt_out "$box")"
	pt_cli "$box" screenshot -o "$out" ${full:+$full} >/dev/null \
		|| die "could not capture box '$box' — has it opened a page yet? ($SELF peek $box --snap shows the tree)"
	echo "$out"
}

point() {
	argsort "-o --selector" "$@"; set -- ${ARGV[@]+"${ARGV[@]}"}
	[ $# -ge 1 ] || die "point needs a box name"
	local box="$1" out="" sel="" clear="" a want=""; shift
	for a in "$@"; do
		case "$want" in o) out="$a"; want=""; continue ;; s) sel="$a"; want=""; continue ;; esac
		case "$a" in
			--clear)     clear=1 ;;
			-o)          want=o ;;
			--selector)  want=s ;;
			-*)          die "point: unknown option '$a' (--selector CSS | --clear | -o FILE)" ;;
			*)           out="$a" ;;
		esac
	done
	if [ -n "$clear" ]; then
		pt_cli "$box" annotate --clear >/dev/null && echo "$SELF: overlay cleared in box '$box'."
		return
	fi
	# The overlay is injected into the live DOM, so it is in the screenshot — which is the point here.
	# Nobody can click a headless browser, but nobody needs to: the labels are readable in the image and
	# the refs are the AGENT'S OWN, because this is the agent's own tab. Annotating a browser on your
	# laptop would give you refs that mean nothing to it.
	pt_cli "$box" annotate ${sel:+--selector "$sel"} >/dev/null \
		|| die "could not annotate box '$box' — has it opened a page yet?"
	[ -n "$out" ] || out="$(pt_out "$box")"
	pt_cli "$box" screenshot -o "$out" >/dev/null || die "annotated, but the screenshot failed"
	echo "$out"
	echo "$SELF: labels are that box's own refs — '$SELF say $box \"the misaligned one is e5\"' means something to it."
}

hold() {
	argsort "--reason --timeout" "$@"; set -- ${ARGV[@]+"${ARGV[@]}"}
	[ $# -ge 1 ] || die "hold needs a box name"
	local box="$1" reason="you are setting the page up" secs=600 a want=""; shift
	for a in "$@"; do
		case "$want" in r) reason="$a"; want=""; continue ;; t) secs="$a"; want=""; continue ;; esac
		case "$a" in
			--reason)  want=r ;;
			--timeout) want=t ;;
			*)         die "hold: unknown option '$a' (--reason TEXT | --timeout SECS)" ;;
		esac
	done
	case "$secs" in ''|*[!0-9]*) die "hold: --timeout wants whole seconds" ;; esac
	# A TIMEOUT ALWAYS. A tab left paused rejects the agent's every browser action, and an agent that
	# cannot browse does not stop — it concludes the page is broken and works around it. Ten minutes of
	# that is a nuisance; forever is a box you have to remember to release.
	pt_api "$box" POST /handoff \
		--data "$(printf '{"reason":%s,"timeoutMs":%s}' "$(json_str "$reason")" "$((secs * 1000))")" >/dev/null \
		|| die "could not pause box '$box's tab"
	echo "$SELF: box '$box's tab is PAUSED for up to ${secs}s — its browser actions now fail with"
	echo "     409 tab_paused_handoff. Drive the tab yourself, then: $SELF release $box"
}

release() {
	[ $# -ge 1 ] || die "release needs a box name"
	pt_api "$1" POST /resume --data '{"status":"completed"}' >/dev/null \
		|| die "could not resume box '$1's tab"
	echo "$SELF: box '$1's tab is live again."
	say_to_box "$1" "I paused your browser tab to set a page up and have now released it. Re-snapshot before you act on anything you saw earlier — the page has changed under you." 2>/dev/null || true
}

# Plain delivery into a box's claude, with none of fix()'s review framing. `fix` says "review feedback
# … then run: handoff", which is wrong for pointing at something mid-task and would send an agent off
# to hand off work it has not finished.
say() {
	[ $# -ge 1 ] || die "say needs a box name"
	local box="$1"; shift
	[ "${1:-}" = -m ] && shift
	local msg="$*"
	[ -n "$msg" ] || die "say needs a message: $SELF say $box \"look at the header on /en/logbook\""
	say_to_box "$box" "$msg" || die "not delivered — is the box running? ($SELF ls)"
	echo "$SELF: delivered to '$box'."
}

# Everything that has to happen once an agent's work is IN $DEV: retire the ref, clear the review
# state, tell the box, and say whether origin still needs it.
#
# This is a separate function because the CONFLICT path leaves merge() through `die`. You then resolve
# in the hub's repo and commit — the work has landed, but the ref and the '.reviewed' state are still
# sitting there, so `$SELF q` goes on offering `$SELF merge <box>` forever and the merge itself now says
# "nothing was merged" every time. That dead end is what this closes.
merge_finish() {
	local box="$1" ref="refs/agents/$box" mstate mage after_rebase resume_note fbehind fahead
	git_ update-ref -d "$ref" 2>/dev/null || true
	# .sent goes with it: the branch this box will push next is a new review from scratch. Same for any
	# --reword messages: they are keyed to commits that have now landed.
	rm -f "$STATE/$box.reviewed" "$STATE/$box.sent"
	rm -rf "$(reword_dir "$box")"
	echo "$SELF: dropped refs/agents/$box (merged)"
	# The agent is still sitting on the now-merged branch; move it onto the new dev so its next piece
	# of work starts from what you just landed.
	#
	# What it should do AFTER the rebase is decided HERE, from the box's activity — not left to the
	# agent to infer. The old wording ("then continue with the next task") told an agent that had
	# already finished and gone idle to find itself something to do, and one duly picked an unrelated
	# piece of work out of the repo and started on it. An agent cannot reliably tell whether it was
	# mid-task when a line was typed into its prompt; cbx can, from .cbx-state.
	read -r mstate mage <<< "$(box_activity "$box")"
	if [ "$mstate" = busy ]; then
		after_rebase="Then go straight back to the task you were already working on and finish that. Do NOT start, plan, or pick up any other work."
		resume_note="and resume the task it was on"
	else
		after_rebase="Then STOP and wait for my next instruction. There is no next task queued for you: do NOT start, plan, or pick up any other work, and do not look for something to do."
		resume_note="and then wait for instructions"
	fi
	if say_to_box "$box" "Your work was merged into ${DEV}. Run exactly: git fetch hub && git rebase hub/${DEV} — that only replays the commits you have already made onto the merged ${DEV}. It is NOT a request for new changes, and nothing in the merge needs fixing. $(rebase_dirty_note)${after_rebase}"; then
		echo "$SELF: asked $box to rebase onto $DEV $resume_note"
	else
		echo "$SELF: (box $box not reachable — rebase it later with '$SELF rebase $box')"
	fi
	# Not a blanket "NOT pushed yet": when you finished the merge by hand you may well have pushed
	# already, and being told to push again is how you end up wondering which of the two is true.
	read -r fbehind fahead <<< "$(divergence)"
	if [ "$fahead" != 0 ]; then
		echo "$SELF: $fahead commit(s) on $DEV are not on origin yet. Run: $SELF push"
	else
		echo "$SELF: origin already has $DEV — nothing left to push."
	fi
}

# ------------------------------------------------------------------ reword (`$SELF merge --reword`)
#
# Agents write serviceable commit messages, not the ones you want in the history of $DEV. `--squash
# --edit` collapses the branch into one commit you can word yourself, but that throws the structure
# away: a branch that is genuinely three changes should land as three commits. --reword keeps every
# commit and lets you rewrite each message, then lands them with the normal merge.
#
# Edits are kept per commit sha under $STATE/reword/<box>/, so an interrupted session (or a `q` you
# regret) is not lost — re-run and they are still there. They are keyed by the ORIGINAL sha, so if the
# agent pushes again in the meantime the stale ones simply stop matching and are ignored.
reword_dir() { printf '%s/reword/%s' "$STATE" "$1"; }

# The message you will land for a commit: your edited version if there is one, else the agent's.
reword_msg() {
	local box="$1" c="$2" f
	f="$(reword_dir "$box")/$c"
	if [ -s "$f" ]; then cat "$f"; else git_ log -1 --format=%B "$c"; fi
}

# The little editor loop. Lists the commits, lets you edit any of them (repeatedly, in any order),
# shows a diff on demand, and only rewrites anything once you confirm. Returns 0 with REWORD_TIP set
# to the new branch tip, or 1 if you backed out (in which case NOTHING has been written: the rewrite
# happens after the confirm, never as you go).
REWORD_TIP=""
reword_tui() {
	local box="$1" ref="$2" base dir c i n ans arg tmp
	local -a commits=()
	REWORD_TIP=""
	base="$(git_ merge-base "$DEV" "$ref")"
	# A MERGE inside the agent's branch cannot be reworded this way: the rewrite below replays a linear
	# chain with commit-tree, which would silently flatten it and drop one side's history. Rare (agents
	# work on their own branch), but it would be data loss disguised as a reword.
	if [ -n "$(git_ rev-list --merges "$base..$ref")" ]; then
		echo "$SELF: $box's branch contains a merge commit — --reword can only rewrite a linear chain." >&2
		die "use '$SELF merge $box --squash --edit' instead, or reword it by hand in a worktree"
	fi
	while read -r c; do commits+=("$c"); done < <(git_ rev-list --reverse "$base..$ref")
	n="${#commits[@]}"
	[ "$n" -gt 0 ] || die "nothing to reword — $box has no commits on top of $DEV"
	dir="$(reword_dir "$box")"; mkdir -p "$dir"

	while :; do
		tty_flush
		echo
		printf '%s── %s: %s commit(s) to land on %s ─────────────────%s\n' "$C_B$C_CYA" "$box" "$n" "$DEV" "$C_RESET"
		i=0
		for c in "${commits[@]}"; do
			i=$((i + 1))
			# The SUBJECT of what will actually land — your edit if you made one, marked so you can see
			# at a glance what is still the agent's wording.
			if [ -s "$dir/$c" ]; then
				printf '  %s%2d.%s %s%s%s %s%s%s\n' "$C_B" "$i" "$C_RESET" \
					"$C_DIM" "$(git_ rev-parse --short "$c")" "$C_RESET" \
					"$C_GRN" "$(head -1 "$dir/$c")" "$C_RESET"
			else
				printf '  %s%2d.%s %s%s%s %s\n' "$C_B" "$i" "$C_RESET" \
					"$C_DIM" "$(git_ rev-parse --short "$c")" "$C_RESET" \
					"$(git_ log -1 --format=%s "$c")"
			fi
		done
		printf '%s────────────────────────────────────────────────────%s\n' "$C_DIM" "$C_RESET"
		printf '%s(green = your wording)%s  [1-%s] edit  [a]ll  [d]<n> diff  [r]<n> revert  [m]erge  [q]uit ? ' \
			"$C_DIM" "$C_RESET" "$n"
		read -r ans </dev/tty || ans=q
		arg="${ans#[a-zA-Z]}"; arg="${arg# }"
		case "$ans" in
			[0-9]*) reword_one "$box" "$ans" "${commits[@]}" ;;
			a|A)
				for c in "${commits[@]}"; do reword_open "$box" "$c"; done ;;
			d*|D*)
				if [ -z "$arg" ]; then echo "$SELF: which one? e.g. 'd2'"; continue; fi
				reword_show "$box" "$arg" "${commits[@]}" ;;
			r*|R*)
				if [ -z "$arg" ]; then echo "$SELF: which one? e.g. 'r2'"; continue; fi
				reword_revert "$box" "$arg" "${commits[@]}" ;;
			m|M|"")
				REWORD_TIP="$(reword_apply "$box" "$base" "${commits[@]}")"
				return 0 ;;
			q|Q)
				echo "$SELF: not merged. Your edited messages are kept — '$SELF merge $box --reword' picks them up."
				return 1 ;;
			*) echo "$SELF: answer a number (edit that one), a (all), d<n>, r<n>, m (merge) or q (quit)." ;;
		esac
	done
}

# Open $EDITOR on one commit's message. Seeded with what will currently land, so re-editing continues
# from your own wording rather than starting from the agent's again.
reword_open() {
	local box="$1" c="$2" dir tmp
	dir="$(reword_dir "$box")"; mkdir -p "$dir"
	tmp="$(mktemp --suffix=.COMMIT_EDITMSG)"
	{
		reword_msg "$box" "$c"
		echo
		echo "# Rewording $(git_ rev-parse --short "$c") by $(git_ log -1 --format='%an' "$c")."
		echo "# Lines starting with '#' are dropped. An empty message keeps the agent's original."
		echo "#"
		git_ log -1 --format='#   %s' "$c"
		git_ show --stat --format= "$c" | sed 's/^/# /'
	} > "$tmp"
	"${EDITOR:-vim}" "$tmp" </dev/tty >/dev/tty 2>&1 || true
	# --cleanup=strip semantics, done here because nothing is committed yet: drop comment lines and
	# leading/trailing blank lines.
	local body
	body="$(grep -v '^#' "$tmp" | sed -e '/./,$!d' | tac | sed -e '/./,$!d' | tac)"
	rm -f "$tmp"
	if [ -z "${body//[[:space:]]/}" ]; then
		rm -f "$dir/$c"
		echo "$SELF: left $(git_ rev-parse --short "$c") with the agent's original message."
	else
		printf '%s\n' "$body" > "$dir/$c"
	fi
}

# Resolve "3" (or "d3"/"r3") to a commit and act on it. Kept separate so the index check — the one
# thing a typo hits — is written once.
reword_pick() {
	local sel="$1"; shift
	local -a commits=("$@")
	sel="${sel#[a-zA-Z]}"; sel="${sel# }"
	case "$sel" in ''|*[!0-9]*) return 1 ;; esac
	[ "$sel" -ge 1 ] && [ "$sel" -le "${#commits[@]}" ] || return 1
	printf '%s' "${commits[$((sel - 1))]}"
}

reword_one() {
	local box="$1" sel="$2"; shift 2
	local c; c="$(reword_pick "$sel" "$@")" || { echo "$SELF: no commit $sel (1-$#)."; return 0; }
	reword_open "$box" "$c"
}

reword_show() {
	local box="$1" sel="$2"; shift 2
	local c; c="$(reword_pick "$sel" "$@")" || { echo "$SELF: no commit $sel (1-$#)."; return 0; }
	git_ show --color=always "$c" | review_pager
}

reword_revert() {
	local box="$1" sel="$2"; shift 2
	local c; c="$(reword_pick "$sel" "$@")" || { echo "$SELF: no commit $sel (1-$#)."; return 0; }
	rm -f "$(reword_dir "$box")/$c"
	echo "$SELF: $(git_ rev-parse --short "$c") is back to the agent's own message."
}

# Replay the chain with the new messages. Object-store only (commit-tree), like `$SELF minto`: each new
# commit keeps its original TREE — so the code that lands is byte-for-byte what you reviewed — and its
# original AUTHOR and author date. Only the message and the parent change. Prints the new tip.
reword_apply() {
	local box="$1" parent="$2"; shift 2
	local c new
	for c in "$@"; do
		new="$(GIT_AUTHOR_NAME="$(git_ log -1 --format=%an "$c")" \
		       GIT_AUTHOR_EMAIL="$(git_ log -1 --format=%ae "$c")" \
		       GIT_AUTHOR_DATE="$(git_ log -1 --format=%aD "$c")" \
		       git -C "$REPO" commit-tree "$c^{tree}" -p "$parent" -F <(reword_msg "$box" "$c"))"
		parent="$new"
	done
	printf '%s' "$parent"
}

merge() {
	argsort "" "$@"; set -- ${ARGV[@]+"${ARGV[@]}"}
	[ $# -ge 1 ] || die "merge needs a box name"
	local box="$1" squash="" edit="" single="" landed="" reword="" undo="" a ref msg mref mref_probe
	shift
	for a in "$@"; do
		case "$a" in
			--squash) squash=1 ;;
			--edit|-e) edit=1 ;;
			--reword|-r) reword=1 ;;
			--landed) landed=1 ;;
			--undo) undo=1 ;;
			*) die "merge: unknown option '$a' (--squash | --edit | --reword | --landed | --undo)" ;;
		esac
	done
	# Before the "did this box push anything" check below: undoing is precisely the case where the ref
	# is gone, because merging deleted it.
	[ -z "$undo" ] || { merge_undo "$box"; return; }
	[ -z "$reword" ] || [ -z "$squash" ] \
		|| die "merge: --reword and --squash are opposites — --squash makes ONE commit, --reword keeps them all"
	ref="refs/agents/$box"; mref_probe="$ref"
	git_ rev-parse --verify -q "$ref" >/dev/null || die "no branch pushed for '$box'"

	# A minto box's branch is <target> plus a merge commit. Merging that into $DEV would not land a fix
	# — it would drag the entire target branch's history into $DEV, which is the one genuinely
	# destructive mistake available in this workflow. Refuse, and name the command that is meant.
	local mtgt; mtgt="$(minto_target "$box")"
	if [ -n "$mtgt" ]; then
		echo "$SELF: '$box' is resolving a merge of $DEV INTO $mtgt — it does not belong in $DEV." >&2
		echo "$SELF: merging it here would pull all of $mtgt's history into $DEV." >&2
		echo "$SELF: review it — $SELF review $box" >&2
		echo "$SELF: land it   — $SELF minto $mtgt --land $box" >&2
		echo "$SELF: drop it   — $SELF minto $mtgt --abort" >&2
		die "refusing to merge a minto box into $DEV"
	fi

	# A conflict from an earlier attempt that is still unresolved. Merging again just re-conflicts on
	# top of it, and closing the box out would strand the mess in the hub's worktree — so stop here
	# and name both ways out. Unmerged index entries are the reliable signal: `--squash` leaves the
	# index conflicted without ever writing MERGE_HEAD, so checking for that file alone misses half
	# the cases.
	if [ -n "$(git_ ls-files -u | head -1)" ]; then
		echo "$SELF: $REPO still has UNRESOLVED conflicts from an earlier merge:" >&2
		git_ diff --name-only --diff-filter=U | sed 's/^/    /' >&2
		echo "$SELF: finish it   — resolve them, 'git add' + 'git commit', then: $SELF merge $box${squash:+ --landed}" >&2
		echo "$SELF: or drop it  — git -C $REPO merge --abort   (then '$SELF merge $box' from scratch)" >&2
		die "refusing to merge on top of an unfinished merge"
	fi

	# Already in $DEV? Then the merge happened — most likely you resolved a conflicted one by hand.
	# Close the books instead of running a merge that can only say "nothing was merged". Checked
	# BEFORE the stale-origin refusal below, so a moved origin can't trap you in this state.
	if git_ merge-base --is-ancestor "$ref" "$DEV" 2>/dev/null; then
		echo "$SELF: refs/agents/$box is already contained in $DEV — nothing to merge."
		echo "$SELF: closing it out (this is the state a conflicted merge leaves behind once you commit the fix)."
		merge_finish "$box"
		return 0
	fi
	# The same situation, but where git CANNOT see it: you resolved the conflict with a squash or a
	# hand-written commit, so the content landed while the agent's commits are not ancestors of $DEV.
	# Nothing can prove that from the graph, so it is an explicit assertion by you.
	if [ -n "$landed" ]; then
		echo "$SELF: --landed: taking your word that $box's work is already in $DEV, and closing it out."
		echo "$SELF: (its commits are NOT ancestors of $DEV — expected after a squash or a hand-written fix.)"
		merge_finish "$box"
		return 0
	fi
	# The hub tree is EXPECTED to carry local setup work (it's what goldens are snapshotted from), so a
	# dirty tree is not an error here. Just show it and let git decide: it refuses precisely when the
	# merge would overwrite a file you've modified, which is the only case that actually matters.
	if [ -n "$(git_ status --porcelain)" ]; then
		echo "$SELF: note — local changes in $REPO (kept; the merge aborts only if it would overwrite one):" >&2
		git_ status --short | sed 's/^/  /' >&2
	fi
	# WOULD IT CONFLICT? Ask before touching anything, because the alternative is finding out by being
	# left in a half-merged worktree — and the usual answer at that point is "abort and rebase first",
	# which is a thing to decide BEFORE the mess rather than after it. merge-tree computes the merge in
	# the object store, so this costs nothing and changes nothing.
	local conf_files
	conf_files="$(conflicts_between "$DEV" "$mref_probe")"
	if [ -n "$conf_files" ]; then
		echo "$SELF: merging '$box' into $DEV would CONFLICT in:" >&2
		printf '  %s\n' $conf_files >&2
		# Not a terminal (a script, a pipe): say it and carry on. The merge itself stops safely on the
		# conflict, so refusing here would break every non-interactive caller for no extra safety.
		if [ ! -t 0 ]; then
			echo "$SELF: not a terminal — merging anyway; git will stop on the conflict." >&2
		else
			tty_flush
			printf '%s: [r]ebase the agent first  [m]erge anyway  [q]uit ? ' "$SELF" > /dev/tty
			local answer=""; read -r answer < /dev/tty || answer=q
			case "$answer" in
				r|R)
					echo "$SELF: asking '$box' to rebase onto $DEV — merge again once it has handed off."
					rebase "$box"
					return 0 ;;
				m|M) echo "$SELF: merging anyway — resolve the conflict in $REPO, then: $SELF merge $box" ;;
				*)   die "not merged (nothing changed)" ;;
			esac
		fi
	fi

	msg="$(note_of "$box")"; msg="${msg:-work from agent box $box}"

	# Don't land agent work on a stale base. If origin moved (you pushed from the laptop, a colleague
	# pushed), merging here produces a merge commit on an old tip and `$SELF push` is then rejected —
	# leaving you to untangle it after the fact. Check BEFORE touching anything, and say what to do.
	local before after behind ahead
	echo "$SELF: checking $DEV against origin"
	git_ fetch -q origin "$DEV" 2>/dev/null || echo "$SELF: (could not reach origin — merging against the local $DEV)" >&2
	read -r behind ahead <<< "$(divergence)"
	if [ "$behind" != 0 ]; then
		echo "$SELF: origin/$DEV has $behind commit(s) that $DEV doesn't." >&2
		echo "$SELF: merging now would put this agent's work on a stale base and '$SELF push' would be rejected." >&2
		echo "$SELF: do this first:" >&2
		echo "    $SELF pull              # merge origin into $DEV (or: $SELF pull --rebase)" >&2
		echo "    $SELF rebase $box       # let the agent re-base its branch on the updated $DEV" >&2
		echo "    $SELF review $box       # re-check what it looks like on the new base, then merge" >&2
		die "refusing to merge onto a stale $DEV"
	fi

	local ncommits
	ncommits="$(git_ rev-list --count "$DEV..$ref")"
	echo "$SELF: merging refs/agents/$box ($ncommits commit(s)) into $DEV"

	# --reword: rewrite the messages FIRST, then merge the rewritten chain. `mref` is what gets merged;
	# `$ref` stays the agent's ref for the bookkeeping in merge_finish. The rewrite is object-store only
	# and keeps every tree, so what lands is exactly what you reviewed.
	mref="$ref"
	if [ -n "$reword" ]; then
		if [ ! -t 0 ]; then die "merge --reword needs a terminal (it opens an editor per commit)"; fi
		colors_init
		reword_tui "$box" "$ref" || return 1
		mref="$REWORD_TIP"
		[ -n "$mref" ] || die "reword produced nothing — $DEV is unchanged"
		echo "$SELF: reworded $ncommits commit(s) -> $(git_ rev-parse --short "$mref") (same trees, same authors)"
	fi
	# `--edit` on a single commit means "let me fix up that commit's message" — a merge commit wrapping
	# one commit is pure noise there, and having to remember `--squash` for it is a papercut. So take
	# the squash path and seed the editor with the agent's own message (see below).
	# ONE commit is one commit, whether or not you also typed --squash: there is nothing to summarise,
	# so you edit that commit's own message. (Without --squash this also drops the merge commit, which
	# would be pure noise around a single change.) The --squash case used to fall through to git's
	# SQUASH_MSG and hand you your own message wrapped in "Squashed commit of the following:" and
	# indented four spaces — something to clean up before you could start editing.
	if [ -n "$edit" ] && [ "$ncommits" = 1 ]; then
		[ -z "$squash" ] && echo "$SELF: one commit — landing it directly (no merge commit); its message is what you'll edit"
		squash=1 single=1
	fi
	git_ checkout -q "$DEV"
	before="$(git_ rev-parse HEAD)"
	# --edit opens an editor seeded with what the agent actually wrote, never a blank buffer — one
	# commit gives you its own message, several give you all of them (see the two branches below).
	# git falls back to `vi` when nothing is configured; common-setup.sh puts vim in both images, so
	# name it explicitly.
	local -a ed=()
	[ -n "$edit" ] && ed=(env GIT_EDITOR="${EDITOR:-${VISUAL:-vim}}")
	if [ -n "$squash" ]; then
		git_ merge --squash "$ref" || die "merge conflicts — resolve them in $REPO and commit, then run: $SELF merge '$box' --landed   (to retire the branch and tell the box)"
		if [ -n "$edit" ]; then
			if [ -n "$single" ]; then
				# One commit: SQUASH_MSG's "Squashed commit of the following:" preamble is noise, so
				# open the commit's own message instead — you are editing that commit, not summarising.
				"${ed[@]}" git -C "$REPO" commit -e \
					--author="$(git_ log -1 --format='%an <%ae>' "$ref")" \
					-m "$(git_ log -1 --format=%B "$ref")" -m "Cbx-Box: $box" \
					|| die "commit aborted (empty message?) — the change is staged, finish it in $REPO"
			else
				# SEVERAL commits: compose the buffer ourselves rather than using git's SQUASH_MSG.
				# SQUASH_MSG opens with "Squashed commit of the following:" and indents every message
				# by four spaces under a full `commit <sha> / Author: / Date:` header — a log to read,
				# not a message to edit: you reflow all of it before you can write anything. Here each
				# message appears VERBATIM and unindented, separated by a '#' banner giving position
				# and sha. git strips '#' lines on save (--cleanup=strip), so leaving the buffer as-is
				# yields the messages one blank line apart, and the banners never reach the commit.
				local msgf="$REPO/.git/MUSTER_SQUASH_MSG" c i=0
				: > "$msgf"
				while read -r c; do
					i=$((i + 1))
					if [ "$i" = 1 ]; then
						printf '# ── %s/%s · %s ── these ── lines are dropped; write the squashed message below\n' \
							"$i" "$ncommits" "$(git_ log -1 --format=%h "$c")" >> "$msgf"
					else
						printf '\n# ── %s/%s · %s ──\n' "$i" "$ncommits" "$(git_ log -1 --format=%h "$c")" >> "$msgf"
					fi
					git_ log -1 --format=%B "$c" >> "$msgf"
				done < <(git_ rev-list --reverse "$DEV..$ref")
				printf '\nCbx-Box: %s\n' "$box" >> "$msgf"
				"${ed[@]}" git -C "$REPO" commit --cleanup=strip -e -F "$msgf" \
					|| { rm -f "$msgf"; die "commit aborted (empty message?) — the squash is staged, finish it in $REPO"; }
				rm -f "$msgf"
			fi
		else
			git_ commit -m "$msg" -m "Cbx-Box: $box" || die "nothing to commit"
		fi
	else
		# $mref, not $ref: with --reword this is the rewritten chain (same trees, new messages).
		"${ed[@]+"${ed[@]}"}" git -C "$REPO" merge --no-ff ${edit:+--edit} "$mref" \
			-m "$msg" -m "Cbx-Box: $box" \
			|| die "merge conflicts — resolve them in $REPO and 'git commit', then run: $SELF merge '$box'   (to retire the branch and tell the box)"
	fi
	after="$(git_ rev-parse HEAD)"
	[ "$before" != "$after" ] || die "nothing was merged — $DEV is unchanged (already up to date?)"

	echo "$SELF: $DEV is now $(git_ rev-parse --short HEAD)"
	git_ --no-pager log --oneline -1 | sed 's/^/  /'
	git_ --no-pager diff --shortstat "$before" "$after" | sed 's/^/  /'
	merge_finish "$box"
}

# `$SELF merge <box> --undo` — put $DEV back and the review back in the queue.
#
# WHY IT CAN BE DONE AT ALL: merge uses `git merge --no-ff`, so the agent's tip is the merge commit's
# SECOND PARENT — the handoff is still right there in the history, and restoring the queue entry is one
# update-ref. The deleted refs/agents/<box> reflog is NOT a way back (git removes a ref's reflog with
# the ref), which is why this reads the parent rather than the log.
#
# HOW THE MERGE IS FOUND: by the `Cbx-Box: <box>` trailer merge() writes into every merge message.
# Anchored to a whole line, so a box called work1 does not match work12's merge.
merge_undo() {
	local box="$1" mc parent1 parent2 origin_ref
	mc="$(git_ rev-list --max-count=1 --grep="^Cbx-Box: ${box}\$" "$DEV" 2>/dev/null || true)"
	[ -n "$mc" ] || die "no merge of '$box' found on $DEV (looking for a 'Cbx-Box: $box' trailer).
     A merge done by hand does not carry one — undo it with plain git:
       git -C $REPO log --oneline -5 $DEV"

	# ONLY THE TIP. Resetting past commits that landed after the merge would take them with it, and
	# they are not this command's to remove.
	[ "$(git_ rev-parse "$DEV")" = "$mc" ] || die "the merge of '$box' is not the tip of $DEV — $(git_ rev-list --count "${mc}..${DEV}") commit(s) landed after it.
     Undoing it would take those with it. Reverse just this merge instead, keeping the history:
       git -C $REPO revert -m 1 $(git_ rev-parse --short "$mc")"

	# PUSHED IS PUBLISHED. Rewinding a branch that origin already has needs a force-push, which is not
	# something to do behind your back — name the alternative and stop.
	origin_ref="refs/remotes/origin/$DEV"
	if git_ rev-parse -q --verify "$origin_ref" >/dev/null 2>&1 \
	   && git_ merge-base --is-ancestor "$mc" "$origin_ref" 2>/dev/null; then
		die "that merge is already on origin/$DEV — undoing it here would need a force-push.
     Reverse it instead (keeps the history, no force-push):
       git -C $REPO revert -m 1 $(git_ rev-parse --short "$mc")"
	fi

	parent1="$(git_ rev-parse "${mc}^1")"
	# A --squash merge has ONE parent: the agent's commits were flattened, so there is nothing to
	# restore the queue entry from. Say so rather than half-doing it.
	parent2="$(git_ rev-parse -q --verify "${mc}^2" 2>/dev/null || true)"

	# --keep, not --hard: the hub's checkout is your workspace and is routinely dirty with setup work.
	# --keep rewinds the branch and the files the merge touched while keeping uncommitted changes, and
	# REFUSES if one of them would be clobbered — which is the answer you want, not a silent loss.
	git_ reset --keep "$parent1" \
		|| die "could not rewind $DEV to $(git_ rev-parse --short "$parent1") — the hub's worktree has changes that
     the merge also touched. Deal with those first (git -C $REPO status), then run this again."
	echo "$SELF: $DEV is back at $(git_ rev-parse --short HEAD) ($(git_ log -1 --format=%s HEAD))"

	if [ -n "$parent2" ]; then
		git_ update-ref "refs/agents/$box" "$parent2"
		echo "$SELF: restored refs/agents/$box at $(git_ rev-parse --short "$parent2") — '$SELF q' shows it again"
		# The review state is NOT restored: merge deleted .reviewed/.sent, so the next `review` shows the
		# whole branch rather than "what changed since you last looked". Better than pretending.
		echo "$SELF: (its review history is gone, so '$SELF review $box' will show the full diff again)"
	else
		echo "$SELF: that merge was a --squash: it has no second parent, so the branch cannot be" >&2
		echo "     restored from it. The BOX still has the commits until it rebases — attach and" >&2
		echo "     re-publish them:  $SELF box $box   then, inside it:  handoff" >&2
	fi

	# The box was told to rebase onto the merged $DEV when the merge finished. Whether it did or not,
	# it needs to know the ground moved back — and must not act on its own.
	say_to_box "$box" "I UNDID the merge of your work: ${DEV} is back at $(git_ rev-parse --short HEAD) and your branch is in the review queue again. Do NOT rebase, re-push or start anything — wait for my next instruction." 2>/dev/null \
		&& echo "$SELF: told '$box' that the merge was undone" \
		|| echo "$SELF: could not reach '$box' to tell it (not running?) — do it yourself if it is working"
}

drop() {
	[ $# -ge 1 ] || die "drop needs a box name"
	local box="$1"
	git_ update-ref -d "refs/agents/$box" 2>/dev/null || true
	# .sent goes with it: the branch this box will push next is a new review from scratch.
	# .mergeinto too — without it a dropped minto box would keep being measured against a target it is
	# no longer resolving, and `$SELF merge` would go on refusing it.
	rm -f "$STATE/$box.reviewed" "$STATE/$box.sent" "$STATE/$box.mergeinto"
	rm -rf "$(reword_dir "$box")"
	say_to_box "$box" "I dropped your handoff — that approach is not going in. Do not re-push it; wait for new instructions." 2>/dev/null || true
	echo "$SELF: dropped refs/agents/$box (the box still has the commits locally until it rebases)"
}

# ------------------------------------------------------------------ minto (merge $DEV INTO a branch)
#
# The other direction from `$SELF merge`: agent work flows INTO $DEV, and $DEV flows OUT into the
# long-lived branches (staging, a release branch). Two rules shape the whole thing:
#
#   * THE HUB'S CHECKOUT NEVER MOVES. It stays on $DEV, dirty with your local setup work — that tree is
#     what goldens are snapshotted from, so a `git checkout <target>` here would change what every new
#     box starts from. A clean merge is therefore computed in the OBJECT STORE (merge-tree +
#     commit-tree + update-ref) and a hand-resolved one gets its own linked worktree.
#   * NOTHING MOVES refs/heads/<target> UNTIL THE MERGE IS FINISHED. Every path either lands a finished
#     commit or leaves the branch exactly as it was, so `--abort` is always free.
MINTO_WT="$STATE/wt"
INTENT_DIR="$STATE/branch-intent"

# Branch names may contain '/', which cannot appear in a state FILE name. One encoding, used for both
# the intent cache and the worktree directory.
branch_slug() { printf '%s' "${1//\//__}"; }

# The job record for a box spawned by `$SELF minto`: four lines — target, the target sha when it was
# spawned, the $DEV sha when it was spawned, the intent. Its EXISTENCE is what tells the rest of cbx
# that this box's branch is not meant for $DEV: the queue, the review and `mark_reviewed` measure it
# against the target instead, and `$SELF merge` refuses it outright.
minto_field() { sed -n "${2}p" "$STATE/$1.mergeinto" 2>/dev/null || true; }
minto_target() { minto_field "$1" 1; }
# The branch an agent branch is measured against: its minto target, or $DEV for an ordinary box. Used
# everywhere a diff, a count or a status is computed for a box.
base_of() { local t; t="$(minto_target "$1")"; printf '%s' "${t:-$DEV}"; }

# How many commits a minto box ADDED — everything on its branch that is on neither the target nor
# $DEV. A clean resolution is exactly 1: the merge commit. A plain `<target>..<ref>` count would also
# include every commit the merge brings in from $DEV, so a one-commit resolution of a busy week reads
# as "37 commits to review".
minto_own_count() {
	git_ rev-list --count "refs/agents/$1" --not "$2" "$DEV" 2>/dev/null || echo '?'
}

# The box currently resolving a merge into <target>, if any (empty otherwise).
minto_box_for() {
	local f b
	for f in "$STATE"/*.mergeinto; do
		[ -e "$f" ] || continue
		b="$(basename "$f" .mergeinto)"
		if [ "$(minto_target "$b")" = "$1" ]; then printf '%s' "$b"; return 0; fi
	done
	return 0
}

# What the branch is FOR, in one line. Asked only on the conflict path — a fast-forward or a clean
# merge decides nothing, so there is nothing for an intent to inform. Remembered per branch, because
# the answer for 'staging' is the same every month and retyping it is how it ends up empty.
minto_intent() {
	local target="$1" given="$2" cached="" ans f
	f="$INTENT_DIR/$(branch_slug "$target")"
	if [ -n "$given" ]; then
		mkdir -p "$INTENT_DIR"; printf '%s\n' "$given" > "$f"
		printf '%s' "$given"; return 0
	fi
	cached="$(head -1 "$f" 2>/dev/null || true)"
	if [ ! -t 0 ]; then printf '%s' "$cached"; return 0; fi
	tty_flush
	printf '$SELF: what is %s FOR? (guides how conflicts get resolved)\n' "$target" >&2
	printf '  %s> ' "${cached:+[$cached] }" >&2
	read -r ans </dev/tty || ans=""
	[ -n "$ans" ] || ans="$cached"
	if [ -n "$ans" ]; then mkdir -p "$INTENT_DIR"; printf '%s\n' "$ans" > "$f"; fi
	printf '%s' "$ans"
}

# Everything that must be true before a merge into <target> can start. Runs before anything is
# touched, so every refusal here leaves the repo exactly as it was.
minto_prepare() {
	local target="$1" dopull="$2" behind ahead wt head
	echo "$SELF: fetching origin"
	git_ fetch -q origin 2>/dev/null || echo "$SELF: (could not reach origin — working from the local refs)" >&2
	# The target must exist as a LOCAL branch: the merge needs it here, and a resolving box can only
	# fetch what the hub's git daemon exports, which is refs/heads/*.
	if ! git_ rev-parse --verify -q "refs/heads/$target" >/dev/null; then
		git_ rev-parse --verify -q "refs/remotes/origin/$target" >/dev/null \
			|| die "no branch '$target' — not here, and not on origin"
		git_ branch --track "$target" "origin/$target" >/dev/null
		echo "$SELF: created local $target tracking origin/$target"
	fi
	head="$(git_ symbolic-ref -q HEAD || true)"
	[ "$head" != "refs/heads/$target" ] \
		|| die "$target is the hub's checked-out branch — minto merges INTO a branch you are not sitting on"
	wt="$MINTO_WT/$(branch_slug "$target")"
	if [ -e "$wt" ]; then
		echo "$SELF: an unfinished minto worktree is already open on $target:" >&2
		echo "    $wt" >&2
		echo "$SELF: finish it — resolve there, 'git add' + 'git commit', then: $SELF minto $target --landed" >&2
		echo "$SELF: or drop it — $SELF minto $target --abort" >&2
		die "refusing to start a second merge into $target"
	fi
	local other; other="$(minto_box_for "$target")"
	if [ -n "$other" ]; then
		echo "$SELF: box '$other' is already resolving a merge into $target." >&2
		echo "$SELF: land it    — $SELF review $other   then   $SELF minto $target --land $other" >&2
		echo "$SELF: or drop it — $SELF minto $target --abort" >&2
		die "refusing to start a second merge into $target"
	fi
	# Don't build on a stale base: a merge onto an old tip is rejected by `$SELF push <target>` afterwards,
	# leaving you to untangle it once the work is already done.
	read -r behind ahead <<< "$(divergence "$target")"
	if [ "$behind" != 0 ]; then
		if [ -z "$dopull" ]; then
			echo "$SELF: origin/$target has $behind commit(s) $target doesn't." >&2
			echo "$SELF: merging now would put this on a stale base and '$SELF push $target' would be rejected." >&2
			die "run: $SELF minto $target --pull   (fast-forwards $target to origin first)"
		fi
		# A plain fetch into the branch: fast-forward only, so a genuinely diverged target fails here
		# rather than being silently rewritten.
		git_ fetch -q origin "$target:$target" \
			|| die "$target has diverged from origin/$target — reconcile it by hand first"
		echo "$SELF: fast-forwarded $target to origin/$target"
	fi
}

# The prompt for a resolving agent. Everything the box needs to understand the conflict SEMANTICALLY:
# what the branch is for, and the commands that show both sides' history behind each conflicted file.
minto_prompt() {
	local target="$1" intent="$2" conflicts="$3" box="$4"
	cat <<EOF
You are resolving a merge conflict, not writing a feature.

Your checkout is already on agent/${box} — it was branched from ${target} and \`git merge hub/${DEV}\`
has been started for you, so the conflicts are sitting in your working tree right now. Both branches
are fully available as hub/${target} and hub/${DEV}.

WHAT ${target} IS FOR: ${intent:-（not stated）}
Resolve every conflict so that ${target} keeps serving that purpose.

Conflicted: ${conflicts}

Before you change a single hunk, understand BOTH sides. These show you the two histories that
collided, not just the two texts:

  git log --oneline --left-right --boundary hub/${target}...hub/${DEV}
      '<' = only on ${target}, '>' = only on ${DEV} — the two divergent histories side by side
  git log --merge --stat
      ONLY the commits, from BOTH sides, that touch a conflicted file. Start here.
  git log --merge -p -- <conflicted-file>
      per file: every commit from either side behind this conflict, with its diff and message
  git log --notes=cbx hub/${DEV}
      the handoff summaries — why ${DEV}'s side of the conflict looks the way it does
  git diff --diff-filter=U
      the conflict hunks. merge.conflictstyle is zdiff3, so each one shows the common BASE too:
      that is what tells you which side CHANGED a line and which side merely kept it.

Rules:
  * Keep BOTH sides' intent wherever they are merely adjacent edits. A conflict is textual far more
    often than it is semantic.
  * Where the two sides genuinely disagree about behaviour, decide in favour of what ${target} is for,
    and SAY SO in your handoff summary — that is the part I will read most carefully.
  * If a conflict cannot be resolved without knowing something you don't, resolve the rest, leave that
    one, and tell me. A flagged unknown is worth far more to me than a confident guess.
  * Do NOT do any other work: no refactoring, no cleanups, no "while I'm here". Only the resolution.
  * This box's golden was snapshotted from ${DEV}, so if ${target} differs in build config the tree may
    not compile. Verify what you can; say plainly what you could not verify.

When done: git add the resolved files, \`git commit\` (keep the merge commit — do NOT squash or rebase),
then run: handoff "resolved <n> conflicts merging ${DEV} into ${target}: <what you decided and why>"
EOF
}

# Spawn the resolver and record the job. Ordering matters: the state file is written BEFORE the box
# exists, so a spawn that fails halfway still leaves something `--abort` can clean up.
minto_spawn() {
	local target="$1" tsha="$2" dsha="$3" intent="$4" conflicts="$5"
	local box resp container
	box="minto-$(branch_slug "$target")"
	box="$(printf '%s' "$box" | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9_-' '-' | cut -c1-31)"
	mkdir -p "$STATE"
	printf '%s\n%s\n%s\n%s\n' "$target" "$tsha" "$dsha" "$intent" > "$STATE/$box.mergeinto"
	echo "$SELF: spawning box '$box' on $target, with $DEV merged in and conflicted"
	# base + merge: the broker hands them to muster-box-init, which does the checkout AND the merge in the
	# box's tmux window BEFORE claude starts. That part must not be a prompt — a prompt is advisory and
	# asynchronous, and "the agent did not actually run the setup commands" is not a failure you want to
	# debug through a tmux session.
	if ! resp="$(broker POST "/box/$box?base=$target&merge=$DEV")"; then
		rm -f "$STATE/$box.mergeinto"
		die "spawning box '$box' failed: $resp"
	fi
	container="$(printf '%s' "$resp" | jqr '.container // empty')"
	if paste_to_box "$box" "$(minto_prompt "$target" "$intent" "$conflicts" "$box")"; then
		echo "$SELF: briefed $box (both branches, both histories, and what $target is for)"
	else
		echo "$SELF: box is up but the briefing did NOT land — attach and paste it yourself:" >&2
		echo "    docker exec -it -u dev $container tmux attach -t main" >&2
	fi
	echo "$SELF: next — $SELF q            # watch for the handoff"
	echo "$SELF:        $SELF review $box  # the resolution alone (combined diff)"
	echo "$SELF:        $SELF minto $target --land $box"
}

# The by-hand path: a LINKED WORKTREE, so the hub's own checkout stays on $DEV. It lives under
# .git/cbx/ for two reasons — that directory is inside the bind-mounted repo, so it survives a hub
# container replacement, and `golden_snapshot` already strips it, so a half-finished merge can never
# leak into a golden and turn up in every new box.
minto_worktree() {
	local target="$1" wt
	wt="$MINTO_WT/$(branch_slug "$target")"
	mkdir -p "$MINTO_WT"
	git_ worktree add --quiet "$wt" "$target" || die "could not create a worktree for $target"
	git -C "$wt" config merge.conflictstyle zdiff3
	# Expected to fail — that is the point. `|| true`: this is where the conflicts are supposed to land.
	git -C "$wt" merge "$DEV" >/dev/null 2>&1 || true
	echo
	echo "$SELF: resolve it in    $wt"
	echo "$SELF: (your $DEV checkout at $REPO is untouched)"
	echo
	echo "    cd $wt"
	echo "    git status                       # the unmerged paths"
	echo "    git log --merge -p -- <file>     # commits from BOTH sides behind each conflict"
	echo "    \$EDITOR <file>                   # zdiff3: each hunk shows the common base too"
	echo "    git add <file> && git commit     # $target moves HERE — a linked worktree owns its branch"
	echo "    $SELF minto $target --landed       # verify, tear the worktree down, tell you what's next"
	echo
	echo "$SELF: changed your mind? $SELF minto $target --abort"
}

# Take a resolving box's merge commit and move <target> onto it. Three ancestry checks make it
# impossible to land anything that is not the merge that was asked for, and the guarded update-ref
# makes it impossible to land it onto a target that moved in the meantime.
minto_land() {
	# NB `ref` gets its own statement: within ONE `local`, bash expands every word before assigning any
	# of them, so "refs/agents/$box" there would read an unset $box and `set -u` would kill muster.
	local target="$1" box="$2" tsha dsha now n
	local ref="refs/agents/$box"
	[ -e "$STATE/$box.mergeinto" ] || die "box '$box' is not resolving a merge (no minto job recorded)"
	[ "$(minto_target "$box")" = "$target" ] \
		|| die "box '$box' is resolving a merge into '$(minto_target "$box")', not '$target'"
	git_ rev-parse --verify -q "$ref" >/dev/null || die "$box has not pushed anything yet (no handoff)"
	tsha="$(minto_field "$box" 2)"; dsha="$(minto_field "$box" 3)"
	now="$(git_ rev-parse "refs/heads/$target")"
	[ "$now" = "$tsha" ] \
		|| die "$target moved since the merge started ($(git_ rev-parse --short "$tsha") -> $(git_ rev-parse --short "$now")) — re-run '$SELF minto $target' against the new tip"
	git_ merge-base --is-ancestor "$tsha" "$ref" \
		|| die "$box's branch does not contain $target — it did not resolve the merge that was asked for"
	git_ merge-base --is-ancestor "$dsha" "$ref" \
		|| die "$box's branch does not contain $DEV — it committed a resolution but dropped the merge (rebased or squashed it?)"
	n="$(minto_own_count "$box" "$target")"
	[ "$n" = 1 ] || echo "$SELF: note — the box added $n commit(s), not just the merge ('$SELF review $box --full' shows them)"
	git_ update-ref -m "$SELF minto --land $box" "refs/heads/$target" "$(git_ rev-parse "$ref")" "$tsha"
	# No note copying needed: refs/heads/<target> and refs/agents/<box> now name the SAME commit, and a
	# cbx note is attached to the commit, not to the ref — deleting the ref leaves the summary in place
	# (`git log --notes=cbx $target`).
	git_ update-ref -d "$ref" 2>/dev/null || true
	rm -f "$STATE/$box.mergeinto" "$STATE/$box.reviewed" "$STATE/$box.sent"
	echo "$SELF: $target is now $(git_ rev-parse --short "$target")"
	git_ --no-pager diff --shortstat "$tsha" "refs/heads/$target" | sed 's/^/  /'
	# A minto box has exactly one job and it is done. Unlike an agent box there is no ongoing task to
	# resume, so leaving it running would just be a box you have to remember to kill.
	if broker DELETE "/box/$box" >/dev/null 2>&1; then
		echo "$SELF: retired box $box"
	else
		echo "$SELF: (box $box could not be removed — '$SELF kill $box' when convenient)"
	fi
	echo "$SELF: next — $SELF push $target"
}

# The --here counterpart: the branch already moved (a commit in a linked worktree moves the branch it
# holds), so this only verifies what landed and cleans up.
minto_landed() {
	local target="$1" wt
	wt="$MINTO_WT/$(branch_slug "$target")"
	[ -e "$wt" ] || die "no minto worktree open for $target (nothing to finish)"
	if [ -n "$(git -C "$wt" ls-files -u | head -1)" ]; then
		echo "$SELF: $wt still has UNRESOLVED conflicts:" >&2
		git -C "$wt" diff --name-only --diff-filter=U | sed 's/^/    /' >&2
		die "resolve them, 'git add' + 'git commit', then re-run"
	fi
	git -C "$wt" rev-parse -q --verify MERGE_HEAD >/dev/null 2>&1 \
		&& die "the merge in $wt is resolved but NOT committed — 'git -C $wt commit' first"
	git_ merge-base --is-ancestor "$DEV" "refs/heads/$target" \
		|| die "$target does not contain $DEV — was the merge committed? ('git -C $wt log --oneline -3')"
	echo "$SELF: $target is now $(git_ rev-parse --short "$target")"
	git_ --no-pager log --oneline -1 "$target" | sed 's/^/  /'
	git_ worktree remove --force "$wt" || die "could not remove $wt (remove it by hand, then 'git -C $REPO worktree prune')"
	git_ worktree prune
	echo "$SELF: worktree removed. Next — $SELF push $target"
}

# Undo whatever minto has open for a branch. Safe at any point BEFORE the merge lands, which is the
# whole reason nothing touches refs/heads/<target> until then: there is never anything to revert.
minto_abort() {
	local target="$1" box wt n=0
	wt="$MINTO_WT/$(branch_slug "$target")"
	if [ -e "$wt" ]; then
		git -C "$wt" merge --abort 2>/dev/null || true
		git_ worktree remove --force "$wt" 2>/dev/null || rm -rf "$wt"
		git_ worktree prune
		echo "$SELF: removed the minto worktree for $target ($target was never moved)"
		n=$((n + 1))
	fi
	box="$(minto_box_for "$target")"
	if [ -n "$box" ]; then
		git_ update-ref -d "refs/agents/$box" 2>/dev/null || true
		rm -f "$STATE/$box.mergeinto" "$STATE/$box.reviewed" "$STATE/$box.sent"
		broker DELETE "/box/$box" >/dev/null 2>&1 || true
		echo "$SELF: dropped box $box and its resolution ($target was never moved)"
		n=$((n + 1))
	fi
	[ "$n" -gt 0 ] || echo "$SELF: nothing open for $target — nothing to abort"
}

minto() {
	argsort "--intent --land" "$@"; set -- ${ARGV[@]+"${ARGV[@]}"}
	[ $# -ge 1 ] || die "minto needs a target branch: $SELF minto <branch>"
	local target="$1" intent="" land="" abort="" landed="" dopull="" mode="" a
	shift
	while [ $# -gt 0 ]; do
		a="$1"
		case "$a" in
			--intent)   shift; intent="${1:-}"; [ -n "$intent" ] || die "minto: --intent needs text" ;;
			--intent=*) intent="${a#--intent=}" ;;
			--land)     shift; land="${1:-}"; [ -n "$land" ] || die "minto: --land needs a box name" ;;
			--land=*)   land="${a#--land=}" ;;
			--abort)    abort=1 ;;
			--landed)   landed=1 ;;
			--pull)     dopull=1 ;;
			--box)      mode=box ;;
			--here)     mode=here ;;
			*) die "minto: unknown option '$a' (--intent '…' | --box | --here | --land <box> | --landed | --abort | --pull)" ;;
		esac
		shift
	done
	[ "$target" != "$DEV" ] || die "minto: '$target' IS the source branch — $SELF minto merges $DEV into something else"
	mkdir -p "$STATE"

	if [ -n "$abort" ];  then minto_abort  "$target";        return 0; fi
	if [ -n "$land" ];   then minto_land   "$target" "$land"; return 0; fi
	if [ -n "$landed" ]; then minto_landed "$target";        return 0; fi

	minto_prepare "$target" "$dopull"

	local tsha dsha tree out rc=0 new conflicts n ans
	tsha="$(git_ rev-parse "refs/heads/$target")"
	dsha="$(git_ rev-parse "refs/heads/$DEV")"

	if git_ merge-base --is-ancestor "$dsha" "$tsha"; then
		echo "$SELF: $target already contains every commit on $DEV — nothing to merge."
		return 0
	fi
	# Fast-forward: no merge commit is written, so there is nothing to decide — and therefore no reason
	# to ask what the branch is for.
	if git_ merge-base --is-ancestor "$tsha" "$dsha"; then
		echo "$SELF: $target is an ancestor of $DEV — fast-forwarding $(git_ rev-list --count "$target..$DEV") commit(s):"
		git_ --no-pager log --oneline "$target..$DEV" | sed 's/^/  /'
		git_ update-ref -m "$SELF minto: fast-forward to $DEV" "refs/heads/$target" "$dsha" "$tsha"
		echo "$SELF: $target is now $(git_ rev-parse --short "$target"). Next — $SELF push $target"
		return 0
	fi

	echo "$SELF: merging $DEV into $target — $(git_ rev-list --count "$target..$DEV") commit(s) to bring in, $(git_ rev-list --count "$DEV..$target") only on $target"
	# THE MERGE, ATTEMPTED IN THE OBJECT STORE. No index, no worktree, nothing to clean up when it
	# fails — and the hub's own tree is never a participant, so its local setup changes can neither be
	# clobbered nor swept into the merge. merge-tree prints the resulting tree oid on line 1, and on
	# conflict (exit 1, distinct from a real error) the conflicted paths from line 2 on.
	out="$(git_ merge-tree --write-tree --name-only --no-messages "$target" "$DEV" 2>&1)" || rc=$?
	if [ "$rc" = 0 ]; then
		tree="$(printf '%s' "$out" | head -1)"
		new="$(git_ commit-tree "$tree" -p "$tsha" -p "$dsha" \
			-m "Merge $DEV into $target" -m "Cbx-Minto: $DEV")"
		git_ update-ref -m "$SELF minto: merge $DEV" "refs/heads/$target" "$new" "$tsha"
		echo "$SELF: merged cleanly — $target is now $(git_ rev-parse --short "$new")"
		git_ --no-pager diff --shortstat "$tsha" "$new" | sed 's/^/  /'
		echo "$SELF: next — $SELF push $target"
		return 0
	fi
	[ "$rc" = 1 ] || die "git merge-tree failed ($rc): $out"

	conflicts="$(printf '%s' "$out" | tail -n +2 | tr '\n' ' ')"
	conflicts="${conflicts% }"
	n="$(printf '%s' "$out" | tail -n +2 | grep -c . || true)"
	echo
	printf '%scbx: %s conflicted file(s):%s\n' "$C_B$C_RED" "$n" "$C_RESET"
	printf '%s' "$out" | tail -n +2 | sed 's/^/    /'
	echo
	intent="$(minto_intent "$target" "$intent")"

	if [ -z "$mode" ]; then
		if [ -t 0 ]; then
			tty_flush
			printf '$SELF: [b]ox — an agent resolves it  [h]ere — a worktree, you resolve it  [a]bort ? '
			read -r ans </dev/tty || ans=a
			case "$ans" in
				b|B|"") mode=box ;;
				h|H)    mode=here ;;
				*)      echo "$SELF: aborted — $target is unchanged, nothing was written."; return 0 ;;
			esac
		else
			# Non-interactive: report and change nothing. Guessing either way would be a surprise.
			echo "$SELF: not a terminal — nothing done. Re-run with --box or --here." >&2
			return 1
		fi
	fi
	if [ "$mode" = box ]; then
		minto_spawn "$target" "$tsha" "$dsha" "$intent" "$conflicts"
	else
		minto_worktree "$target"
	fi
}

# WHAT AN AGENT SHOULD DO WHEN ITS TREE IS DIRTY, said out loud. `git rebase` refuses to start with
# uncommitted changes, and the prompts below used to stop at "replays your own commits" — leaving the
# agent to invent a recovery at the moment it is least supervised. The inventions are not equivalent:
# `git stash` hides work that a conflict then drops on the floor, and `git add -A` sweeps the files a
# project keeps deliberately untracked (build tarballs, patches, node_modules) into the very branch
# you are about to review. Committing BY PATH is the one that keeps both halves right, so it is
# spelled out instead of hoped for — and the agent is asked to report it, because a commit made on
# the agent's own judgement should not be something you discover later in a diff.
rebase_dirty_note() {
	printf '%s' "If git refuses to start because your working tree is dirty, commit YOUR OWN work first and then rebase: 'git add' the specific paths you changed and commit them with a normal message. Do NOT use 'git add -A' and do NOT use 'git stash' — files this project keeps untracked on purpose must stay untracked. Say in one line what you committed. "
}

rebase() {
	[ $# -ge 1 ] || die "rebase needs a box name (or 'all')"
	local box list behind n=0 ok=0 force="" rstate rage after_rebase repush
	[ "${2:-}" = --force ] && force=--force
	if [ "$1" = all ]; then
		list="$(broker GET /box 2>/dev/null | jqr '.boxes[]?.box')"
		[ -n "$list" ] || die "no boxes exist — '$SELF ls' to check"
	else
		list="$1"
	fi

	echo "$SELF: $DEV is at $(git_ rev-parse --short "$DEV") ($(git_ log -1 --format=%s "$DEV"))"
	for box in $list; do
		n=$((n + 1))
		# Skip, don't abort: with 'all' one working agent shouldn't stop the others being told.
		if ! guard_busy "$box" "$force"; then
			echo "  $box: skipped (busy) — '$SELF rebase $box --force' to interrupt anyway"
			continue
		fi
		# How far the agent's PUSHED branch trails the branch it's based on. A box that never handed
		# off has no ref here, which is normal — it just means we can't say how stale it is.
		if git_ rev-parse --verify -q "refs/agents/$box" >/dev/null; then
			behind="$(git_ rev-list --count "refs/agents/$box..$DEV" 2>/dev/null || echo '?')"
			behind="behind by $behind commit(s)"
			# This box has already handed off, and the rebase rewrites exactly the commits that ref
			# points at — so refs/agents/<box> is stale the moment the rebase lands. Say so: an agent
			# that rebases and stops leaves the reviewer looking at pre-rebase commits that no longer
			# exist on its branch, and the next 'review' diffs against a base that has moved under it.
			repush="You have already handed this work off for review, so the ref the hub holds is now stale: once the rebase has completed cleanly, run 'handoff' with NO arguments to re-push the rebased branch (your existing summary is kept). If the rebase left you with conflicts you cannot resolve, do NOT hand off — say so and stop. "
		else
			behind="nothing pushed yet"
			repush=""
		fi
		# Same reasoning as in merge(): what to do after the rebase is decided from the box's state, so
		# an agent that is between tasks is not invited to go and find itself one. Normally every
		# recipient here is non-busy (guard_busy skipped the rest); --force is the exception.
		read -r rstate rage <<< "$(box_activity "$box")"
		if [ "$rstate" = busy ]; then
			after_rebase="Then go straight back to the task you were already working on. Do NOT start, plan, or pick up any other work."
		else
			after_rebase="Then STOP and wait for my next instruction — do NOT start, plan, or pick up any other work."
		fi
		if say_to_box "$box" "Please run: git fetch hub && git rebase hub/${DEV} — the ${DEV} branch has moved, so this only replays your own commits on top of it. Resolve any conflicts it reports. It is NOT a request for new changes. $(rebase_dirty_note)${repush}${after_rebase}"; then
			ok=$((ok + 1))
			echo "  $box: asked to rebase ($behind${repush:+, and to re-handoff})"
		else
			echo "  $box: NOT reachable, skipped ($behind) — '$SELF box $box' to start it"
		fi
	done

	echo "$SELF: delivered to $ok of $n box(es)."
	# The single most confusing thing about this command: nothing has rebased yet.
	echo "$SELF: NOTE this is a prompt typed into each agent's session, not a rebase that already ran."
	echo "     Each agent runs 'git fetch hub && git rebase hub/$DEV' when it picks the message up,"
	echo "     which may be a while if it is mid-task, and it may hit conflicts and ask you about them."
	echo "     Watch one:  cbxbox <box>      Re-check later:  $SELF q"
}

divergence() {
	# "<behind> <ahead>" of a branch relative to its origin/ counterpart ($DEV unless told otherwise —
	# `$SELF minto` asks about the branch it is merging into). Needs a fetch first to mean anything.
	local b="${1:-$DEV}"
	git_ rev-list --left-right --count "origin/$b...$b" 2>/dev/null || echo "0 0"
}

pull() {
	# Bring the hub's branch up to date with origin. Needed whenever you (or anyone) pushed to the
	# branch elsewhere: the hub's merges then sit on an older base and `$SELF push` is rejected.
	local mode="${1:-}" behind ahead
	echo "$SELF: fetching origin"
	git_ fetch origin || die "fetch failed"
	read -r behind ahead <<< "$(divergence)"
	if [ "$behind" = 0 ]; then
		echo "$SELF: $DEV is up to date with origin ($ahead local commit(s) to push)"
		return 0
	fi
	echo "$SELF: origin has $behind commit(s) you don't; you have $ahead it doesn't"
	if [ "$ahead" = 0 ]; then
		git_ merge --ff-only "origin/$DEV" || die "fast-forward failed — resolve in $REPO"
		echo "$SELF: fast-forwarded to $(git_ rev-parse --short HEAD)"
	elif [ "$mode" = --rebase ]; then
		git_ rebase "origin/$DEV" || die "rebase conflicts — resolve in $REPO, then 'git rebase --continue'"
		echo "$SELF: rebased onto origin/$DEV ($(git_ rev-parse --short HEAD))"
	else
		git_ merge "origin/$DEV" -m "Merge origin/$DEV" \
			|| die "merge conflicts — resolve in $REPO, then 'git commit'"
		echo "$SELF: merged origin/$DEV ($(git_ rev-parse --short HEAD))"
	fi
	echo "$SELF: agents are now behind — '$SELF rebase all' after you push."
}

push() {
	# Takes an optional BRANCH (default $DEV) so `$SELF minto <target>` has something to hand you at the
	# end. Everything else — the --stat preview, the confirm, the failure diagnostics — is per-branch by
	# substitution only; nothing about the push itself is dev-specific.
	local ahead behind yes="" a reply branch=""
	for a in "$@"; do
		case "$a" in
			-y|--yes) yes=1 ;;
			-*) die "push: unknown option '$a' (-y | --yes)" ;;
			*)  [ -z "$branch" ] || die "push: one branch at a time (got '$branch' and '$a')"
			    branch="$a" ;;
		esac
	done
	local DEV="${branch:-$DEV}"          # local: every $DEV below now means "the branch being pushed"
	git_ rev-parse --verify -q "refs/heads/$DEV" >/dev/null || die "push: no local branch '$DEV'"
	# The counts are only true against a fresh origin. `$SELF merge` fetches before it merges, but a
	# `$SELF push <other-branch>` can arrive with no fetch in between.
	git_ fetch -q origin "$DEV" 2>/dev/null || echo "$SELF: (could not reach origin — counts may be stale)" >&2
	read -r behind ahead <<< "$(divergence "$DEV")"
	if [ "$behind" != 0 ]; then
		if [ -n "$branch" ]; then
			die "origin has $behind commit(s) $DEV doesn't — run '$SELF minto $DEV --pull' first"
		fi
		die "origin has $behind commit(s) $DEV doesn't — run '$SELF pull' (or '$SELF pull --rebase') first"
	fi
	# Don't report "pushed" when there was nothing to push — that reads as "my merge went out" when
	# in fact nothing was ever merged (a silent `$SELF merge` failure looks exactly like this).
	if [ "$ahead" = 0 ]; then
		echo "$SELF: nothing to push — $DEV already matches origin ($(git_ rev-parse --short "$DEV"))."
		echo "$SELF: expecting an agent's work here? It is merged only after '$SELF merge <box>' succeeds — check '$SELF q'."
		return 0
	fi
	# Show exactly what leaves the hub before it leaves. A push is the one irreversible step in the
	# loop (agents' work is public from here on), and it is easy to have merged more than you meant —
	# so the per-commit --stat is the last chance to notice a stray file or a second box's work.
	#
	# -y SKIPS THE LISTING TOO, not just the question. The listing exists to inform the answer; with
	# the answer already given it is output nobody reads — and worse, it goes through the PAGER, so a
	# scripted `push -y` on a terminal could sit in `less` waiting for a keypress that is not coming.
	# One flag, one meaning: no prompt and none of the exposition that leads up to it.
	if [ -z "$yes" ]; then
		echo "$SELF: $ahead commit(s) would go to origin/$DEV:"
		# `|| true`: quitting the pager early SIGPIPEs git, and pipefail would otherwise abort the push
		# right there — pressing 'q' must mean "seen enough", not "cancelled".
		git_ log --stat --oneline "origin/$DEV..$DEV" | review_pager || true
	fi
	# Only ask when someone is there to answer: piped/cron use keeps the old non-interactive behaviour.
	if [ -z "$yes" ] && [ -t 0 ] && [ -t 1 ]; then
		read -r -p "$SELF: push these $ahead commit(s) to origin/$DEV? [y/N] " reply
		case "$reply" in
			y|Y|yes|YES) ;;
			*) echo "$SELF: not pushed ($DEV is unchanged; nothing was sent)"; return 1 ;;
		esac
	fi
	echo "$SELF: pushing $DEV ($ahead commit(s) ahead of origin) -> $(git_ remote get-url origin)"
	if git_ push origin "$DEV"; then
		echo "$SELF: pushed $DEV to origin"
	else
		# The three things that actually go wrong here, in the order they're worth checking.
		echo "$SELF: push FAILED. Usual causes:" >&2
		echo "  * the deploy key is read-only — GitHub: Settings -> Deploy keys -> 'Allow write access'" >&2
		echo "  * no key offered ('Permission denied (publickey)') — check the identity dir matches the" >&2
		echo "    hub user's HOME: ls -l \$HOME/.gitidentity, and that git-identity/gitconfig has no" >&2
		echo "    stale core.sshCommand pointing at another home" >&2
		echo "  * a branch ruleset protects $DEV — the key is not in the bypass list" >&2
		exit 1
	fi
}

# ------------------------------------------------------------------ goldens


# `$SELF golden retire <id>` — free a golden that boxes are still overlaid on.
#
# `reap` deliberately skips those: a golden is the lowerdir of every box on it, and pulling it out
# from under a live overlay is undefined behaviour. So the question is never "can I delete it" but
# "what happens to its boxes", and there are only two answers — MOVE them or REMOVE them.
#
# MOVING IS REAL. A box is an overlay, so `$SELF recreate <box>` respawns it on whatever golden is
# CURRENT, keeping its own upper layer (its uncommitted work) on top. `--fresh` throws that upper
# layer away for a clean move, which is only safe once the work is pushed. Neither is a "port" in the
# sense of rewriting anything: the base underneath simply changes.
golden_retire() {
	[ $# -ge 1 ] || die "retire needs a golden id ('$SELF golden ls' lists them)"
	local id="$1" resp cur boxes b answer
	resp="$(broker GET /golden)" || die "broker unreachable: $resp"
	cur="$(printf '%s' "$resp" | jqr '.current')"
	printf '%s' "$resp" | jq -e --arg g "$id" '.goldens[]? | select(.golden==$g)' >/dev/null 2>&1 \
		|| die "no such golden '$id' ('$SELF golden ls' lists them)"
	[ "$id" != "$cur" ] || die "'$id' is the CURRENT golden — every new box overlays it.
     Take a new snapshot first ($SELF golden snapshot), then retire this one."
	boxes="$(printf '%s' "$resp" | jq -r --arg g "$id" '.goldens[]? | select(.golden==$g) | .boxes[]?' 2>/dev/null)"

	if [ -n "$boxes" ]; then
		echo "$SELF: these boxes are still overlaid on $id:"
		for b in $boxes; do printf '  %s\n' "$b"; done
		echo "$SELF: they have to go somewhere before it can be freed."
		if [ ! -t 0 ]; then
			die "not a terminal — rerun interactively, or move them yourself:
     $SELF recreate <box>          # onto the current golden ($cur), keeping its work
     $SELF recreate <box> --fresh  # …discarding its upper layer (only once its work is pushed)
     $SELF purge <box>             # or remove the box for good"
		fi
		tty_flush
		printf '%s: [m]ove them onto %s  [p]urge them  [q]uit ? ' "$SELF" "$cur" > /dev/tty
		read -r answer < /dev/tty || answer=q
		case "$answer" in
			m|M)
				for b in $boxes; do
					echo "$SELF: moving '$b' onto $cur..."
					# Not --fresh: the box's upper layer is its unpushed work, and losing that silently
					# would be the worst outcome of a housekeeping command. A box that needs a clean base
					# is one you recreate --fresh deliberately.
					box_recreate "$b" || die "moving '$b' failed — nothing was deleted; fix it and retry"
				done ;;
			p|P)
				for b in $boxes; do
					echo "$SELF: purging '$b'..."
					box_purge "$b" --force || die "purging '$b' failed — nothing else was deleted"
				done ;;
			*) die "nothing done" ;;
		esac
	fi

	# reap takes every golden that is neither current nor referenced — which now includes this one.
	golden_reap
}

golden_ls() {
	local resp g prov
	resp="$(broker GET /golden)" || die "broker unreachable: $resp"
	echo "current: $(printf '%s' "$resp" | jqr '.current')"
	for g in $(printf '%s' "$resp" | jqr '.goldens[]?.golden'); do
		# Provenance is stored INSIDE .git (not as a file in the tree), so it never shows up as an
		# untracked file in every agent's `git status`.
		prov="$(cat "$GOLDEN/$g/.git/cbx-golden" 2>/dev/null | tr '\n' ' ')"
		printf '  %-22s %s\n' "$g" "${prov:-(no provenance recorded)}"
		printf '%s' "$resp" | jq -r --arg g "$g" '.goldens[]? | select(.golden==$g) | "      \(if .current then "current  " else "" end)boxes: \(if (.boxes|length)>0 then (.boxes|join(",")) else "-" end)"' 2>/dev/null
	done
}

golden_seal() {
	# Finish a golden you staged and then fixed up by hand (e.g. after a failed --prep). Same tail as
	# snapshot: seal, move every box onto it, drop the ones nothing references any more.
	[ $# -ge 1 ] || die "seal needs a staged golden id (see $STAGING)"
	[ -d "$STAGING/$1" ] || die "no staged golden at $STAGING/$1"
	broker POST "/golden/seal/$1" >/dev/null || die "sealing $1 failed"
	echo "$SELF: sealed $1 as current"
	broker POST "/recreate?fresh=1" >/dev/null || die "recreate failed"
	golden_reap
}

golden_reap() {
	local resp
	resp="$(broker POST /golden/reap)" || die "reap failed: $resp"
	echo "$SELF: reaped: $(printf '%s' "$resp" | jqr '.reaped | join(", ") // "(none)"')"
}

golden_snapshot() {
	# Freeze THIS repo — exactly as you have it set up — as the base every box overlays.
	#
	# The snapshot is taken from, and mounted back at, the SAME absolute path ($REPO is also the box's
	# checkout path). So anything with baked-in absolute paths — npm's node_modules/.bin shebangs and
	# .package-lock.json, a project-local .gradle cache, a python venv — keeps working inside the box.
	# That is also why nothing is built in the staging copy: a build there would record the staging
	# path and be wrong everywhere. Run `--prep` (or your own commands) HERE, then snapshot.
	#
	# We can't skip the copy and point the boxes' lowerdir straight at $REPO: overlayfs requires the
	# lower layer to be immutable while boxes are mounted on it, and you keep editing this tree.
	local id st prep=0 boxes box dirty svc
	[ "${1:-}" = --prep ] && prep=1

	# A build running in the hub's tmux writes into $REPO while we copy it — the snapshot would be a
	# torn mixture of before and after. Cheap to avoid, miserable to debug. Any service whose manifest
	# sets writes_repo=true counts (this replaced the hard-coded backend/frontend list).
	for svc in $(svc_names); do
		svc_load "$svc" || continue
		svc_truthy "$SVC_WRITES_REPO" || continue
		if svc_running "$svc"; then
			die "'$svc' is running and writing into $REPO — '$SELF down $svc' first, then snapshot"
		fi
	done

	if [ "$prep" = 1 ]; then
		echo "$SELF: preparing the repo (${GOLDEN_PREP_CMD})"
		( cd "$REPO" && bash -lc "$GOLDEN_PREP_CMD" ) || die "prep failed — fix it in $REPO and re-run"
	fi

	# Recreating the boxes discards their upper layers, so anything not committed AND pushed is lost.
	# Refuse rather than eat it — this is the one destructive step in the whole workflow.
	boxes="$(broker GET /box 2>/dev/null | jqr '.boxes[]?.box')"
	for box in $boxes; do
		dirty="$(broker GET "/box/$box/dirty" 2>/dev/null | jqr '.dirty[]?' | head -5)"
		if [ -n "$dirty" ]; then
			echo "$SELF: box '$box' has uncommitted changes:" >&2
			printf '  %s\n' $dirty >&2
			die "commit + handoff in that box first (or '$SELF kill $box' to abandon it)"
		fi
	done

	# Whatever is dirty here gets baked in and becomes every agent's starting `git status`. That's the
	# deal — it's how your local setup reaches the boxes — but it should never be a surprise, and
	# modified TRACKED files are the ones an agent can sweep into a commit by accident.
	if [ -n "$(git_ status --porcelain)" ]; then
		echo "$SELF: baking these local changes into the golden — every box will start with them:"
		git_ status --short | sed 's/^/  /'
	fi

	id="g-$(date +%Y%m%d-%H%M%S)"
	st="$STAGING/$id"
	mkdir -p "$STAGING"
	rm -rf "$st"
	echo "$SELF: snapshotting $REPO -> staging/$id (reflink)"
	cp --reflink=auto -a "$REPO/." "$st" || die "snapshot copy failed"

	# The boxes reach the hub repo over the cbx network; bake that in so a box's git works immediately.
	git -C "$st" remote remove hub 2>/dev/null || true
	git -C "$st" remote add hub "${HUB_GIT_URL:-git://hub/repo}"
	# Hub-only bits that have no business in a box: the push-restriction hook (nothing pushes into a
	# box) and the review state. Provenance goes inside .git so it can never appear as an untracked
	# file in every agent's `git status`.
	rm -f  "$st/.git/hooks/update"
	rm -rf "$st/.git/cbx"
	# Linked-worktree registrations (a `$SELF minto --here` in progress). The worktrees themselves live
	# under .git/cbx and are gone with the line above, but their admin dirs are separate: left behind,
	# every box would inherit a `git worktree list` entry pointing at a path that does not exist there,
	# and git refuses to check out a branch it believes is checked out in one of them.
	rm -rf "$st/.git/worktrees"
	printf '%s from %s (%s) at %s\n' "$id" "$(git_ rev-parse --short HEAD)" "$DEV" "$(date -Is)" \
		> "$st/.git/cbx-golden"

	# The hub mounts $GOLDEN read-only on purpose, so the broker performs the move + symlink flip.
	broker POST "/golden/seal/$id" >/dev/null \
		|| die "sealing $id failed (staged tree kept — retry with: $SELF golden seal $id)"
	echo "$SELF: sealed $id as current"

	echo "$SELF: moving every box onto it (fresh upper layers)..."
	broker POST "/recreate?fresh=1" >/dev/null || die "recreate failed"
	golden_reap
	echo "$SELF: done. Boxes are on $id and back on their pushed branches."
}

# ------------------------------------------------------------------ patch bridge (laptop <-> hub)

# The two halves of moving a changeset between the hub and your laptop checkout as PLAIN PATCHES —
# not git transport. Patches apply by context, so neither side has to share the other's exact base
# sha; the laptop's `dev` can be anywhere. STDOUT/STDIN are the payload here, so every diagnostic in
# these two goes to STDERR (via die / >&2) and nothing else is printed — the stream stays clean for a
# pipe. The laptop aliases (cbxexport / cbximport) drive both without a PTY, which would corrupt bytes.

export_patch() {
	# The agent's whole branch, squashed to ONE commit, streamed as an mbox on STDOUT. `git am` on the
	# laptop replays it as a single commit carrying the handoff summary. We assemble the squash with
	# commit-tree so NOTHING here is touched — no ref, no worktree, no index — and re-running is a no-op.
	[ $# -ge 1 ] || die "export needs a box name"
	local box="$1" ref tip base tree msg squash
	ref="refs/agents/$box"
	git_ rev-parse --verify -q "$ref" >/dev/null || die "no branch pushed for '$box' (has it run handoff?)"
	tip="$(git_ rev-parse "$ref")"
	base="$(git_ merge-base "$DEV" "$ref")" || die "no common base between $DEV and $ref"
	tree="$(git_ rev-parse "$ref^{tree}")"
	# A branch whose tree equals its base's tree is all no-op commits — there is no diff to send.
	[ "$(git_ rev-parse "$base^{tree}")" != "$tree" ] || die "'$box' has no net change against $DEV — nothing to export"
	msg="$(note_of "$box")"; msg="${msg:-work from agent box $box}"
	squash="$(printf '%s\n\nCbx-Box: %s\nCbx-Src: %s\n' "$msg" "$box" "$tip" | git_ commit-tree "$tree" -p "$base")" \
		|| die "could not assemble the squashed commit (is a git identity configured on the hub?)"
	# -1 emits just this commit; its parent is $base, so the patch IS the branch's net diff. --binary so
	# binary files survive git am on the far end.
	git_ format-patch --stdout --binary -1 "$squash"
}

import_patch() {
	# Replace refs/agents/<box> with a patch read from STDIN (your `git format-patch` mbox), then tell
	# the box its old edits were superseded — to NOTE it, not redo it. We `git am` the patch in a throwaway
	# detached worktree based on $DEV so the hub's own checkout (often dirty) is never touched.
	[ $# -ge 1 ] || die "import needs a box name"
	local box="$1" ref pf wt new
	ref="refs/agents/$box"
	pf="$(mktemp "${TMPDIR:-/tmp}/cbx-import-XXXXXX.mbox")"
	cat > "$pf"
	[ -s "$pf" ] || { rm -f "$pf"; die "no patch on STDIN — pipe a 'git format-patch' mbox in (see cbximport)"; }
	wt="$(mktemp -u "${TMPDIR:-/tmp}/cbx-import-wt-XXXXXX")"
	git_ worktree add -q --detach "$wt" "$DEV" || { rm -f "$pf"; die "could not create a temporary worktree"; }
	if ! git -C "$wt" am --3way "$pf" >&2; then
		git -C "$wt" am --abort >/dev/null 2>&1 || true
		git_ worktree remove --force "$wt" >/dev/null 2>&1 || true
		rm -f "$pf"
		die "your patch did not apply onto $DEV — is your laptop checkout based on the same history? (try '$SELF pull' first)"
	fi
	new="$(git -C "$wt" rev-parse HEAD)"
	git_ worktree remove --force "$wt" >/dev/null 2>&1 || true
	rm -f "$pf"
	[ "$new" != "$(git_ rev-parse "$DEV")" ] || die "the patch added nothing on top of $DEV — refs/agents/$box left unchanged"

	git_ update-ref "$ref" "$new"
	# It is YOUR vetted commit, so record it as already reviewed — '$SELF status' then offers merge directly.
	mkdir -p "$STATE"
	printf '%s %s' "$new" "$(git_ rev-parse "$DEV")" > "$STATE/$box.reviewed"
	echo "$SELF: refs/agents/$box now points at your commit $(git_ rev-parse --short "$new") ($(git_ rev-list --count "$DEV..$ref") on top of $DEV)." >&2
	echo "$SELF: next — '$SELF merge $box' to land it on $DEV (or push from your laptop as usual)." >&2

	# FYI to the box, exactly like drop/merge: unconditional (the point is to stop it re-pushing its old
	# version), and it must NOT act. The box fetches refs/agents/* as refs/remotes/hub-agents/*.
	if say_to_box "$box" "Heads up: I replaced the changes on your branch (agent/$box) with my own commit. Sync your local branch to it with: git fetch hub && git reset --hard hub-agents/$box . This is FYI ONLY — just NOTE that your earlier edits were superseded by my version; do NOT re-apply your previous work or take any action on this. Wait for new instructions."; then
		echo "$SELF: told $box to reset onto your commit and just note it." >&2
	else
		echo "$SELF: (box $box not reachable — it will pick up your commit next time it fetches: git reset --hard hub-agents/$box)" >&2
	fi
}

cmd="${1:-}"; shift || true
case "$cmd" in
	up)     [ $# -ge 1 ] || die "up needs a service ($SELF svcs to list)"; svc_up "$1" ;;
	down)   [ $# -ge 1 ] || die "down needs a service ($SELF svcs to list)"; svc_down "$1" ;;
	logs)   [ $# -ge 1 ] || die "logs needs a service ($SELF svcs to list)"; svc_logs "$@" ;;
	svcs|services) svc_list ;;
	ready)  svc_ready_cmd "$@" ;;
	autostart)     svc_autostart ;;
	box)      box_new "$@" ;;
	kill)     box_kill "$@" ;;
	purge)    box_purge "$@" ;;
	recreate) box_recreate "$@" ;;
	ls)       box_ls ;;
	forwards) forwards_refresh "${1:-}" ;;
	# Default is the LIVE dashboard; --text (or a non-terminal stdout, i.e. a pipe) gives the plain
	# one-shot table, so `$SELF q | grep …` and scripts behave as they always did.
	q|queue)
		case "${1:-}" in
			--text|--once|-1) queue ;;
			*) watch_queue "$@" ;;   # falls back to the one-shot table when stdout is not a terminal
		esac ;;
	# Colour auto-detects here: `$SELF status | less` or a redirect gets plain text, a terminal gets the
	# same rendering as the live dashboard. MUSTER_COLOR=always|never overrides.
	status|st) colors_init; status_overview ;;
	review)   review "$@" ;;
	fix)      fix "$@" ;;
	prereview) prereview "$@" ;;
	say)      say "$@" ;;
	peek)     peek "$@" ;;
	point)    point "$@" ;;
	hold)     hold "$@" ;;
	release)  release "$@" ;;
	merge)    merge "$@" ;;
	minto)    colors_init; minto "$@" ;;
	drop)     drop "$@" ;;
	rebase)   rebase "$@" ;;
	export)   export_patch "$@" ;;
	import)   import_patch "$@" ;;
	pull)     pull "$@" ;;
	push)     push "$@" ;;
	golden)
		sub="${1:-}"; shift || true
		case "$sub" in
			snapshot) golden_snapshot "$@" ;;
			seal)     golden_seal "$@" ;;
			ls)       golden_ls ;;
			reap)     golden_reap ;;
			retire)   golden_retire "$@" ;;
			*) die "golden needs: snapshot [--prep] | seal <id> | ls | reap | retire <id>" ;;
		esac ;;
	# Asking for help is not an error: `--help` prints to stdout and exits 0, so it can be used in a
	# `set -e` script or a CI check. An unknown command still exits 1, and says which word it did not
	# understand before the listing — the usage alone leaves you comparing it against what you typed.
	-h|--help|help) usage; exit 0 ;;
	*)
		[ -n "$cmd" ] && echo "$SELF: unknown command '$cmd'" >&2
		usage >&2
		exit 1 ;;
esac
