# claude-box-hub-base — the PROJECT-AGNOSTIC hub base image.
#
# Everything a claude-box "hub" needs regardless of the project it hosts: git + ssh for the
# checkout, tmux for the on-demand service windows, node/npm, the pinchtab server + the Chrome
# runtime libs its browser needs, and the cbx helper + entrypoint. A per-project image builds ON
# TOP of this (see Dockerfile) to add that project's extra build deps (e.g. ant).
#
# JDK17 + gradle 8 on jammy is the base OS (the same gradle:8-jdk17-jammy the hub used before the
# split), so JAVA_HOME, the gradle install, and the non-root 'gradle' user (uid/gid 1000, home
# /home/gradle) all come from the base image — every bind mount (/home/gradle/.claude, .pinchtab,
# .gitidentity, .m2/repository) and all uid-1000 file ownership line up exactly as before.
#
# BUILD CONTEXT = the claude-box dir (NOT hub/), so this can COPY the shared common-setup.sh at its
# root; the hub's own files are therefore referenced as hub/<file>. Build it with, e.g.:
#   docker build -f hub/Dockerfile.base -t claude-box-hub-base .
FROM gradle:8-jdk17-jammy

USER root

# Shared tooling (base utils, Node + npm via fnm, the pinchtab binary) — installed by common-setup.sh,
# the SAME script the claude-box image uses, so the toolchain is defined in one place. Version pins
# come from build args (the Jenkins pipeline passes them explicitly).
ARG NODE_VERSION=v26.2.0
ARG NPM_VERSION=11.13.0
ARG PINCHTAB_VERSION=0.13.2
ENV FNM_DIR=/opt/fnm
COPY common-setup.sh /tmp/common-setup.sh
RUN NODE_VERSION="${NODE_VERSION}" NPM_VERSION="${NPM_VERSION}" PINCHTAB_VERSION="${PINCHTAB_VERSION}" \
		sh /tmp/common-setup.sh \
	&& rm /tmp/common-setup.sh

# Hub-specific runtime deps (the shared ones came from common-setup.sh above). openssh-client clones
# + commits; tmux holds the on-demand service windows; the cypress/Chrome shared-lib list mirrors
# docker-gradle (pinchtab downloads and drives its own Chrome, so we only need the libs) plus xauth/xvfb.
RUN apt-get update && apt-get install -y --no-install-recommends \
		openssh-client tmux \
		libgtk2.0-0 libgtk-3-0 libgbm-dev libnotify-dev libgconf-2-4 libnss3 \
		libxss1 libasound2 libxtst6 xauth xvfb \
	&& rm -rf /var/lib/apt/lists/*

ENV NG_CLI_ANALYTICS=false

# Git-over-SSH for the checkout, baked system-wide (applies without any per-stack gitconfig; a
# mounted ~/.gitidentity/gitconfig can still override). The wrapper offers whatever private key(s)
# live in the mounted identity dir (any type, not just ed25519) and trusts a provider's host key on
# first connect. entrypoint.sh pre-seeds known_hosts for the REPO_URL host.
COPY hub/git-ssh /usr/local/bin/git-ssh
RUN chmod 0755 /usr/local/bin/git-ssh \
	&& git config --system core.sshCommand /usr/local/bin/git-ssh

# Helper CLI (cbx: start/stop services, spawn/kill boxes via the broker) + entrypoint.
COPY hub/cbx /usr/local/bin/cbx
COPY hub/entrypoint.sh /usr/local/bin/hub-entrypoint.sh
RUN chmod 0755 /usr/local/bin/cbx /usr/local/bin/hub-entrypoint.sh

USER 1000
WORKDIR /home/gradle
ENTRYPOINT ["/usr/local/bin/hub-entrypoint.sh"]
