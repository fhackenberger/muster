# muster-hub-base — the PROJECT-AGNOSTIC hub base image.
#
# debian:trixie-slim + common-setup.sh (the same generic runtime the box uses) + the hub-only tooling:
# openssh, Google Chrome (for the pinchtab server), git-ssh, cbx, and the hub entrypoint. No JDK/gradle
# — your project's build toolchain layers on top via Dockerfile.addon (-> muster-hub).
#
# The hub runs headless as a single uid-1000 user 'dev' with home /home/dev — the SAME identity the
# boxes use on the server — so every bind mount (/home/dev/.claude, .pinchtab, .gitidentity, .npm,
# .gradle, .m2) and the shared caches land at one path everywhere. (The box materializes its user
# dynamically at runtime; the hub's is created here.)
#
# BUILD CONTEXT = the muster dir (NOT hub/), so this can COPY the shared common-setup.sh at its
# root; the hub's own files are referenced as hub/<file>. Build it with, e.g.:
#   docker build -f hub/Dockerfile.base -t muster-hub-base .
FROM debian:trixie-slim

# WHICH MUSTER THIS IS. Baked in so the pieces can check they agree at runtime: the hub, the broker
# and the boxes are three images from three build paths, and nothing else stops a stack from running
# a 0.2 broker against a 0.1 hub. The ADD-ON images inherit this ENV from their base, so a
# project's own toolchain layer carries the version of the muster it was built on — which is exactly
# the number that has to match. `dev` when built by hand; CI passes the release tag.
ARG MUSTER_VERSION=dev
ENV MUSTER_VERSION=${MUSTER_VERSION}

# The hub's uid-1000 user. Home /home/dev matches the boxes' server user, unifying every bind-mount path.
RUN groupadd -g 1000 dev \
	&& useradd -m -u 1000 -g 1000 -s /bin/bash dev

# Shared tooling (base utils, Node + npm via fnm, the pinchtab binary, the tuicr review TUI, tmux, git
# bash-completion, the ghostty terminfo, socat) — installed by common-setup.sh, the SAME script the
# muster image uses.
ARG NODE_VERSION=v26.2.0
ARG NPM_VERSION=11.13.0
ARG PINCHTAB_VERSION=0.13.2
ARG TUICR_VERSION=0.19.1
ENV FNM_DIR=/opt/fnm
COPY common-setup.sh terminfo-ghostty tmux.conf /tmp/
RUN NODE_VERSION="${NODE_VERSION}" NPM_VERSION="${NPM_VERSION}" PINCHTAB_VERSION="${PINCHTAB_VERSION}" \
		TUICR_VERSION="${TUICR_VERSION}" \
		sh /tmp/common-setup.sh \
	&& rm /tmp/common-setup.sh

# Hub-specific runtime deps. openssh-client clones + commits. Google Chrome is for the pinchtab SERVER
# (pinchtab drives a REAL system browser); google-chrome-stable's .deb pulls in all the Chrome runtime
# libs. xauth/xvfb are the headless X plumbing. curl comes from common-setup above.
#
# python3-yaml is for the TEST SUITE, not the hub: with git, jq, curl, bash, tmux and python3 already
# here from common-setup, this one package makes the image a complete environment for
# tests/run-tests.sh — so a consumer's CI can run muster's tests in the very image muster ships,
# rather than assembling a lookalike on a build agent. Dogfooding, and it costs ~150 kB.
RUN apt-get update && apt-get install -y --no-install-recommends \
		openssh-client xauth xvfb gnupg python3-yaml \
	&& curl -fsSL https://dl.google.com/linux/linux_signing_key.pub \
		| gpg --dearmor -o /usr/share/keyrings/google-chrome.gpg \
	&& echo 'deb [arch=amd64 signed-by=/usr/share/keyrings/google-chrome.gpg] https://dl.google.com/linux/chrome/deb/ stable main' \
		> /etc/apt/sources.list.d/google-chrome.list \
	&& apt-get update \
	&& apt-get install -y --no-install-recommends google-chrome-stable \
	&& rm -rf /var/lib/apt/lists/*

ENV NG_CLI_ANALYTICS=false

# UTF-8 locale — same reason as the box image: debian-slim configures none, and the hub's tmux
# (cbxhub, cbx logs) would render every non-ASCII glyph as '_' under the C locale. C.UTF-8 is built
# into glibc, so no locales package is needed.
ENV LANG=C.UTF-8

# Git-over-SSH for the checkout, baked system-wide (applies without any per-stack gitconfig; a mounted
# ~/.gitidentity/gitconfig can still override). The wrapper offers whatever private key(s) live in the
# mounted identity dir and trusts a provider's host key on first connect; entrypoint.sh pre-seeds
# known_hosts for the REPO_URL host.
COPY hub/git-ssh /usr/local/bin/git-ssh
RUN chmod 0755 /usr/local/bin/git-ssh \
	&& git config --system core.sshCommand /usr/local/bin/git-ssh

# Helper CLI (cbx: start/stop services, spawn/kill/recreate boxes via the broker) + entrypoint.
COPY hub/muster /usr/local/bin/muster
COPY hub/entrypoint.sh /usr/local/bin/hub-entrypoint.sh
RUN chmod 0755 /usr/local/bin/muster /usr/local/bin/hub-entrypoint.sh

USER 1000
WORKDIR /home/dev
ENTRYPOINT ["/usr/local/bin/hub-entrypoint.sh"]
