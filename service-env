# service-env — settings for the PROJECT's services (backend, frontend, …), given to BOTH the hub
# and every agent box. Either can run those services, so they must be configured identically.
#
#   hub    <- compose `env_file:` on the hub service
#   boxes  <- the box-broker reads this file and passes each entry as `-e KEY=VALUE`
#
# Format is compose's env_file format, and the broker parses the same way:
#   * one KEY=VALUE per line; the value is LITERAL to the end of the line
#   * '#' comments and blank lines ignored
#   * no quoting rules, no shell/${} expansion, and values may not contain newlines
#   * keys must match [A-Za-z_][A-Za-z0-9_]*  (a bad key is a hard error, not a silent skip)
#
# Changes apply to the hub on `docker compose up -d hub`, and to a box on `cbx recreate <box>`.
#
# NOTE hostnames here (db, redis, activemq, hub) are docker-network names — they resolve the same
# from the hub and from every box, since all of them are on the cbx-<project> network.
#
# This file is the project's; under Ansible it is templated from
# templates/docker-compose/claude-box/service-env (which is where secrets come from the vault).

# ---- service ports ----
# SERVER_PORT is Spring Boot's server.port; FRONTEND_DEV_PORT is read by the project's frontend-dev
# scripts for `ng serve --port` (they must NOT hardcode a port, or a reshuffle breaks the dev loop
# silently: the tunnel forwards one port while ng serve binds another).
SERVER_PORT=8091
FRONTEND_DEV_PORT=4211
# The FULL app URL, not just host:port — the frontend derives its REST base by stripping
# /app[-suffix]/* off this value, so a bare host:port loses the /infostarsWeb segment and every REST
# call 404s. Default setup: the backend runs on the HUB, and the browser (pinchtab's Chrome there, or
# your laptop via cbxtun/cbxfe) resolves localhost to that same hub — so this one value is right for
# the hub AND for agent boxes.
FRONTEND_DEV_BACKEND_URL=http://localhost:8091/infostarsWeb/app
# Used ONLY when a box runs its own backend (a BACKEND line in port-forwards): the broker rebuilds
# the URL above as http://localhost:<that box's hub port><this path>.
FRONTEND_DEV_BACKEND_PATH=/infostarsWeb/app

# ---- backend wiring (config.properties keys; env overrides the baked-in defaults) ----
DB_INFOSTARS_PSQL_URL=jdbc:postgresql://db:5432/infotrack_dev
DB_INFOSTARS_PSQL_USER=infostars_u
DB_INFOSTARS_PSQL_PASSWORD=test
DB_LIQUIBASE_UPGRADE_DISABLED=true
LIVE_JMSURI=tcp://activemq:61616
ACTIVEMQ_ENABLE=true
REDIS_HOST=redis
REDIS_PORT=6379

# ---- properties whose names can't be environment variables ----
# A property named with '/' (or any character outside [A-Za-z0-9_]) has no env-var spelling: Spring
# only translates '.' and '-' to '_' when matching a property name against the environment. Use
# SPRING_APPLICATION_JSON — a high-precedence property source whose keys are taken literally. Put ALL
# such properties in this ONE variable; a second SPRING_APPLICATION_JSON line would replace the first.
#SPRING_APPLICATION_JSON={"AnonymousLogin/enabled":"true","AnonymousLogin/isDefault":"true","AnonymousLogin/userId":"1"}

# ---- API keys (fill in, or let Ansible template them from the vault) ----
FRONTEND_GOOGLE_MAPS_API_KEY=
GEOSERVICEGOOGLE_APIKEY=
GEOSERVICELOCATIONIQ_APIKEY=
