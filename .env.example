# Copy to .env in each project's stack dir and fill in. One stack = one project.

# Project name → container names (box-<project>-<name>), network (cbx-<project>), compose project.
PROJECT_NAME=myproject

# ABSOLUTE host path of THIS stack directory (where compose.yml lives). The box-broker uses it to
# hand the boxes host paths for their bind mounts. Set it to the output of `pwd` in this dir.
STACK_DIR=/srv/cbx/myproject

# Repo the hub clones into ./data/checkout on first boot (https with a token in git-identity, or
# git@ with an ssh key there). Leave empty to clone manually into ./data/checkout.
REPO_URL=https://github.com/acoveo/infostars.git

# Shared secrets (generate: openssl rand -hex 24). BROKER_TOKEN gates hub→broker; PT_TOKEN is the
# pinchtab server token the boxes use.
BROKER_TOKEN=change-me
PT_TOKEN=change-me

# Images built by the Jenkinsfile on this host (moving tag: master->stable, build/test->latest,
# else dev). Point the stack at those tags, or at registry-qualified names to pull on another host.
BOX_IMAGE=claude-box:stable
HUB_IMAGE=claude-box-hub:stable
BOX_BROKER_IMAGE=claude-box-broker:stable

# How compose resolves the hub/box-broker images on `up`:
#   missing (default) = use the Jenkins-built image; build locally only if it's absent
#   build             = always (re)build locally from this directory (ignore prebuilt images)
#   always            = always pull (use with registry-qualified *_IMAGE names on another host)
COMPOSE_PULL_POLICY=missing

# Backend API keys (same values the Jenkins credentials provide).
FRONTEND_GOOGLE_MAPS_API_KEY=
GEOSERVICEGOOGLE_APIKEY=
GEOSERVICELOCATIONIQ_APIKEY=
