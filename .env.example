# Copy to .env in each project's stack dir and fill in. One stack = one project.

# Project name → container names (box-<project>-<name>), network (cbx-<project>), compose project.
PROJECT_NAME=myproject

# ABSOLUTE host path of THIS stack directory (where compose.yml lives). The box-broker uses it to
# hand the boxes host paths for their bind mounts. Set it to the output of `pwd` in this dir.
STACK_DIR=/srv/cbx/myproject

# Repo the hub clones into ./data/checkout on first boot (https with a token in git-identity, or
# git@ with an ssh key there). Leave empty to clone manually into ./data/checkout.
REPO_URL=https://github.com/acoveo/infostars.git

# Shared secrets (generate: openssl rand -hex 24). BROKER_TOKEN gates hub→broker; PT_TOKEN is the
# pinchtab server token the boxes use.
BROKER_TOKEN=change-me
PT_TOKEN=change-me

# Images built + pushed by the Jenkinsfile to the acoveo registry (moving tag: master->stable,
# build/test->latest, else dev). Pulled from there so the stack need not run on the Jenkins host.
# `docker login dockerregistry.acoveo.com` must have run on this host first.
DB_IMAGE=dockerregistry.acoveo.com/infostars/dbtest:latest
BOX_IMAGE=dockerregistry.acoveo.com/acoveo/claude-box:stable
HUB_IMAGE=dockerregistry.acoveo.com/acoveo/claude-box-hub:stable
BOX_BROKER_IMAGE=dockerregistry.acoveo.com/acoveo/claude-box-broker:stable

# How compose resolves those images on `up`:
#   missing (default) = pull only if absent locally (refresh a moving tag with `docker compose pull`)
#   always            = always pull the (moving) tag from the registry — keeps the host current
#   build             = (re)build hub + box-broker locally from this directory (e.g. on the Jenkins host)
COMPOSE_PULL_POLICY=missing

# Optional: host path to a pre-populated Maven cache (e.g. Jenkins' ~/.m2/repository), mounted
# READ-ONLY into the hub as its default local repo (~/.m2/repository) so builds resolve deps
# offline. Defaults to /var/jenkins_home/.m2/repository (the Jenkins-host layout); point it at a
# real directory or leave the default if that path exists on this host.
MAVEN_REPO_HOST=/var/jenkins_home/.m2/repository

# Backend API keys (same values the Jenkins credentials provide).
FRONTEND_GOOGLE_MAPS_API_KEY=
GEOSERVICEGOOGLE_APIKEY=
GEOSERVICELOCATIONIQ_APIKEY=
