# Copy to .env in each project's stack dir and fill in. One stack = one project.

# Project name → container names (box-<project>-<name>), network (cbx-<project>), compose project.
PROJECT_NAME=myproject

# ABSOLUTE host path of THIS stack directory (where compose.yml lives). The box-broker uses it to
# hand the boxes host paths for their bind mounts. Set it to the output of `pwd` in this dir.
STACK_DIR=/srv/cbx/myproject

# Repo the hub clones into ./data/repo on first boot (https with a token in git-identity, or git@
# with an ssh key there). Leave empty to clone manually into ./data/repo.
REPO_URL=https://github.com/you/yourproject.git

# The branch agents base their work on and you merge into. Each box works on agent/<box> and pushes
# to refs/agents/<box> in the hub repo; `cbx merge <box>` lands it here.
DEV_BRANCH=dev

# How the boxes reach the hub's repo (git daemon on the cbx network). Only change this if you rename
# the hub service.
HUB_GIT_URL=git://hub/repo

# Your project's "make this tree ready to build" command. `cbx golden snapshot --prep` runs it IN
# THE HUB'S REPO (/home/dev/repo) — not in a copy — so it's an optional convenience around setup you
# could equally do by hand in `cbxhub`. Whatever it installs is then frozen at the path the boxes
# use it from, which is why absolute paths baked into node_modules/.bin still resolve there.
# Empty = nothing to prepare (claude-box knows nothing about your build).
GOLDEN_PREP_CMD=

# Shared secrets (generate: openssl rand -hex 24). BROKER_TOKEN gates hub→broker; PT_TOKEN is the
# pinchtab server token the boxes use.
BROKER_TOKEN=change-me
PT_TOKEN=change-me

# The images. These are the plain local tags the Jenkinsfile (or build.sh) produces, which is all
# you need when the images are built on this host. To run on a DIFFERENT host, qualify them with your
# registry (e.g. registry.example.com/<org>/claude-box-hub:stable), set COMPOSE_PULL_POLICY=always,
# and `docker login` there first. HUB_BASE_IMAGE is only consulted when the hub is BUILT here.
BOX_IMAGE=claude-box:stable
HUB_IMAGE=claude-box-hub:stable
HUB_BASE_IMAGE=claude-box-hub-base:stable
BOX_BROKER_IMAGE=claude-box-broker:stable

# How compose resolves those images on `up`:
#   missing (default) = pull only if absent locally (refresh a moving tag with `docker compose pull`)
#   always            = always pull the (moving) tag from the registry — keeps the host current
#   build             = (re)build hub + box-broker locally from this directory (e.g. on the Jenkins host)
COMPOSE_PULL_POLICY=missing

# The compose files this stack is made of, colon-separated. compose.yml is claude-box itself (hub +
# box-broker); YOUR services (a db, a cache, seed data) go in compose.project.yml — copy
# compose.project.yml.example. A stack with no extra services can drop that entry.
#
# compose.override.yml MUST be listed: setting COMPOSE_FILE at all DISABLES compose's automatic
# loading of it, and that is where gen-hub-mounts.sh renders the hub's half of the `mounts` table.
# Omit it and the hub comes up without a single project mount — visible only as `MOUNT DRIFT` in its
# boot log. Run ./gen-hub-mounts.sh once before the first `docker compose up` so the file exists.
COMPOSE_FILE=compose.yml:compose.project.yml:compose.override.yml

# NOTE: what the hub and the boxes MOUNT is not configured here — it is the `mounts` table (one row
# per path, a mode for each side), so the two cannot drift apart. Jenkins' ~/.m2/repository is a row
# in there; see mounts.example.

# Backend/frontend settings and API keys live in `service-env` (copy service-env.example) — it is
# given to the hub AND to every agent box, so a service is configured the same whichever side runs
# it. compose REQUIRES the file to exist: `cp service-env.example service-env` before the first up.
