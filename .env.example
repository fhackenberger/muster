# Copy to .env in each project's stack dir and fill in. One stack = one project.

# Project name → container names (box-<project>-<name>), network (cbx-<project>), compose project.
PROJECT_NAME=myproject

# ABSOLUTE host path of THIS stack directory (where compose.yml lives). The box-broker uses it to
# hand the boxes host paths for their bind mounts. Set it to the output of `pwd` in this dir.
STACK_DIR=/srv/cbx/myproject

# WHERE THIS STACK'S CONFIG FILES LIVE, relative to the stack dir. Default `.` — beside compose.yml.
# Set it to keep the root tidy; the files it moves are:
#   mounts  service-env  box-env  port-forwards  claude-settings.json  hub-services/  git-identity/
# Three files CANNOT move: .env (compose reads it from the project dir to learn this variable),
# compose.override.yml and compose.project.yml (compose loads both from the project dir). ./data does
# not move either — it is state, not config. Changing this is a `docker compose up -d` plus
# `cbx recreate all`: mounts and env are fixed at container creation.
#MUSTER_CONF_DIR=conf

# Repo the hub clones into ./data/repo on first boot (https with a token in git-identity, or git@
# with an ssh key there). Leave empty to clone manually into ./data/repo.
REPO_URL=https://github.com/you/yourproject.git

# The branch agents base their work on and you merge into. Each box works on agent/<box> and pushes
# to refs/agents/<box> in the hub repo; `cbx merge <box>` lands it here.
DEV_BRANCH=dev

# What this stack's CLI is called. The hub symlinks `muster` to this name (and registers it for tab
# completion), and on your laptop `muster_stack <prefix> <server> <project>` generates the matching
# command family — so one word reaches the same stack from either side, and several stacks can live
# in one shell. Leave empty and the command is just `muster`.
#
# It is a NAME, not a dependency: the laptop aliases always run `muster` inside the container and
# pass this as MUSTER_SELF, so they keep working before this variable has ever reached the hub.
# Changing it takes effect on the next `docker compose up -d hub` — env is fixed at creation.
#MUSTER_PREFIX=is

# How the boxes reach the hub's repo (git daemon on the cbx network). Only change this if you rename
# the hub service.
HUB_GIT_URL=git://hub/repo

# Your project's "make this tree ready to build" command. `cbx golden snapshot --prep` runs it IN
# THE HUB'S REPO (/home/dev/repo) — not in a copy — so it's an optional convenience around setup you
# could equally do by hand in `cbxhub`. Whatever it installs is then frozen at the path the boxes
# use it from, which is why absolute paths baked into node_modules/.bin still resolve there.
# Empty = nothing to prepare (muster knows nothing about your build).
GOLDEN_PREP_CMD=

# Shared secrets (generate: openssl rand -hex 24). BROKER_TOKEN gates hub→broker; PT_TOKEN is the
# pinchtab server token the boxes use.
BROKER_TOKEN=change-me
PT_TOKEN=change-me

# The images. These are the plain local tags the Jenkinsfile (or build.sh) produces, which is all
# you need when the images are built on this host. To run on a DIFFERENT host, qualify them with your
# registry (e.g. registry.example.com/<org>/muster-hub:stable), set COMPOSE_PULL_POLICY=always,
# and `docker login` there first. HUB_BASE_IMAGE is only consulted when the hub is BUILT here.
BOX_IMAGE=muster:stable
HUB_IMAGE=muster-hub:stable
HUB_BASE_IMAGE=muster-hub-base:stable
BOX_BROKER_IMAGE=muster-broker:stable

# Only used when you BUILD the add-on images (docker compose --profile build build). The two bases the
# add-ons layer onto — point them at the published ones to skip building the expensive part yourself.
# Note there is no leading 'v' on the image tag even though the git tag has one:
#   BOX_BASE_IMAGE=ghcr.io/fhackenberger/muster:1.0.0
#   HUB_BASE_IMAGE=ghcr.io/fhackenberger/muster-hub-base:1.0.0
# Unreleased work is published per commit on master as well, under `git describe` (and a moving `dev`):
#   BOX_BASE_IMAGE=ghcr.io/fhackenberger/muster:1.0.0-7-gabc1234
BOX_BASE_IMAGE=muster:stable
# Your toolchain installer, COPYd into both add-on images (see build-setup.sh.example).
SETUP_SCRIPT=build-setup.sh

# HOW EVERY BOX'S CLAUDE STARTS. Both are optional and empty by default (claude's own defaults apply).
#
# MUSTER_CLAUDE_PERMISSION_MODE — claude's --permission-mode, passed through EXACTLY as written:
#   default            claude's own behaviour: ask before edits and before commands
#   plan               propose first, touch nothing — useful when agents should design before doing
#   acceptEdits        edits go through unprompted; running a command still asks
#   auto               a small model judges each command; edits go through
#   bypassPermissions  asks nothing at all — read SECURITY.md before choosing it
#   The name says claude because the levels are claude's, and they change when claude changes. A
#   value muster does not recognise is passed on anyway (with a log line), so a new mode works here
#   the day it ships.
#MUSTER_CLAUDE_PERMISSION_MODE=plan
#
# MUSTER_BOX_PROMPT — an opening message, given to claude as its first turn. $VARIABLES come from the
#   broker's environment plus this box's own facts, so one line can tell every agent where it is:
#     $MUSTER_BOX $MUSTER_BRANCH $MUSTER_DEV_BRANCH $MUSTER_BASE_BRANCH $MUSTER_MERGE_BRANCH
#     $MUSTER_PROJECT $MUSTER_WORKDIR $MUSTER_GOLDEN
#   Unknown names are left as written, so prose containing a $ is safe. Quote it in this file.
#MUSTER_BOX_PROMPT="You are agent $MUSTER_BOX working on $MUSTER_BRANCH (based on $MUSTER_DEV_BRANCH). Read CLAUDE.md first, then wait for instructions."

# How compose resolves those images on `up`:
#   missing (default) = pull only if absent locally (refresh a moving tag with `docker compose pull`)
#   always            = always pull the (moving) tag from the registry — keeps the host current
#   build             = (re)build hub + box-broker locally from this directory (e.g. on the Jenkins host)
COMPOSE_PULL_POLICY=missing

# The compose files this stack is made of, colon-separated. compose.yml is muster itself (hub +
# box-broker); YOUR services (a db, a cache, seed data) go in compose.project.yml — copy
# compose.project.yml.example. A stack with no extra services can drop that entry.
#
# compose.override.yml MUST be listed: setting COMPOSE_FILE at all DISABLES compose's automatic
# loading of it, and that is where gen-hub-mounts.sh renders the hub's half of the `mounts` table.
# Omit it and the hub comes up without a single project mount — visible only as `MOUNT DRIFT` in its
# boot log. Run ./gen-hub-mounts.sh once before the first `docker compose up` so the file exists.
COMPOSE_FILE=compose.yml:compose.project.yml:compose.override.yml

# NOTE: what the hub and the boxes MOUNT is not configured here — it is the `mounts` table (one row
# per path, a mode for each side), so the two cannot drift apart. Jenkins' ~/.m2/repository is a row
# in there; see mounts.example.

# Backend/frontend settings and API keys live in `service-env` (copy service-env.example) — it is
# given to the hub AND to every agent box, so a service is configured the same whichever side runs
# it. compose REQUIRES the file to exist: `cp service-env.example service-env` before the first up.
